# build output
dist/
.output/

# runtime caches
.data/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# misc
*.pem
.cache
.

# Editor history / backups
.history/
.env
.env.*
.astro/.astro/

# Quarto render cache and intermediates for the slide decks in presentations/
.quarto-cache/
presentations/**/.quarto/
presentations/**/*_files/
# The rendered deck is a build artifact. public/etec534-ip2/index.html is the
# staged copy the site actually serves, and IS committed.
presentations/**/*.html
!presentations/**/*.include.html

# scratch directories used while building and verifying
.tmp-shots/
.tmp-chrome/
.tmp-quarto/

# local working artifacts (redundant copies from tooling; safe to ignore)
.pnpm-store/
node_modules.prev/
dist.pre-restore-20260815/
.git.broken.20260815/
pitch-update/
