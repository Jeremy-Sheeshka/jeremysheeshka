---
// File: src/pages/search.astro
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts } from "@/data/post";

// 1. Fetch all posts during build time to pass to the client
const allPosts = await getAllPosts();

const meta = {
	title: "Search Results",
	description: "Search results for the blog",
};
---

<PageLayout meta={meta}>
	<div id="search-page-container" class="max-w-3xl mx-auto px-6 py-12 min-h-[60vh]">
		
        <h1 class="page-heading text-4xl font-bold mb-8 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            Search Results
        </h1>
		
		{/* Search Input */}
		<div class="relative mb-12">
			<input 
				type="text" 
				id="search-input"
				placeholder="Search again..." 
				class="w-full px-6 py-4 text-lg border-2 border-zinc-200 rounded-2xl focus:border-zinc-300 outline-none bg-white text-zinc-900 placeholder-zinc-400 dark:bg-zinc-900 dark:text-white dark:placeholder-zinc-600 dark:border-zinc-800 transition-colors"
			/>
		</div>

        {/* Results Container */}
		<div id="search-results" class="space-y-4">
			<div class="status-msg animate-pulse">Searching...</div>
		</div>

        {/* Templates for the Javascript to use (Hidden) */}
        <template id="result-template">
            {/* The classes here are backups; the <style> block below enforces the colors */}
            <a href="" class="result-card block group p-6 rounded-2xl border-2 border-transparent transition-all">
                <h2 class="result-title text-2xl font-bold mb-2"></h2>
                <p class="result-desc line-clamp-2"></p>
                <div class="result-date mt-4 text-xs font-bold uppercase tracking-wider"></div>
            </a>
        </template>

	</div>
</PageLayout>

{/* STRICT STYLING TO FIX UNREADABLE TEXT */}
<style>
    /* --- LIGHT THEME (DEFAULT) --- */
    
    /* 1. Page Heading */
    #search-page-container .page-heading {
        color: #18181b !important; /* almost black */
    }

    /* 2. Status Message (Loading/No Results) */
    #search-page-container .status-msg {
        color: #52525b !important; /* grey */
    }

    /* 3. Result Card Text */
    #search-page-container .result-title {
        color: #18181b !important; /* almost black */
        text-decoration: none;
    }
    #search-page-container .result-desc {
        color: #52525b !important; /* dark grey */
    }
    #search-page-container .result-date {
        color: #a1a1aa !important; /* light grey */
    }

    /* 4. Hover Effects (Light Theme) */
    #search-page-container .result-card:hover {
        background-color: #f4f4f5 !important; /* Very subtle grey (zinc-100) */
        border-color: #e4e4e7 !important;     /* Subtle border (zinc-200) */
    }
    #search-page-container .result-card:hover .result-title {
        text-decoration: underline;
        text-decoration-thickness: 2px;
    }

    /* --- DARK THEME OVERRIDES --- */
    :global(.dark) #search-page-container .page-heading {
        color: #ffffff !important;
    }
    :global(.dark) #search-page-container .status-msg {
        color: #a1a1aa !important;
    }
    :global(.dark) #search-page-container .result-title {
        color: #ffffff !important;
    }
    :global(.dark) #search-page-container .result-desc {
        color: #d4d4d8 !important; /* light grey */
    }
    
    /* Hover Effects (Dark Theme) */
    :global(.dark) #search-page-container .result-card:hover {
        background-color: #18181b !important; /* zinc-900 */
        border-color: #27272a !important;     /* zinc-800 */
    }
</style>

{/* Client-Side Search Logic */}
<script is:inline define:vars={{ posts: allPosts }}>
    const searchInput = document.getElementById("search-input");
    const resultsContainer = document.getElementById("search-results");
    const template = document.getElementById("result-template");

    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get("q") || "";

    searchInput.value = query;

    function performSearch(searchQuery) {
        if (!searchQuery) {
            resultsContainer.innerHTML = '<p class="status-msg italic">Enter a term to search...</p>';
            return;
        }

        const lowerQuery = searchQuery.toLowerCase();
        const filtered = posts.filter(post => {
            const title = post.data.title.toLowerCase();
            const desc = (post.data.description || "").toLowerCase();
            return title.includes(lowerQuery) || desc.includes(lowerQuery);
        });

        resultsContainer.innerHTML = "";

        if (filtered.length === 0) {
            resultsContainer.innerHTML = `<p class="status-msg text-lg">No results found for "<strong>${searchQuery}</strong>".</p>`;
            return;
        }

        filtered.forEach(post => {
            const clone = template.content.cloneNode(true);
            const link = clone.querySelector("a");
            link.href = `/posts/${post.id}/`;
            
            clone.querySelector(".result-title").textContent = post.data.title;
            clone.querySelector(".result-desc").textContent = post.data.description;
            
            const dateObj = new Date(post.data.updatedDate || post.data.publishDate);
            clone.querySelector(".result-date").textContent = dateObj.toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric'
            });

            resultsContainer.appendChild(clone);
        });
    }

    performSearch(query);

    searchInput.addEventListener("input", (e) => {
        const newUrl = new URL(window.location);
        newUrl.searchParams.set("q", e.target.value);
        window.history.pushState({}, "", newUrl);
        performSearch(e.target.value);
    });
</script>