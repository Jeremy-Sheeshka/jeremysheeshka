---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/Base.astro";
// Make sure this image exists in your new project at src/assets/jeremy/
import aboutImg from "@/assets/jeremy/desktop.jpg"; 

// 1. Meta Data
const meta = {
    description: "I'm a jazz guitarist and educator based out of Prince Rupert, B.C. Canada.",
    title: "About Me",
};

// 2. Data Content
const breakout = {
    title: "♪ ♫",
    intro: "Since 2016, I have been working as a K-12 Music Educator specializing in secondary school music education and jazz guitar.",
};

const faqs = [
    {
        question: "Do you teach guitar lessons privately?",
        answer: "Yes. My approach to teaching individuals is unique and free of pre-determined lesson plans or content. I feel I can best serve individual students by approaching each student thoughtfully with personalized content that aligns with their own goals as a musician.",
    },
    {
        question: "How long have you been studying the guitar for?",
        answer: "Well, truth be told I'm still learning to this day. It's the eternal repetition of learning, and applying knowledge to build something; to play something. I've been learning the guitar since 2005 and probably for my lifetime in the future.",
    },
];

const cta = {
    title: "Let's talk!",
    lead: "Feel free to reach out to me at hello@jeremysheeshka.ca whether you have a project in mind, an opportunity to share, or just want to connect. I'm always happy to chat.",
};
---

<PageLayout meta={meta}>
    <div class="space-y-6">
        <h1 class="title">About me</h1>
        
        <p class="text-lg italic text-accent">
            I'm a jazz guitarist and educator based out of Prince Rupert, B.C.
        </p>

        <div class="flex justify-center my-8">
            <Image 
                src={aboutImg} 
                alt="Where the magic happens"
                class="rounded-lg shadow-md grayscale hover:grayscale-0 transition-all duration-500"
                width={600}
                loading="eager"
            />
        </div>

        <div class="prose prose-sm prose-cactus max-w-none">
            <p>
                As a musician, my music aims to pay tribute to both traditional idioms and emerging trends inspired by musical innovations and contemporary technologies that lend itself to a variety of popular and experimental forms and stylistic mediums.
            </p>
            <p>
                I seek to create music that explores and draws upon relationships between people and places, improvisation and composition, as well as the familiar and abstract.
            </p>
            <p>
                As an educator, I believe that the best way to reinforce ones’ understanding of something is through sharing with others, whether that be through music, art, electronics, or web friendly technologies. My work strives to inspire and invigorate new understandings for 
                <sparkly-text class="pl-1 inline-block" number-of-sparkles="10" style="--sparkly-text-color: var(--theme-accent)">
                    creative minds everywhere.
                </sparkly-text>
            </p>
        </div>

        <div class="bg-quote/20 p-6 rounded-xl border-l-4 border-accent my-8">
            <h2 class="text-2xl font-bold mb-2">{breakout.title}</h2>
            <p>{breakout.intro}</p>
        </div>

        <section class="my-10">
            <h2 class="title text-xl mb-4">FAQ</h2>
            <dl class="space-y-6">
                {faqs.map((item) => (
                    <div class="group">
                        <dt class="font-semibold text-accent mb-1 text-lg group-hover:underline decoration-dashed decoration-1 underline-offset-4">
                            {item.question}
                        </dt>
                        <dd class="text-muted-foreground leading-relaxed">
                            {item.answer}
                        </dd>
                    </div>
                ))}
            </dl>
        </section>

        <section class="rounded-lg border border-dashed border-textColor/50 p-6 text-center">
            <h2 class="title text-xl mb-2">{cta.title}</h2>
            <p>
                Feel free to reach out to me at <a href="mailto:hello@jeremysheeshka.ca" class="cactus-link">hello@jeremysheeshka.ca</a> 
                whether you have a project in mind, an opportunity to share, or just want to connect.
            </p>
        </section>
    </div>
</PageLayout>

<script>
  import "@stefanjudis/sparkly-text";
</script>