---
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/utils";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

// 1. Calculate Min/Max for scaling
const counts = allTags.map(([_, count]) => count);
const minCount = Math.min(...counts);
const maxCount = Math.max(...counts);

const minSize = 1; // 1rem
const maxSize = 3.5; // 3.5rem

const meta = {
	description: "A visual cloud of all the topics I've written about",
	title: "All Tags",
};
---

<PageLayout meta={meta} themeColor="cream">
	<div class="w-full max-w-3xl mx-auto px-6 md:px-12 py-16">
		<h1 class="title mb-12 text-3xl font-bold">Tags</h1>
		
		<ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-8 text-center leading-relaxed">
			{
				allTags.map(([tag, count]) => {
					// 3. Dynamic sizing logic
					const size = maxCount === minCount 
						? minSize 
						: minSize + ((count - minCount) * (maxSize - minSize)) / (maxCount - minCount);

					return (
						<li class="inline-block">
							<a
								class="cactus-link transition-all duration-300 hover:text-[var(--theme-bright-sun)] hover:scale-110"
								href={`/tags/${tag}/`}
								style={`font-size: ${size}rem; opacity: ${0.4 + (count / maxCount) * 0.6};`}
								aria-label={`View posts with the tag ${tag}`}
							>
								<span class="opacity-40 text-[0.6em]">#</span>{tag}
							</a>
						</li>
					);
				})
			}
		</ul>

		<div class="mt-20 border-t border-dashed border-stone-300 dark:border-zinc-700 pt-10">
			<a href="/" class="inline-flex items-center gap-2 font-bold hover:text-accent transition-colors">
				<svg fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 26 24" class="w-5 h-5 rotate-180"><path d="M23 12H2"></path><path d="m17 6 7 6-7 6"></path></svg>
				Back to home
			</a>
		</div>
	</div>
</PageLayout>

<style>
	/* Ensures the tags feel balanced and helps with the 'Wordle' look */
	li {
		display: flex;
		align-items: center;
	}
	a {
		font-weight: 500;
		line-height: 1;
	}
	/* Add some weight variation for a more organic feel */
	li:nth-child(3n) a { font-weight: 700; }
	li:nth-child(5n) a { font-weight: 400; }
</style>