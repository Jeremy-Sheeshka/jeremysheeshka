---
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import homeImg from "@/assets/jeremy/sheeshka1400w.jpg";
import PostPreview from "@/components/blog/PostPreview.astro";

const roles = ["Hello there!"];

const MAX_POSTS = 5; 
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);
---

<PageLayout meta={{ title: "Home" }} themeColor="cream">
    <div class="w-full relative z-10 overflow-hidden">
        <div class="max-w-6xl mx-auto px-6 md:px-12 py-8 md:py-16 flex flex-col md:grid md:grid-cols-[1.5fr_1fr] md:grid-rows-[auto_auto] gap-x-12 gap-y-6 items-start relative z-10">
            <h1 class="text-3xl sm:text-6xl font-bold leading-[1.1] tracking-tight order-1 md:col-start-1 md:row-start-1">
                {roles.map((role) => (
                    <span class="block">{role}</span>
                ))}
            </h1>

            <div class="order-2 md:col-start-2 md:row-start-1 md:row-span-2 flex justify-center md:justify-end w-full">
                <Image 
                    src={homeImg} 
                    alt="Jeremy Sheeshka" 
                    class="lene-filter w-full rounded-xl shadow-2xl object-cover aspect-[3/2] md:aspect-[585/371] lg:aspect-[4/5] lg:max-w-xl"
                    loading="eager"
                />
            </div>

            <div class="order-3 md:col-start-1 md:row-start-2">
                <p class="text-xl md:text-2xl max-w-xl font-medium leading-tight opacity-90 text-pretty">
                    I'm a musician, educator, technologist who occasionally writes. Inspired by jazz guitar, education, and technology, I build tools and experiences to help design understandings.
                </p>             
            </div>
        </div>
    </div>

    <div class="w-full">
        <div class="max-w-3xl mx-auto px-6 md:px-12 py-16">
            <article class="relative mb-20">
                <h2 class="text-xs font-bold mb-10 text-stone-400 uppercase tracking-[0.2em]">
                    Recent Writing
                </h2>
                
                <ul class="divide-y divide-stone-200 dark:divide-zinc-800 border-t border-stone-200 dark:border-zinc-800">
                    {latestPosts.map((p) => (
                        <li class="group relative">
                            <div
                                class="relative transition-all duration-500 ease-out py-6 px-2 
                                       group-hover:bg-stone-50/50 dark:group-hover:bg-zinc-900/30 
                                       group-hover:pl-4"
                            >
                                <a
                                    href={`/posts/${p.id}/`}
                                    class="absolute inset-0 z-20"
                                    aria-label={`Read ${p.data.title}`}
                                ></a>
                                
                                <div class="relative z-10 flex items-baseline justify-between gap-4">
                                    <div class="flex-grow pointer-events-none group-hover:text-accent transition-colors duration-300">
                                        <PostPreview post={p} />
                                    </div>
                                    
                                    <div class="hidden md:block opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-accent">
                                        <svg
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2.5"
                                            viewBox="0 0 24 24"
                                            class="w-4 h-4"
                                        >
                                            <path d="M5 12h14m-7-7 7 7-7 7"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>

                <div class="mt-12">
                    <a
                        href="/posts/"
                        class="inline-flex items-center gap-2 text-sm font-bold text-stone-500 hover:text-accent transition-colors uppercase tracking-widest"
                    >
                        See all posts
                        <svg
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            viewBox="0 0 26 24"
                            class="w-4 h-4"
                        >
                            <path d="M23 12H2"></path>
                            <path d="m17 6 7 6-7 6"></path>
                        </svg>
                    </a>
                </div>
            </article>
        </div>
    </div>
</PageLayout>
