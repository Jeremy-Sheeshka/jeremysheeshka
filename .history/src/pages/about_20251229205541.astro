---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/Base.astro";
import aboutImg from "@/assets/jeremy/clayman.jpg";

const meta = {
    description: "I'm a jazz guitarist and educator based out of Prince Rupert, B.C. Canada.",
    title: "About Me",
};

const breakout = {
    title: "♪ ♫",
    intro: "Since 2016, I have been working as a K-12 Music Educator specializing in secondary school music education and jazz guitar.",
};

const faqs = [
    {
        question: "Do you teach guitar lessons privately?",
        answer: "Yes. My approach to teaching individuals is unique and free of pre-determined lesson plans or content. I feel I can best serve individual students by approaching each student thoughtfully with personalized content that aligns with their own goals as a musician.",
    },
    {
        question: "How long have you been studying the guitar for?",
        answer: "Well, truth be told I'm still learning to this day. It's the eternal repetition of learning, and applying knowledge to build something; to play something. I've been learning the guitar since 2005 and probably for my lifetime in the future.",
    },
];

const cta = {
    title: "Let's talk!",
    lead: "Feel free to reach out to me at hello@jeremysheeshka.ca whether you have a project in mind, an opportunity to share, or just want to connect. I'm always happy to chat.",
};
---

<PageLayout meta={meta} themeColor="cream">
    
    <div class="w-full relative z-10 overflow-hidden bg-[var(--theme-cinnabar)] text-white">
        <div class="max-w-6xl mx-auto px-6 md:px-12 py-8 md:py-16 flex flex-col md:grid md:grid-cols-[1.5fr_1fr] md:grid-rows-[auto_auto] gap-x-12 gap-y-6 items-start relative z-10">
            
            <h1 class="text-3xl sm:text-6xl font-bold leading-[1.1] tracking-tight order-1 md:col-start-1 md:row-start-1" style="font-family: var(--font-display);">
                About Me
            </h1>

            <div class="order-2 md:col-start-2 md:row-start-1 md:row-span-2 flex justify-center md:justify-end w-full">
                <Image 
                    src={aboutImg} 
                    alt="Jeremy Clayman" 
                    class="lene-filter w-full max-w-md rounded-xl shadow-2xl object-cover aspect-[4/5]"
                    loading="eager"
                />
            </div>

            <p class="text-lg sm:text-xl leading-relaxed opacity-90 max-w-2xl text-pretty order-3 md:col-start-1 md:row-start-2">
                I'm a jazz guitarist and educator based out of Prince Rupert, B.C. Canada.
            </p>

        </div>
    </div>

    <div class="w-full text-global-text" style="color: inherit;">
        <div class="max-w-3xl mx-auto px-6 md:px-12 py-16">
            
            <div class="prose prose-sm prose-cactus max-w-none">
                <p>
                    As a musician, my music aims to pay tribute to both traditional idioms and emerging trends inspired by musical innovations and contemporary technologies.
                </p>
                <p>
                    I seek to create music that explores and draws upon relationships between people and places, improvisation and composition, as well as the familiar and abstract.
                </p>
                <p>
                    As an educator, I believe that the best way to reinforce ones’ understanding of something is through sharing with others. My work strives to inspire and invigorate new understandings for 
                    <sparkly-text class="pl-1 inline-block" number-of-sparkles="10" style="--sparkly-text-color: var(--theme-accent)">
                        creative minds everywhere.
                    </sparkly-text>
                </p>
            </div>

            <div class="border-l-4 border-accent pl-6 py-2 my-12">
                <h2 class="text-2xl font-bold mb-2 text-accent-2">{breakout.title}</h2>
                <p class="italic text-lg opacity-90">{breakout.intro}</p>
            </div>

            <section class="my-16">
                <h2 class="title text-2xl mb-8">FAQ</h2>
                <dl class="space-y-8">
                    {faqs.map((item) => (
                        <div class="group">
                            <dt class="font-bold text-accent mb-2 text-xl group-hover:underline decoration-dashed decoration-1 underline-offset-4">
                                {item.question}
                            </dt>
                            <dd class="opacity-90 leading-relaxed max-w-prose">
                                {item.answer}
                            </dd>
                        </div>
                    ))}
                </dl>
            </section>

            <section class="border-t border-dashed border-current pt-10 mt-16 opacity-80">
                <h2 class="text-2xl font-bold mb-4">{cta.title}</h2>
                <p class="text-lg">
                    {cta.lead}
                </p>
            </section>

        </div>
    </div>
</PageLayout>

<script>
  import "@stefanjudis/sparkly-text";
</script>

<style>
    /* HEADER OVERRIDE 
    This forces the header to look "Red" even though the page theme is "Cream".
    */
    :global(#main-header) {
        background-color: var(--theme-cinnabar);
        /* Force text to be white */
        --header-text: #ffffff; 
        color: #ffffff;
        
        /* CRITICAL FIX: 
        Override the first color of the rainbow animation (--rb-1) to be WHITE.
        Without this, the name starts as RED and vanishes into the RED background.
        */
        --rb-1: #ffffff; 
    }

    /* Force Nav Links to be White explicitly */
    :global(#main-header nav a) {
        color: #ffffff !important;
    }
    
    /* Ensure Theme Toggle is White */
    :global(#main-header button) {
        color: #ffffff !important;
    }
</style>