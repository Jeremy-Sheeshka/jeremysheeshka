---
import { getCollection } from "astro:content";
import { Image } from "astro:assets"; 
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import Note from "@/components/note/Note.astro";
import projectImg from "@/assets/jeremy/desktop.jpg"; 

const allProjects = await getCollection("note");
const sortedProjects = allProjects.sort(collectionDateSort);

const meta = {
    title: "Projects",
    description: "A collection of my projects and ideas.",
};
---

<PageLayout meta={meta} themeColor="royal-blue">
    
    <div class="max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-20 text-global-text">
        
        {/* HERO SECTION: Intro + Image 
            Unified layout similar to About page, using Royal Blue theme.
        */}
        <div class="grid md:grid-cols-[1.5fr_1fr] gap-12 items-center mb-24">
            
            {/* COLUMN 1: Text */}
            <div class="order-2 md:order-1">
                <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight text-[var(--theme-royal-blue)]" style="font-family: var(--font-display);">
                    Projects
                </h1>
                <p class="text-xl md:text-2xl leading-relaxed opacity-90 text-pretty">
                    Here are some of the things I've been working on. A mix of code, music, and experiments.
                </p>
            </div>

            {/* COLUMN 2: Image */}
            <div class="order-1 md:order-2 flex justify-center md:justify-end">
                <div class="relative group w-full max-w-sm">
                    {/* Decorative Offset Box (Royal Blue) */}
                    <div class="absolute inset-0 bg-[var(--theme-royal-blue)] rounded-xl translate-x-3 translate-y-3 -z-10 group-hover:translate-x-2 group-hover:translate-y-2 transition-transform duration-300"></div>
                    <Image 
                        src={projectImg} 
                        alt="Jeremy's Desktop" 
                        class="w-full rounded-xl shadow-lg rotate-0 hover:-rotate-1 transition-transform duration-500 object-cover aspect-square"
                        loading="eager"
                    />
                </div>
            </div>

        </div>

        {/* PROJECTS GRID SECTION 
            Displays cards with Title, Description, Tags, and Hover Animation.
        */}
        {sortedProjects.length === 0 ? (
            <div class="text-center py-20 border-2 border-dashed border-gray-200 rounded-xl">
                <p class="text-xl opacity-60">Projects coming soon...</p>
            </div>
        ) : (
            <ul class="grid md:grid-cols-2 gap-6">
                {sortedProjects.map((project) => (
                    /* CARD CONTAINER 
                       - h-full: Ensures all cards in a row are the same height.
                       - group: Allows child elements (like the arrow) to react when the parent is hovered.
                       - backdrop-blur: Adds a modern "frosted glass" effect.
                    */
                    <li class="group flex flex-col h-full border border-gray-200 dark:border-gray-700 rounded-2xl p-6 hover:shadow-xl hover:border-[var(--theme-royal-blue)] transition-all duration-300 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm">
                        
                        {/* 1. TITLE (The Note Component) 
                            Changes color to Royal Blue when the card is hovered.
                        */}
                        <div class="group-hover:text-[var(--theme-royal-blue)] transition-colors duration-300 mb-4">
                             <Note note={project} as="h3" /> 
                        </div>

                        {/* 2. DESCRIPTION 
                            Pulls from frontmatter. Uses 'line-clamp-3' to cut off long text cleanly.
                        */}
                        <p class="text-sm opacity-80 mb-6 line-clamp-3 leading-relaxed">
                            {project.data.description || "No description available for this project."}
                        </p>

                        {/* 3. FOOTER: Tags + Animated Arrow */}
                        <div class="mt-auto pt-4 border-t border-dashed border-gray-200 dark:border-gray-700 flex justify-between items-center">
                            
                            {/* Tags (Only show first 3 to prevent clutter) */}
                            <div class="flex gap-2">
                                {(project.data.tags || []).slice(0, 3).map((tag) => (
                                    <span class="text-[10px] uppercase tracking-wider font-bold opacity-60 bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded-md">
                                        #{tag}
                                    </span>
                                ))}
                            </div>

                            {/* Arrow Icon 
                                Hidden by default (opacity-0).
                                Slides in and appears on hover (group-hover:opacity-100).
                            */}
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-[var(--theme-royal-blue)]">
                                <path d="M5 12h14" />
                                <path d="m12 5 7 7-7 7" />
                            </svg>

                        </div>
                        
                    </li>
                ))}
            </ul>
        )}

    </div>

</PageLayout>