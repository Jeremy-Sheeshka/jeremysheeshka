---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets"; 
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
    const MAX_POSTS_PER_PAGE = 10;
    const allPosts = await getAllPosts();
    const allPostsByDate = allPosts.sort(collectionDateSort);
    const uniqueTags = getUniqueTags(allPosts).slice(0, 7);
    const pinnedPosts = allPostsByDate.filter((p) => p.data.pinned).slice(0, 3);
    return paginate(allPostsByDate, {
        pageSize: MAX_POSTS_PER_PAGE,
        props: { uniqueTags, pinnedPosts },
    });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<"post">>;
    uniqueTags: string[];
    pinnedPosts: CollectionEntry<"post">[];
}

const { page, uniqueTags, pinnedPosts } = Astro.props;
const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

const meta = { title: "Posts", description: "Read my collection of posts" };
const paginationProps = {
    ...(page.url.prev && { prevUrl: { text: "← Previous", url: page.url.prev } }),
    ...(page.url.next && { nextUrl: { text: "Next →", url: page.url.next } }),
};

const currentYear = new Date().getFullYear();
const isNew = (date: Date) => date.getFullYear() === currentYear;
---

<PageLayout meta={meta} themeColor="cream">
    
    {/* HERO SECTION */}
    <div class="relative w-full bg-[var(--theme-bright-sun)] text-[var(--theme-text)] overflow-hidden bg-texture">
        <div class="absolute inset-0 opacity-10 pointer-events-none mix-blend-multiply">
            <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M0 100 C 20 0 50 0 100 100 Z" fill="currentColor" />
            </svg>
        </div>

        <div class="max-w-6xl mx-auto px-6 md:px-12 py-16 md:py-32 relative z-10 animate-in" style="--delay: 0ms">
            <h1 class="text-6xl md:text-9xl font-bold tracking-tighter mb-8 mix-blend-darken" style="font-family: var(--font-display);">
                The Blog
            </h1>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-t-4 border-current pt-6">
                <p class="text-xl md:text-2xl max-w-xl font-medium leading-tight">
                    Thoughts on web development, music education, and the creative process.
                </p>
                <div class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest opacity-70">
                    <span>Est. 2016</span>
                    <span>•</span>
                    <span>Prince Rupert, BC</span>
                </div>
            </div>
        </div>
    </div>

    {/* MOBILE TAG SCROLLER 
        Added aria-label for accessibility
    */}
    <nav aria-label="Topics" class="lg:hidden w-full overflow-x-auto border-b border-gray-200 dark:border-gray-800 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-md sticky top-0 z-20 mask-linear">
        <div class="flex gap-2 px-6 py-4 min-w-max">
            {uniqueTags.map((tag) => (
                <a 
                    class="px-3 py-1 text-xs font-bold uppercase tracking-wide bg-gray-100 dark:bg-zinc-800 rounded-full hover:bg-[var(--theme-bright-sun)] hover:text-black transition-colors" 
                    href={`/tags/${tag}/`}
                >
                    #{tag}
                </a>
            ))}
            <div class="w-4"></div>
        </div>
    </nav>

    {/* MAIN CONTENT GRID */}
    <div class="max-w-6xl mx-auto px-6 md:px-12 py-16">
        <div class="grid lg:grid-cols-[1fr_300px] gap-16">
            
            {/* COLUMN 1: The Feed */}
            <main>
                
                {/* EDITOR'S CHOICE */}
                {pinnedPosts.length > 0 && (
                    <section class="mb-20 animate-in" style="--delay: 100ms">
                        <div class="flex items-center gap-2 mb-8">
                            <h2 class="font-bold text-lg uppercase tracking-wider text-global-text">
                                <sparkly-text number-of-sparkles="3" style="--sparkly-text-color: var(--theme-bright-sun)">
                                    Editor's Choice
                                </sparkly-text>
                            </h2>
                        </div>
                        
                        <ul class="grid gap-6">
                            {pinnedPosts.map((p) => (
                                <li class="bg-gray-50 dark:bg-zinc-900 p-6 rounded-2xl hover:bg-[var(--theme-bright-sun)] hover:text-black transition-all duration-300 ease-out group shadow-sm hover:shadow-md border border-gray-100 dark:border-gray-800 relative overflow-hidden transform hover:scale-[1.02] active:scale-[0.98]">
                                    
                                    {/* IMPROVED BADGE: Clear Text "NEW" instead of just a dot */}
                                    {isNew(p.data.publishDate) && (
                                        <span class="absolute top-4 right-4 text-[10px] font-bold text-red-600 bg-red-100 dark:bg-red-900/30 dark:text-red-300 px-2 py-1 rounded-full border border-red-200 dark:border-red-800 z-10">
                                            NEW
                                        </span>
                                    )}
                                    
                                    <PostPreview post={p} withDesc /> 
                                </li>
                            ))}
                        </ul>
                    </section>
                )}

                {/* TIMELINE */}
                {descYearKeys.map((yearKey, index) => (
                    <section class="mb-16 animate-in" style={`--delay: ${200 + (index * 100)}ms`}>
                        <h2 class="text-4xl font-bold text-gray-300 dark:text-gray-700 mb-8 select-none">
                            {yearKey}
                        </h2>
                        
                        <ul class="space-y-0 border-l-2 border-gray-200 dark:border-gray-800 ml-3">
                            {groupedByYear[yearKey]?.map((p) => (
                                <li class="relative pl-8 py-4 group">
                                    <div class="absolute -left-[7px] top-7 w-3 h-3 rounded-full bg-gray-300 dark:bg-gray-700 group-hover:bg-[var(--theme-bright-sun)] transition-colors duration-300 ring-4 ring-white dark:ring-[#1a1810]"></div>
                                    <div class="transition-transform duration-300 group-hover:translate-x-1">
                                        <PostPreview post={p} />
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))}
                
                <div class="mt-12 pt-12 border-t border-dashed border-gray-200 dark:border-gray-800 animate-in" style="--delay: 500ms">
                    <Pagination {...paginationProps} />
                </div>
            </main>

            {/* COLUMN 2: Sidebar */}
            <aside class="hidden lg:block h-full animate-in" style="--delay: 300ms">
                <div class="sticky top-24 space-y-8">
                    
                    {/* 1. SEARCH WIDGET (Yellow Border + Yellow Icon) */}
                    <form role="search" class="relative group" action="/search" method="get" onsubmit="event.preventDefault();">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[var(--theme-bright-sun)]">
                             <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        </div>
                        <input 
                            type="search" 
                            name="q"
                            placeholder="Search articles..." 
                            class="block w-full pl-10 pr-3 py-3 border-2 border-[var(--theme-bright-sun)] rounded-2xl leading-5 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm placeholder-gray-500 focus:outline-none focus:ring-4 focus:ring-[var(--theme-bright-sun)]/20 transition-all hover:bg-white dark:hover:bg-black"
                            aria-label="Search articles"
                        />
                    </form>

                    {/* 2. TOPICS + RSS (Yellow Icon) */}
                    <div class="p-6 border border-gray-200 dark:border-gray-800 rounded-2xl bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm shadow-sm">
                        <div class="flex items-center justify-between mb-6">
                            <h2 class="font-bold text-xl flex items-center gap-2">Topics</h2>
                            
                            {/* RSS Icon Button */}
                            <a href="/rss.xml" class="text-[var(--theme-bright-sun)] hover:scale-110 transition-transform p-1" aria-label="RSS Feed">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
                            </a>
                        </div>
                        
                        <ul class="flex flex-wrap gap-2">
                            {uniqueTags.map((tag) => (
                                <li>
                                    <a class="inline-block px-3 py-1 text-sm bg-gray-100 dark:bg-zinc-800 rounded-lg hover:bg-[var(--theme-bright-sun)] hover:text-black transition-colors duration-200" href={`/tags/${tag}/`}>#{tag}</a>
                                </li>
                            ))}
                        </ul>
                        <div class="mt-6 pt-6 border-t border-dashed border-gray-200 dark:border-gray-700">
                            <a href="/tags/" class="text-sm font-bold opacity-60 hover:opacity-100 hover:text-[var(--theme-bright-sun)] transition-all flex items-center gap-1">View all tags <span class="text-lg">→</span></a>
                        </div>
                    </div>

                </div>
            </aside>

        </div>
    </div>
</PageLayout>

<script>
  import "@stefanjudis/sparkly-text";
</script>

<style>
    /* Entrance Animation - With Reduced Motion Support */
    .animate-in {
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
        animation-delay: var(--delay, 0ms);
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-in { opacity: 1; animation: none; }
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Gradient Mask for Mobile Scroller */
    .mask-linear {
        mask-image: linear-gradient(to right, black 85%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
    }

    /* ----------------------------------------------------------------- */
    /* HEADER OVERRIDE FOR BLOG */
    /* Forces the main header to match the "Bright Sun" yellow theme */
    /* ----------------------------------------------------------------- */
    :global(#main-header) {
        background-color: var(--theme-bright-sun);
        /* We force the text to be dark (Charcoal) because the yellow is bright */
        color: #1a1810; 
        --header-text: #1a1810;
        border-bottom-color: transparent; /* Remove the glass border */
        backdrop-filter: none; /* Remove the blur so the color is solid */
    }

    /* Force Nav Links to be Dark so they are readable on Yellow */
    :global(#main-header nav a) {
        color: #1a1810 !important;
        opacity: 0.8;
    }
    :global(#main-header nav a:hover) {
        opacity: 1;
        color: #000000 !important;
    }

    /* Force Theme Toggle Button to be Dark */
    :global(#main-header button) {
        color: #1a1810 !important;
    }
</style>