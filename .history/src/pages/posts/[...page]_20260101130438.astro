---
// File: src/pages/blog.astro
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
    const MAX_POSTS_PER_PAGE = 10;
    const allPosts = await getAllPosts();
    const allPostsByDate = allPosts.sort(collectionDateSort);
    const uniqueTags = getUniqueTags(allPosts).slice(0, 7);
    
    return paginate(allPostsByDate, {
        pageSize: MAX_POSTS_PER_PAGE,
        props: { uniqueTags },
    });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<"post">>;
    uniqueTags: string[];
}

const { page, uniqueTags } = Astro.props;
const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

const meta = { title: "Posts", description: "Read my collection of posts" };
const paginationProps = {
    ...(page.url.prev && { prevUrl: { text: "← Previous", url: page.url.prev } }),
    ...(page.url.next && { nextUrl: { text: "Next →", url: page.url.next } }),
};
---

<PageLayout meta={meta} themeColor="cream">
    
    {/* HERO SECTION */}
    <div class="relative max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-20">
        
        {/* Abstract "Guitar Strings" Decoration with Fade Mask */}
        <div class="absolute right-0 top-10 -z-10 opacity-15 pointer-events-none overflow-hidden">
            <svg width="400" height="400" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-[var(--theme-bright-sun)]">
                
                {/* Definition for the fade effect */}
                <defs>
                    <linearGradient id="string-fade" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="white" stop-opacity="1" />
                        <stop offset="100%" stop-color="white" stop-opacity="0" />
                    </linearGradient>
                </defs>

                {/* Group applying the mask */}
                <g mask="url(#string-fade)">
                    {/* Vertical Strings */}
                    <path d="M50 0V400" stroke="currentColor" stroke-width="2"/>
                    <path d="M100 0V400" stroke="currentColor" stroke-width="2"/>
                    <path d="M150 0V400" stroke="currentColor" stroke-width="2"/>
                    <path d="M200 0V400" stroke="currentColor" stroke-width="2"/>
                    <path d="M250 0V400" stroke="currentColor" stroke-width="2"/>
                    <path d="M300 0V400" stroke="currentColor" stroke-width="2"/>
                    
                    {/* UPDATED: Three Evenly Spaced 'Frets' */}
                    <path d="M0 100H400" stroke="currentColor" stroke-width="1" stroke-dasharray="10 10"/>
                    <path d="M0 200H400" stroke="currentColor" stroke-width="1" stroke-dasharray="10 10"/>
                    <path d="M0 300H400" stroke="currentColor" stroke-width="1" stroke-dasharray="10 10"/>
                </g>
            </svg>
        </div>

        <div class="grid md:grid-cols-[2fr_1fr] gap-12 items-end mb-16">
            <div class="animate-in" style="--delay: 0ms">
                <h1 class="text-6xl md:text-8xl font-bold tracking-tighter mb-6 text-[var(--theme-bright-sun)]" style="font-family: var(--font-display);">
                    The Blog
                </h1>
                <p class="text-xl md:text-2xl max-w-2xl font-medium leading-tight opacity-90 text-pretty">
                    Thoughts on web development, music education, and the creative process.
                </p>
                
                <div class="flex items-center gap-4 mt-6 text-sm font-bold uppercase tracking-widest opacity-60">
                    <span class="flex items-center gap-2">
                        <span class="block w-2 h-2 rounded-full bg-[var(--theme-bright-sun)]"></span>
                        Est. 2016
                    </span>
                    <span>•</span>
                    <span>Prince Rupert, BC</span>
                </div>
            </div>
        </div>
    </div>

    {/* MOBILE TAG SCROLLER */}
    <nav aria-label="Topics" class="lg:hidden w-full overflow-x-auto border-b border-gray-200 dark:border-gray-800 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-md sticky top-0 z-40 mask-linear mb-12">
        <div class="flex gap-2 px-6 py-2.5 min-w-max">
            {uniqueTags.map((tag) => (
                <a 
                    class="px-3 py-1 text-xs font-bold uppercase tracking-wide bg-stone-200 text-zinc-900 dark:bg-zinc-800 dark:text-gray-200 rounded-full hover:bg-[var(--theme-bright-sun)] hover:text-black transition-colors" 
                    href={`/tags/${tag}/`}
                >
                    #{tag}
                </a>
            ))}
            <div class="w-4"></div>
        </div>
    </nav>

    {/* MAIN CONTENT GRID */}
    <div class="max-w-6xl mx-auto px-6 md:px-12 pb-16">
        
        <div class="grid lg:grid-cols-[1fr_240px] gap-16">
            
            {/* COLUMN 1: The Feed */}
            <main>
                
                {/* TIMELINE */}
                {descYearKeys.map((yearKey, index) => (
                    <section class="mb-16 animate-in" style={`--delay: ${100 + (index * 100)}ms`}>
                        <h2 class="text-4xl font-bold text-stone-300 dark:text-zinc-700 mb-8 select-none">
                            {yearKey}
                        </h2>
                        
                        <ul class="space-y-4 border-l-2 border-stone-200 dark:border-zinc-800 ml-3">
                            {groupedByYear[yearKey]?.map((p) => (
                                <li class="relative pl-8 group">
                                    {/* The Dot */}
                                    <div class="absolute -left-[7px] top-6 w-3 h-3 rounded-full bg-stone-300 dark:bg-zinc-700 group-hover:bg-[var(--theme-bright-sun)] transition-colors duration-300 ring-4 ring-[#fdfbf6] dark:ring-[#1a1810] z-20 pointer-events-none"></div>
                                    
                                    <div class="relative transition-all duration-300 group-hover:translate-x-1 border-2 border-transparent hover:border-[var(--theme-bright-sun)]/50 hover:dark:border-[var(--theme-bright-sun)] p-6 rounded-2xl bg-transparent hover:bg-stone-100/60 dark:bg-zinc-900/50 hover:dark:bg-zinc-900/80 text-zinc-900 dark:text-white">
                                        
                                        <a href={`/posts/${p.slug}/`} class="absolute inset-0 z-0" aria-label={`Read ${p.data.title}`}></a>

                                        <div class="relative z-10 pointer-events-none">
                                            <PostPreview post={p} />
                                        </div>
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))}
                
                <div class="mt-12 pt-12 border-t border-dashed border-stone-200 dark:border-zinc-800 animate-in" style="--delay: 500ms">
                    <Pagination {...paginationProps} />
                </div>
            </main>

            {/* COLUMN 2: Sidebar */}
            <aside class="hidden lg:block h-full animate-in" style="--delay: 300ms">
                <div class="sticky top-0 space-y-8 z-30 pt-4">
                    
                    {/* SEARCH WIDGET */}
                    <form role="search" class="relative group" action="/search" method="get" onsubmit="event.preventDefault();">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[var(--theme-bright-sun)]">
                             <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        </div>
                        <input 
                            type="search" 
                            name="q"
                            placeholder="Search articles..." 
                            class="block w-full pl-10 pr-3 py-3 border-2 border-[var(--theme-bright-sun)] rounded-2xl leading-5 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm focus:outline-none focus:ring-4 focus:ring-[var(--theme-bright-sun)]/20 transition-all hover:bg-white dark:hover:bg-black text-zinc-900 dark:text-white placeholder-zinc-500"
                            aria-label="Search articles"
                        />
                    </form>

                    {/* TOPICS + RSS */}
                    <div class="p-6 border border-stone-200 dark:border-zinc-800 rounded-2xl bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm shadow-sm">
                        <div class="flex items-center justify-between mb-6">
                            <h2 class="font-bold text-xl flex items-center gap-2 text-zinc-900 dark:text-white">Topics</h2>
                            <a href="/rss.xml" class="text-[var(--theme-bright-sun)] hover:scale-110 transition-transform p-1" aria-label="RSS Feed">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
                            </a>
                        </div>
                        
                        <ul class="flex flex-wrap gap-2">
                            {uniqueTags.map((tag) => (
                                <li>
                                    <a class="inline-block px-3 py-1 text-sm bg-stone-200 text-zinc-900 dark:bg-zinc-800 dark:text-gray-200 rounded-lg hover:bg-[var(--theme-bright-sun)] hover:text-black transition-colors duration-200" href={`/tags/${tag}/`}>#{tag}</a>
                                </li>
                            ))}
                        </ul>
                        <div class="mt-6 pt-6 border-t border-dashed border-stone-200 dark:border-zinc-700">
                            <a href="/tags/" class="text-sm font-bold opacity-60 hover:opacity-100 hover:text-[var(--theme-bright-sun)] transition-all flex items-center gap-1 text-zinc-900 dark:text-white">View all tags <span class="text-lg">→</span></a>
                        </div>
                    </div>

                </div>
            </aside>

        </div>
    </div>
</PageLayout>

<script>
  import "@stefanjudis/sparkly-text";
</script>

<style>
    /* OVERRIDE: FORCE DATES TO BE THEME COLOR INSTEAD OF GREY */
    :global(main time), :global(.date) {
        color: var(--theme-bright-sun) !important;
        font-weight: bold;
        opacity: 1 !important;
    }

    /* Entrance Animation */
    .animate-in {
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
        animation-delay: var(--delay, 0ms);
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-in { opacity: 1; animation: none; }
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .mask-linear {
        mask-image: linear-gradient(to right, black 85%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
    }
</style>