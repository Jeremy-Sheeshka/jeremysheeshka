---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
    const MAX_POSTS_PER_PAGE = 10;
    const allPosts = await getAllPosts();
    const allPostsByDate = allPosts.sort(collectionDateSort);
    const uniqueTags = getUniqueTags(allPosts).slice(0, 7);
    
    return paginate(allPostsByDate, {
        pageSize: MAX_POSTS_PER_PAGE,
        props: { uniqueTags },
    });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<"post">>;
    uniqueTags: string[];
}

const { page, uniqueTags } = Astro.props;
const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

const meta = { title: "Posts", description: "Read my collection of posts" };
const paginationProps = {
    ...(page.url.prev && { prevUrl: { text: "← Previous", url: page.url.prev } }),
    ...(page.url.next && { nextUrl: { text: "Next →", url: page.url.next } }),
};
---

<PageLayout meta={meta} themeColor="cream">

    {/* HERO SECTION */}
    <div class="relative w-full bg-[var(--theme-bright-sun)] text-[var(--theme-text)] overflow-hidden bg-texture">
        <div class="absolute inset-0 opacity-10 pointer-events-none mix-blend-multiply">
            <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M0 100 C 20 0 50 0 100 100 Z" fill="currentColor" />
            </svg>
        </div>

        <div class="max-w-6xl mx-auto px-6 md:px-12 py-16 md:py-32 relative z-10 animate-in">
            <h1 class="text-6xl md:text-9xl font-bold tracking-tighter mb-8 mix-blend-darken" style="font-family: var(--font-display);">
                The Blog
            </h1>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-t-4 border-current pt-6">
                <p class="text-xl md:text-2xl max-w-xl font-medium leading-tight">
                    Thoughts on web development, music education, and the creative process.
                </p>
                <div class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest opacity-70">
                    <span>Est. 2016</span>
                    <span>•</span>
                    <span>Prince Rupert, BC</span>
                </div>
            </div>
        </div>
    </div>

    {/* MOBILE TAG SCROLLER */}
    <nav aria-label="Topics" class="lg:hidden w-full overflow-x-auto border-b border-gray-200 dark:border-gray-800 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-md sticky top-0 z-20 mask-linear">
        <div class="flex gap-2 px-6 py-2.5 min-w-max">
            {uniqueTags.map((tag) => (
                <a
                    class="px-3 py-1 text-xs font-bold uppercase tracking-wide
                           bg-gray-200 text-black
                           hover:bg-yellow-100
                           dark:bg-zinc-800 dark:text-gray-200
                           dark:hover:bg-[var(--theme-bright-sun)]
                           transition-colors rounded-full"
                    href={`/tags/${tag}/`}
                >
                    #{tag}
                </a>
            ))}
            <div class="w-4"></div>
        </div>
    </nav>

    {/* MAIN CONTENT GRID */}
    <div class="max-w-6xl mx-auto px-6 md:px-12 py-16">
        <div class="grid lg:grid-cols-[1fr_240px] gap-16">

            {/* COLUMN 1: Feed */}
            <main>
                {descYearKeys.map((yearKey, index) => (
                    <section class="mb-16 animate-in" style={`--delay: ${100 + index * 100}ms`}>
                        <h2 class="text-4xl font-bold text-gray-300 dark:text-gray-700 mb-8 select-none">
                            {yearKey}
                        </h2>

                        <ul class="space-y-4 border-l-2 border-gray-200 dark:border-gray-800 ml-3">
                            {groupedByYear[yearKey]?.map((p) => (
                                <li class="relative pl-8 group">

                                    {/* Timeline Dot */}
                                    <div
                                        class="absolute -left-[7px] top-6 w-3 h-3 rounded-full
                                               bg-gray-300 group-hover:bg-gray-400
                                               dark:bg-gray-700 group-hover:dark:bg-[var(--theme-bright-sun)]
                                               transition-colors duration-300
                                               ring-4 ring-white dark:ring-[#1a1810]
                                               z-20 pointer-events-none">
                                    </div>

                                    {/* Card */}
                                    <div
                                        class="relative transition-all duration-300 group-hover:translate-x-1
                                               p-6 rounded-2xl
                                               bg-white/40 hover:bg-white/70
                                               border border-gray-200 hover:border-gray-300
                                               dark:bg-zinc-900/50 dark:border-gray-800
                                               hover:dark:bg-zinc-900 hover:dark:border-[var(--theme-bright-sun)]
                                               text-black dark:text-white"
                                    >
                                        <a href={`/posts/${p.slug}/`} class="absolute inset-0 z-0" aria-label={`Read ${p.data.title}`}></a>
                                        <div class="relative z-10 pointer-events-none">
                                            <PostPreview post={p} />
                                        </div>
                                    </div>

                                </li>
                            ))}
                        </ul>
                    </section>
                ))}

                <div class="mt-12 pt-12 border-t border-dashed border-gray-200 dark:border-gray-800 animate-in">
                    <Pagination {...paginationProps} />
                </div>
            </main>

            {/* SIDEBAR */}
            <aside class="hidden lg:block animate-in">
                <div class="sticky top-24 space-y-8">

                    {/* SEARCH */}
                    <form role="search" class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[var(--theme-bright-sun)]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                        <input
                            type="search"
                            placeholder="Search articles..."
                            class="block w-full pl-10 pr-3 py-3 border-2 border-[var(--theme-bright-sun)]
                                   rounded-2xl bg-white/50 dark:bg-zinc-900/50
                                   hover:bg-white dark:hover:bg-black
                                   text-black dark:text-white
                                   placeholder-zinc-700 dark:placeholder-zinc-300
                                   focus:outline-none focus:ring-4 focus:ring-[var(--theme-bright-sun)]/20"
                        />
                    </form>

                    {/* TOPICS */}
                    <div class="p-6 border border-gray-200 dark:border-gray-800 rounded-2xl bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm shadow-sm">
                        <h2 class="font-bold text-xl mb-6">Topics</h2>
                        <ul class="flex flex-wrap gap-2">
                            {uniqueTags.map((tag) => (
                                <li>
                                    <a
                                        class="px-3 py-1 text-sm
                                               bg-gray-200 text-black
                                               hover:bg-yellow-100
                                               dark:bg-zinc-800 dark:text-gray-200
                                               dark:hover:bg-[var(--theme-bright-sun)]
                                               rounded-lg transition-colors"
                                        href={`/tags/${tag}/`}
                                    >
                                        #{tag}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>

                </div>
            </aside>

        </div>
    </div>
</PageLayout>

<script>
  import "@stefanjudis/sparkly-text";
</script>

<style>
    :global(main time),
    :global(.date) {
        color: var(--theme-bright-sun) !important;
        font-weight: bold;
        opacity: 1 !important;
    }

    .animate-in {
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .mask-linear {
        mask-image: linear-gradient(to right, black 85%, transparent 100%);
    }
</style>
