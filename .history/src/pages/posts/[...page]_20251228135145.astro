---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
    const MAX_POSTS_PER_PAGE = 5;
    const allPosts = await getAllPosts();
    const allPostsByDate = allPosts.sort(collectionDateSort);
    return paginate(allPostsByDate, { pageSize: MAX_POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;

const meta = {
    description: "Read my collection of posts and the things that interest me",
    title: "Posts",
};

const paginationProps = {
    ...(page.url.prev && {
        prevUrl: {
            text: "← Previous",
            url: page.url.prev,
        },
    }),
    ...(page.url.next && {
        nextUrl: {
            text: "Next →",
            url: page.url.next,
        },
    }),
};
---

<PageLayout meta={meta}>
    
    <div class="full-width-hero w-full relative -mt-8 mb-16">
        <div class="inner-hero px-6 md:px-12 pt-16 pb-24 md:pb-32 flex flex-col md:flex-row items-end justify-between">
            
            <div class="hero-content max-w-3xl z-10">
                <h1 class="font-bold text-5xl md:text-7xl mb-6">Blog</h1>
                <p class="text-xl md:text-2xl leading-relaxed opacity-90">
                    I'm writing about things related to web development, music, and education. 
                    Projects, approaches and observations, things I have learned or consider important.
                </p>
            </div>

            </div>

        <svg class="wave-divider absolute bottom-0 left-0 w-full h-auto" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 1440 320" aria-hidden="true">
            <path d="m0 192 34.3-5.3C68.6 181 137 171 206 181.3 274.3 192 343 224 411 240c69 16 138 16 206 26.7 68.7 10.3 137 32.3 206 32 68.4.3 137-21.7 206-32 68.1-10.7 137-10.7 205-26.7 68.9-16 137-48 172-64l34-16V0H0Z"></path>
        </svg>
    </div>

    <div class="px-6 md:px-12 pb-24">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 mb-16">
            {page.data.map((p) => (
                <div class="post-card group relative p-6 md:p-8 rounded-lg border-4 border-theme-accent-bg transition-all duration-200 hover:border-theme-accent">
                    <a href={`/posts/${p.slug}/`} class="absolute inset-0 z-0" aria-label={`Read ${p.data.title}`}></a>
                    
                    <div class="relative z-10 flex flex-col h-full">
                        <PostPreview post={p} withDesc={true} />
                        
                        {p.data.tags && (
                            <div class="mt-auto pt-6 flex flex-wrap gap-2">
                                {p.data.tags.slice(0, 3).map((tag) => (
                                    <span class="text-xs font-bold uppercase tracking-wider text-theme-accent-text opacity-70">
                                        #{tag}
                                    </span>
                                ))}
                            </div>
                        )}
                    </div>
                </div>
            ))}
        </div>

        <div class="flex justify-center">
            <Pagination {...paginationProps} />
        </div>
    </div>

</PageLayout>

<style>
    /* COLOR PALETTE 
       Using Lene's "Bright Sun" (Yellow) theme logic mapped to your request 
    */
    :root {
        --theme-hero-bg: #F5CF38; /* Bright Sun */
        --theme-hero-text: #2e2e2e;
        --theme-wave: #f8f8f8; /* Matches default light bg */
        
        --theme-accent: #F5CF38;
        --theme-accent-bg: #e4e4e4; /* Gray border default */
        --theme-accent-text: #636363;
    }

    :global(.dark), :global([data-theme="dark"]) {
        --theme-hero-bg: #1f2c7f; /* Royal Blue Dark */
        --theme-hero-text: #ffffff;
        --theme-wave: #181818; /* Matches default dark bg */

        --theme-accent: #4f68cf; /* Royal Blue Subdued */
        --theme-accent-bg: #3a3a3a; /* Dark Gray border */
        --theme-accent-text: #aeaeae;
    }

    /* HERO STYLES */
    .full-width-hero {
        background-color: var(--theme-hero-bg);
        color: var(--theme-hero-text);
        /* Force break out of container if BaseLayout has restrictions */
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
    }

    .wave-divider {
        fill: var(--theme-wave); /* Makes the wave match the page background */
        height: auto;
        max-height: 120px;
    }

    /* CARD STYLES */
    .post-card {
        background-color: transparent; /* Or a slight offset color if desired */
    }
</style>