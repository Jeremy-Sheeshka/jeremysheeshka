---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
    // UPDATED: Set to 5 per request
    const MAX_POSTS_PER_PAGE = 5;
    const MAX_TAGS = 20; 
    const allPosts = await getAllPosts();
    const allPostsByDate = allPosts.sort(collectionDateSort);
    const uniqueTags = getUniqueTags(allPosts).slice(0, MAX_TAGS);
    
    return paginate(allPostsByDate, {
        pageSize: MAX_POSTS_PER_PAGE,
        props: { uniqueTags },
    });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<"post">>;
    uniqueTags: string[];
}

const { page, uniqueTags } = Astro.props;

const meta = {
    description: "Read my collection of posts about code, music, and technology",
    title: "Posts",
};

const paginationProps = {
    ...(page.url.prev && {
        prevUrl: {
            text: "← Previous Page",
            url: page.url.prev,
        },
    }),
    ...(page.url.next && {
        nextUrl: {
            text: "Next Page →",
            url: page.url.next,
        },
    }),
};

// Group the current page's posts by year
const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
    
    <section class="mb-12">
        <h1 class="title mb-6 text-4xl font-bold">Posts</h1>
        <p class="mb-6 max-w-2xl text-lg text-textColor/90">
            Here you'll find various articles and topics that interest me, mainly coding, music, and education. 
            If you'd like to be updated when new posts are released, there's a handy 
            <a href="/rss.xml" class="inline-flex items-center gap-1 font-semibold text-accent hover:underline underline-offset-4 decoration-dashed" target="_blank">
                RSS feed
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
            </a>
            to subscribe to.
        </p>
        <div class="divide w-full" aria-hidden="true"><span></span></div>
    </section>

    <div class="grid gap-y-16 lg:grid-cols-[3fr_1fr] lg:gap-x-12">
        
        <div>
            {
                descYearKeys.map((yearKey) => (
                    <section class="mb-12">
                        <h2 id={`year-${yearKey}`} class="title text-lg font-bold mb-6 text-accent">
                            {yearKey}
                        </h2>
                        <ul class="space-y-8 text-start">
                            {groupedByYear[yearKey]?.map((p) => (
                                <li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
                                    {/* We pass withDesc={true} to show the summary description */}
                                    <PostPreview post={p} withDesc={true} />
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
            <Pagination {...paginationProps} />
        </div>

        {
            !!uniqueTags.length && (
                <aside class="hidden lg:block">
                    <h2 class="title mb-4 flex items-center gap-2 text-lg font-bold">
                        <svg
                            aria-hidden="true"
                            class="h-5 w-5"
                            fill="none"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                            <path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />
                            <path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
                            <path d="M6 9h-.01" />
                        </svg>
                        Tags
                    </h2>
                    <ul class="flex flex-wrap gap-2">
                        {uniqueTags.map((tag) => (
                            <li>
                                <a 
                                    class="flex items-center justify-center rounded-lg bg-accent/10 px-3 py-1 text-sm text-accent hover:bg-accent hover:text-white transition-all duration-200" 
                                    href={`/tags/${tag}/`}
                                    aria-label={`View all posts with the tag: ${tag}`}
                                >
                                    {tag}
                                </a>
                            </li>
                        ))}
                    </ul>
                    <span class="mt-4 block text-end text-sm">
                        <a class="hover:text-accent transition-colors" href="/tags/">
                            View all →
                        </a>
                    </span>
                </aside>
            )
        }
    </div>
</PageLayout>

<style>
    /* Gradient Divider Logic */
    .divide {
        --divide-height: 2px;
        margin-top: 1rem;
        position: relative;
    }
    
    .divide span {
        background-image: linear-gradient(90deg, transparent 5%, rgba(var(--theme-accent), 0.4) 50%, transparent 95%);
        background-position: 50%;
        border: 0;
        display: block;
        height: var(--divide-height);
        max-width: 100%;
        position: relative;
    }

    .divide span:before,
    .divide span:after {
        content: "";
        display: block;
        height: var(--divide-height);
        position: absolute;
        width: 100%;
    }

    .divide span:before {
        background-image: linear-gradient(90deg, transparent, rgba(var(--theme-accent), 0.4) 50%, transparent);
        top: -4px; 
    }
    
    .divide span:after {
        background-image: linear-gradient(90deg, transparent 10%, rgba(var(--theme-accent), 0.4) 50%, transparent 90%);
        top: 4px;
    }
</style>