---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets"; 
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import blogImg from "@/assets/jeremy/clayman.jpg";

export const getStaticPaths = (async ({ paginate }) => {
    const MAX_POSTS_PER_PAGE = 10;
    const allPosts = await getAllPosts();
    const allPostsByDate = allPosts.sort(collectionDateSort);
    const uniqueTags = getUniqueTags(allPosts).slice(0, 7);
    const pinnedPosts = allPostsByDate.filter((p) => p.data.pinned).slice(0, 3);
    return paginate(allPostsByDate, {
        pageSize: MAX_POSTS_PER_PAGE,
        props: { uniqueTags, pinnedPosts },
    });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<"post">>;
    uniqueTags: string[];
    pinnedPosts: CollectionEntry<"post">[];
}

const { page, uniqueTags, pinnedPosts } = Astro.props;
const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

const meta = { title: "Posts", description: "Read my collection of posts" };
const paginationProps = {
    ...(page.url.prev && { prevUrl: { text: "← Previous", url: page.url.prev } }),
    ...(page.url.next && { nextUrl: { text: "Next →", url: page.url.next } }),
};
---

{/* THEME UPDATE: 
    Switched to 'cream' so the background respects Light/Dark mode. 
*/}
<PageLayout meta={meta} themeColor="cream">
    
    <div class="max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-20 text-global-text">
        
        {/* HERO SECTION 
            Unified layout: Text Left, Image Right. 
            Uses 'Bright Sun' yellow for accents.
        */}
        <div class="grid md:grid-cols-[1.5fr_1fr] gap-12 items-center mb-24">
            
            {/* COLUMN 1: Text */}
            <div class="order-2 md:order-1">
                {/* Title: Bright Sun Yellow 
                    Added 'drop-shadow-sm' to ensure readability on white backgrounds 
                    since yellow can be light.
                */}
                <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight text-[var(--theme-bright-sun)] drop-shadow-sm" style="font-family: var(--font-display);">
                    Blog
                </h1>
                <p class="text-xl md:text-2xl leading-relaxed opacity-90 text-pretty">
                    Thinking about web development, music, and education. Projects, approaches, and observations.
                </p>
            </div>

            {/* COLUMN 2: Image */}
            <div class="order-1 md:order-2 flex justify-center md:justify-end">
                <div class="relative group w-full max-w-sm">
                    {/* Decorative Offset Box: Bright Sun Yellow */}
                    <div class="absolute inset-0 bg-[var(--theme-bright-sun)] rounded-xl translate-x-3 translate-y-3 -z-10 group-hover:translate-x-2 group-hover:translate-y-2 transition-transform duration-300"></div>
                    <Image 
                        src={blogImg} 
                        alt="Jeremy Blog" 
                        class="w-full rounded-xl shadow-lg rotate-2 hover:rotate-0 transition-transform duration-500 object-cover aspect-square"
                        loading="eager"
                    />
                </div>
            </div>

        </div>

        {/* CONTENT SECTION 
            Maintained the existing Sidebar + Post List layout logic 
            but cleaned up the container spacing.
        */}
        <div class="grid sm:grid-cols-[3fr_1fr] sm:gap-x-12 sm:gap-y-16">
            
            {/* Main Column: Posts */}
            <div>
                {pinnedPosts.length > 0 && (
                    <section class="mb-16">
                        <h2 class="title mb-6 text-xl font-bold border-b border-dashed border-gray-300 pb-2">Pinned Posts</h2>
                        <ul class="space-y-4" role="list">
                            {pinnedPosts.map((p) => (
                                <li class="grid gap-1 sm:grid-cols-[auto_1fr]">
                                    <PostPreview post={p} />
                                </li>
                            ))}
                        </ul>
                    </section>
                )}
                
                {descYearKeys.map((yearKey) => (
                    <section class="mb-16">
                        <h2 id={`year-${yearKey}`} class="title text-lg font-bold text-[var(--theme-bright-sun)] drop-shadow-sm mb-6 flex items-center gap-2">
                            <span class="sr-only">Posts in</span>{yearKey}
                        </h2>
                        <ul class="space-y-8 text-start">
                            {groupedByYear[yearKey]?.map((p) => (
                                <li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
                                    <PostPreview post={p} />
                                </li>
                            ))}
                        </ul>
                    </section>
                ))}
                
                <Pagination {...paginationProps} />
            </div>

            {/* Sidebar: Tags */}
            {!!uniqueTags.length && (
                <aside class="space-y-4">
                    <h2 class="title mb-4 flex items-center gap-2 text-lg font-bold">Tags</h2>
                    <ul class="flex flex-wrap gap-2">
                        {uniqueTags.map((tag) => (
                            <li>
                                <a class="cactus-link flex items-center justify-center text-sm bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded-md hover:bg-[var(--theme-bright-sun)] hover:text-black transition-colors" href={`/tags/${tag}/`}>
                                    <span aria-hidden="true" class="opacity-50 mr-1">#</span>{tag}
                                </a>
                            </li>
                        ))}
                    </ul>
                    <span class="mt-4 block sm:text-end text-sm">
                        <a class="hover:text-[var(--theme-bright-sun)] transition-colors" href="/tags/">View all →</a>
                    </span>
                </aside>
            )}
        </div>

    </div>
</PageLayout>