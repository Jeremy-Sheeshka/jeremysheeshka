---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro"; // SWITCHED: Use Base instead of BlogPost layout

export const getStaticPaths = (async () => {
    const blogEntries = await getAllPosts();
    return blogEntries.map((post) => ({
        // FIX: Use 'post.slug' to match the links in your blog list (href={`/posts/${p.slug}/`})
        params: { slug: post.slug },
        props: { post },
    }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content } = await render(post);

const meta = {
    title: post.data.title,
    description: post.data.description,
    articleDate: post.data.publishDate.toISOString(),
};
---

{/* themeColor="cream" ensures consistency, and the Footer logic will detect this URL and make it transparent */}
<PageLayout meta={meta} themeColor="cream">
    
    <div class="max-w-3xl mx-auto px-6 md:px-12 py-12 md:py-20">
        
        {/* POST HEADER: Title & Date */}
        <header class="mb-10 text-center">
            <h1 class="text-3xl md:text-5xl font-bold mb-4 text-black dark:text-white" style="font-family: var(--font-display);">
                {post.data.title}
            </h1>
            <div class="opacity-60 text-sm font-bold uppercase tracking-wider text-black dark:text-white">
                {post.data.publishDate.toLocaleDateString("en-CA", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                })} 
                
                {post.data.tags && (
                    <span class="ml-2">
                        • {post.data.tags.map((tag) => <span class="ml-1">#{tag}</span>)}
                    </span>
                )}
            </div>
        </header>

        {/* POST CONTENT */}
        <div class="prose prose-lg prose-cactus max-w-none text-black dark:text-white prose-headings:font-semibold prose-img:rounded-xl">
            <Content />
        </div>
        
        {/* BACK BUTTON */}
        <div class="mt-16 pt-8 border-t border-dashed border-gray-200 dark:border-gray-700 text-center">
            <a 
                href="/posts" 
                class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest opacity-60 hover:opacity-100 hover:text-[var(--theme-bright-sun)] transition-all text-black dark:text-white"
            >
                ← Back to Blog
            </a>
        </div>

    </div>
</PageLayout>