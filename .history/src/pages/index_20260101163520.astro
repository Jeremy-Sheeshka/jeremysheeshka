---
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import homeImg from "@/assets/jeremy/sheeshka1400w.jpg";
import PostPreview from "@/components/blog/PostPreview.astro";

const roles = ["Hello there!"];
const cta = { email: "hello@jeremysheeshka.ca" };

const MAX_POSTS = 5; 
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);
---

<PageLayout meta={{ title: "Home" }} themeColor="cream">
    
    <div class="w-full relative z-10 overflow-hidden">
        <div class="max-w-6xl mx-auto px-6 md:px-12 py-8 md:py-16 flex flex-col md:grid md:grid-cols-[1.5fr_1fr] md:grid-rows-[auto_auto] gap-x-12 gap-y-6 items-start relative z-10">
            
            {/* 1. HEADING: "Hello there!" */}
            <h1 class="text-3xl sm:text-6xl font-bold leading-[1.1] tracking-tight order-1 md:col-start-1 md:row-start-1" style="color: inherit;">
                {roles.map((role) => (
                    <span class="block">{role}</span>
                ))}
            </h1>

            {/* 2. IMAGE */}
            <div class="order-2 md:col-start-2 md:row-start-1 md:row-span-2 flex justify-center md:justify-end w-full">
                {/* Image logic preserved: Mobile/Tablet = Landscape, Desktop = Portrait */}
                <Image 
                    src={homeImg} 
                    alt="Jeremy Sheeshka" 
                    class="lene-filter w-full rounded-xl shadow-2xl object-cover aspect-[3/2] md:aspect-[585/371] lg:aspect-[4/5] lg:max-w-xl"
                    loading="eager"
                />
            </div>

            {/* 3. BIO TEXT SECTION (Split into two styles) */}
            <div class="order-3 md:col-start-1 md:row-start-2" style="color: inherit;">
                
                {/* Part A: "Musician Educator..." (Large styling) */}
            <p class="text-xl md:text-2xl max-w-xl font-medium leading-tight opacity-90 text-pretty">
                     I'm a musician, educator, technologist who occasionally writes. Inspired by jazz guitar, education, and technology, I build tools and experiences to help design understandings.
            </p>             
            </div>

        </div>
    </div>

    <div class="w-full" style="color: inherit;">
        <div class="max-w-3xl mx-auto px-6 md:px-12 py-16">
            
            <article class="relative mb-20">
                <div aria-hidden="true" class="triangle"></div>
                
                <h2 class="text-xl font-bold mb-8 text-stone-500 dark:text-zinc-500 uppercase tracking-wide">Some recent articles</h2>

                <ul class="space-y-4">
                    {latestPosts.map((p) => (
                        <li class="group relative">
                            <div class="relative transition-all duration-300 group-hover:translate-x-1 border-2 border-transparent hover:border-[var(--theme-bright-sun)]/50 hover:dark:border-[var(--theme-bright-sun)] p-6 rounded-2xl bg-transparent hover:bg-stone-100/60 dark:bg-zinc-900/50 hover:dark:bg-zinc-900/80 text-zinc-900 dark:text-white">
                                <a href={`/posts/${p.slug}/`} class="absolute inset-0 z-0" aria-label={`Read ${p.data.title}`}></a>
                                <div class="relative z-10 pointer-events-none">
                                    <PostPreview post={p} />
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>

                <div class="mt-12">
                    <a href="/posts/" class="inline-flex items-center gap-2 font-bold hover:text-accent transition-colors">
                        See all posts
                        <svg fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true" viewBox="0 0 26 24" class="w-5 h-5"><path d="M23 12H2" class="arrow-tail" pathLength="100"></path><path d="m17 6 7 6-7 6"></path></svg>
                    </a>
                </div>
            </article>

            <article class="border-t border-dashed border-current pt-10 opacity-80">
                <h2 class="text-2xl font-bold mb-4" style="color: inherit;">Get in touch</h2>
                <p class="text-lg">
                    For enquiries please email 
                    <a href={`mailto:${cta.email}`} class="font-bold border-b-2 border-accent hover:text-accent transition-colors ml-1" style="color: inherit;">
                        {cta.email}
                    </a>
                </p>
            </article>

        </div>
    </div>

</PageLayout>

<style>
    :global(main time), :global(.date) {
        color: var(--theme-bright-sun) !important;
        font-weight: bold;
        opacity: 1 !important;
    }

    .triangle {
        display: none; 
        background-image: linear-gradient(rgba(244, 162, 97, 0.4), rgba(231, 111, 81, 0.4), rgba(157, 78, 221, 0.4));
        filter: blur(20px); height: 150px; width: 150px; position: absolute; right: -20px; top: 0; z-index: 0;
        -webkit-mask: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 157 136'%3E%3Cpath fill='currentColor' fill-rule='evenodd' d='m10.395 17.154 6.351 11L32.794.359H20.092zM12.01.359H.699l5.655 9.795zm15.13 45.795-6.351-11L40.876.359h12.702l-26.44 45.795Zm4.04 7 6.352 11L74.363.359H61.66zm16.744 29-6.35-11L82.445.359h12.701zm4.041 7 6.351 11L115.932.359H103.23L51.964 89.154Zm16.744 29-6.351-11L124.015.359h12.701L68.708 118.154Zm4.041 7 5.892 10.205 77.942-135H144.8z' clip-rule='evenodd'/%3E%3C/svg%3E") no-repeat center / contain;
        mask: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='k://www.w3.org/2000/svg' fill='none' viewBox='0 0 157 136'%3E%3Cpath fill='currentColor' fill-rule='evenodd' d='m10.395 17.154 6.351 11L32.794.359H20.092zM12.01.359H.699l5.655 9.795zm15.13 45.795-6.351-11L40.876.359h12.702l-26.44 45.795Zm4.04 7 6.352 11L74.363.359H61.66zm16.744 29-6.35-11L82.445.359h12.701zm4.041 7 6.351 11L115.932.359H103.23L51.964 89.154Zm16.744 29-6.351-11L124.015.359h12.701L68.708 118.154Zm4.041 7 5.892 10.205 77.942-135H144.8z' clip-rule='evenodd'/%3E%3C/svg%3E") no-repeat center / contain;
    }
    @media(min-width: 768px) { .triangle { display: block; } }
</style>