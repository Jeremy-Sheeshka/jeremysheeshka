---
// File: src/pages/search.astro
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts } from "@/data/post";

// 1. Fetch all posts during build time to pass to the client
const allPosts = await getAllPosts();

const meta = {
	title: "Search Results",
	description: "Search results for the blog",
};
---

<PageLayout meta={meta}>
	<div class="max-w-3xl mx-auto px-6 py-12 min-h-[60vh]">
		
        <h1 class="text-4xl font-bold mb-8 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            Search Results
        </h1>
		
		{/* Search Input */}
		<div class="relative mb-12">
			<input 
				type="text" 
				id="search-input"
				placeholder="Search again..." 
                /* UPDATED: Lighter background (white) and softer border for Light Theme */
				class="w-full px-6 py-4 text-lg border-2 border-zinc-200 rounded-2xl focus:border-zinc-300 outline-none bg-white dark:bg-zinc-900 dark:border-zinc-800 transition-colors"
			/>
		</div>

        {/* Results Container */}
		<div id="search-results" class="space-y-4">
			<div class="text-stone-500 dark:text-zinc-500 animate-pulse">Searching...</div>
		</div>

        {/* Templates for the Javascript to use (Hidden) */}
        <template id="result-template">
            {/* UPDATED: Subdued hover effects (Grey bg/border) instead of Theme Color */}
            <a href="" class="block group p-6 rounded-2xl border-2 border-transparent hover:border-zinc-200 hover:bg-zinc-50 dark:hover:border-zinc-700 dark:hover:bg-zinc-900 transition-all">
                <h2 class="text-2xl font-bold text-zinc-900 dark:text-white group-hover:underline decoration-2 underline-offset-2 mb-2 result-title"></h2>
                <p class="text-stone-600 dark:text-zinc-400 result-desc line-clamp-2"></p>
                {/* UPDATED: Date is now a subtle grey instead of bright theme color */}
                <div class="mt-4 text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 result-date"></div>
            </a>
        </template>

	</div>
</PageLayout>

{/* Client-Side Search Logic */}
<script is:inline define:vars={{ posts: allPosts }}>
    const searchInput = document.getElementById("search-input");
    const resultsContainer = document.getElementById("search-results");
    const template = document.getElementById("result-template");

    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get("q") || "";

    searchInput.value = query;

    function performSearch(searchQuery) {
        if (!searchQuery) {
            resultsContainer.innerHTML = '<p class="text-stone-500 italic">Enter a term to search...</p>';
            return;
        }

        const lowerQuery = searchQuery.toLowerCase();
        const filtered = posts.filter(post => {
            const title = post.data.title.toLowerCase();
            const desc = (post.data.description || "").toLowerCase();
            return title.includes(lowerQuery) || desc.includes(lowerQuery);
        });

        resultsContainer.innerHTML = "";

        if (filtered.length === 0) {
            resultsContainer.innerHTML = `<p class="text-stone-500 dark:text-zinc-500 text-lg">No results found for "<strong>${searchQuery}</strong>".</p>`;
            return;
        }

        filtered.forEach(post => {
            const clone = template.content.cloneNode(true);
            const link = clone.querySelector("a");
            link.href = `/posts/${post.id}/`;
            
            clone.querySelector(".result-title").textContent = post.data.title;
            clone.querySelector(".result-desc").textContent = post.data.description;
            
            const dateObj = new Date(post.data.updatedDate || post.data.publishDate);
            clone.querySelector(".result-date").textContent = dateObj.toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric'
            });

            resultsContainer.appendChild(clone);
        });
    }

    performSearch(query);

    searchInput.addEventListener("input", (e) => {
        const newUrl = new URL(window.location);
        newUrl.searchParams.set("q", e.target.value);
        window.history.pushState({}, "", newUrl);
        performSearch(e.target.value);
    });
</script>