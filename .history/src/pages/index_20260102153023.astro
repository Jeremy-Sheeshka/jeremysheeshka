---
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/utils";

// 1. Get all posts and their tag counts
const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

// 2. Logic for the "Wordle" sizing
const counts = allTags.map(([_, count]) => count);
const minCount = Math.min(...counts);
const maxCount = Math.max(...counts);

// You can adjust these numbers to make the tags bigger or smaller
const minSize = 1.2; // rem
const maxSize = 3.5; // rem

const meta = { 
    title: "All Tags",
    description: "Topics and tags from across the blog" 
};
---

<PageLayout meta={meta} themeColor="cream">
    <div class="w-full max-w-3xl mx-auto px-6 md:px-12 py-16">
        
        <header class="mb-12">
            <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-4">Tags</h1>
            <p class="text-stone-500 dark:text-zinc-500 italic">
                A visual cloud of topics I've written about.
            </p>
        </header>

        {/* THE TAG CLOUD */}
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-6 py-10">
            {allTags.map(([tag, count]) => {
                // Calculate size based on usage frequency
                const size = maxCount === minCount 
                    ? minSize 
                    : minSize + ((count - minCount) * (maxSize - minSize)) / (maxCount - minCount);

                return (
                    <a
                        href={`/tags/${tag}/`}
                        class="transition-all duration-300 hover:text-[var(--theme-bright-sun)] hover:scale-110"
                        style={`font-size: ${size}rem; opacity: ${0.4 + (count / maxCount) * 0.6};`}
                    >
                        <span class="opacity-50 text-[0.7em]">#</span>{tag}
                    </a>
                );
            })}
        </div>

        {/* FOOTER NAVIGATION */}
        <div class="mt-20 border-t border-dashed border-stone-300 dark:border-zinc-700 pt-10">
            <a href="/" class="inline-flex items-center gap-2 font-bold hover:text-[var(--theme-bright-sun)] transition-colors">
                <svg fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 26 24" class="w-5 h-5 rotate-180">
                    <path d="M23 12H2"></path>
                    <path d="m17 6 7 6-7 6"></path>
                </svg>
                Back to home
            </a>
        </div>
    </div>
</PageLayout>

<style>
    /* This makes the tags feel more "Wordle-like" by varying the font weights */
    a {
        font-weight: 500;
        text-wrap: balance;
        display: inline-block;
    }
    
    a:nth-child(even) {
        font-weight: 700;
    }
</style>