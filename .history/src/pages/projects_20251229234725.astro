---
import { getCollection } from "astro:content";
import { Image } from "astro:assets"; 
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import Note from "@/components/note/Note.astro";
import projectImg from "@/assets/jeremy/desktop.jpg"; 

const allProjects = await getCollection("note");
const sortedProjects = allProjects.sort(collectionDateSort);

const meta = {
    title: "Projects",
    description: "A collection of my projects and ideas.",
};
---

<PageLayout meta={meta} themeColor="royal-blue">
    
    <div class="max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-20 text-global-text">
        
        {/* HERO SECTION: Intro + Image 
            Unified layout similar to About page.
        */}
        <div class="grid md:grid-cols-[1.5fr_1fr] gap-12 items-center mb-24">
            
            {/* COLUMN 1: Text */}
            <div class="order-2 md:order-1">
                <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight text-[var(--theme-royal-blue)]" style="font-family: var(--font-display);">
                    Projects
                </h1>
                <p class="text-xl md:text-2xl leading-relaxed opacity-90 text-pretty">
                    Here are some of the things I've been working on. A mix of code, music, and experiments.
                </p>
            </div>

            {/* COLUMN 2: Image */}
            <div class="order-1 md:order-2 flex justify-center md:justify-end">
                <div class="relative group w-full max-w-sm">
                    {/* Decorative Offset Box (Royal Blue) */}
                    <div class="absolute inset-0 bg-[var(--theme-royal-blue)] rounded-xl translate-x-3 translate-y-3 -z-10 group-hover:translate-x-2 group-hover:translate-y-2 transition-transform duration-300"></div>
                    <Image 
                        src={projectImg} 
                        alt="Jeremy's Desktop" 
                        class="w-full rounded-xl shadow-lg rotate-0 hover:-rotate-1 transition-transform duration-500 object-cover aspect-square"
                        loading="eager"
                    />
                </div>
            </div>

        </div>

        {/* PROJECTS GRID SECTION 
            Switched from a vertical list to a 2-column Grid for a "Card" look.
        */}
        {sortedProjects.length === 0 ? (
            <div class="text-center py-20 border-2 border-dashed border-gray-200 rounded-xl">
                <p class="text-xl opacity-60">Projects coming soon...</p>
            </div>
        ) : (
            <ul class="grid md:grid-cols-2 gap-6">
                {sortedProjects.map((project) => (
                    /* CARD CONTAINER 
                       We treat the <li> as the card itself. 
                       - border: defines the box
                       - hover:shadow-lg: lifts it up interaction
                       - transition: smooths the animation
                    */
                    <li class="flex flex-col h-full border border-gray-200 dark:border-gray-700 rounded-2xl p-6 hover:shadow-xl hover:border-[var(--theme-royal-blue)] transition-all duration-300 bg-white/50 dark:bg-transparent group">
                        
                        {/* We use 'group-hover' logic here if we want the title to change color on hover */}
                        <div class="group-hover:text-[var(--theme-royal-blue)] transition-colors duration-300">
                             {/* I assumed Note renders a title/link. 
                                The styles above will apply to the container around the Note.
                             */}
                             <Note note={project} as="h3" /> 
                        </div>
                        
                    </li>
                ))}
            </ul>
        )}

    </div>

</PageLayout>2