---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/Base.astro";
import projectImg from "@/assets/jeremy/sheeshka1400w.jpg"; // specific project image if you have one

const meta = {
    title: "Projects",
    description: "A selection of my work in web development, music, and education.",
};

const projects = [
    {
        title: "Project One",
        desc: "A brief description of this project, the technologies used, and the problem it solved.",
        href: "#",
        tags: ["Astro", "Tailwind", "TypeScript"],
    },
    {
        title: "Project Two",
        desc: "Another cool project showcasing different skills or a different area of focus.",
        href: "#",
        tags: ["Music", "Education", "Vue.js"],
    },
    {
        title: "Project Three",
        desc: "Building tools for creative expression and understanding through technology.",
        href: "#",
        tags: ["D3.js", "Data Viz"],
    },
];
---

<PageLayout meta={meta} themeColor="royal-blue">
    
    <div class="w-full relative z-10">
        <div class="max-w-5xl mx-auto px-6 md:px-12 py-12 md:py-20 grid md:grid-cols-2 gap-8 items-center">
            
            <div>
                <h1 class="font-bold text-5xl md:text-7xl mb-6 tracking-tight" style="font-family: var(--font-display); color: inherit;">
                    Projects
                </h1>
                <p class="text-xl md:text-2xl leading-relaxed text-pretty opacity-90" style="color: inherit;">
                    A collection of experiments, tools, and creative works.
                </p>
            </div>

            <div class="flex justify-center md:justify-end">
                <Image 
                    src={projectImg} 
                    alt="Projects" 
                    class="lene-filter w-full max-w-sm md:max-w-xl rounded-xl shadow-lg rotate-2 hover:rotate-0 transition-transform duration-500"
                    loading="eager"
                />
            </div>

        </div>
    </div>

    <div class="max-w-3xl mx-auto px-6 md:px-12 pb-24 mt-12">
        <section>
            <ul class="space-y-12">
                {projects.map((project) => (
                    <li class="flex flex-col gap-4 border-b border-current/20 pb-12 last:border-none">
                        <div class="flex flex-col gap-2">
                            <h2 class="text-2xl font-bold hover:text-accent transition-colors">
                                <a href={project.href} class="underline-offset-4 decoration-2 hover:underline" style="color: inherit;">
                                    {project.title}
                                </a>
                            </h2>
                            <div class="flex gap-2 flex-wrap">
                                {project.tags.map(tag => (
                                    <span class="text-xs border border-current/40 px-2 py-1 rounded-full opacity-80">{tag}</span>
                                ))}
                            </div>
                        </div>
                        <p class="text-lg opacity-80 max-w-xl leading-relaxed">
                            {project.desc}
                        </p>
                    </li>
                ))}
            </ul>
        </section>
    </div>

</PageLayout>