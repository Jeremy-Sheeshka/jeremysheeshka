---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/Base.astro";
import aboutImg from "@/assets/jeremy/clayman.jpg";

const meta = {
    title: "About Me",
    description: "I'm a musician and educator based out of Prince Rupert, B.C. Canada.",
};

// I cleaned up the typo in the description above!

const faqs = [
    {
        question: "Do you teach guitar lessons privately?",
        answer: "Yes. My approach is unique and free of pre-determined lesson plans. I approach each student thoughtfully with personalized content that aligns with their own goals.",
    },
    {
        question: "How long have you been studying guitar?",
        answer: "Since 2005. It's the eternal repetition of learning and applying knowledge to build something. I'm still learning to this day and will be for my lifetime.",
    },
];
---

<PageLayout meta={meta} themeColor="cream">
    
    <div class="max-w-5xl mx-auto px-6 md:px-12 py-12 md:py-20 text-global-text">
        
        {/* TOP SECTION: Unified Hero (Image + Bio) */}
        <div class="grid md:grid-cols-[2fr_3fr] gap-12 items-start mb-24">
            
            {/* COLUMN 1: The Image */}
            <div class="relative group">
                {/* A decorative border offset behind the image for a 'modern' feel */}
                <div class="absolute inset-0 bg-[var(--theme-cinnabar)] rounded-xl translate-x-3 translate-y-3 -z-10 group-hover:translate-x-2 group-hover:translate-y-2 transition-transform duration-300"></div>
                <Image 
                    src={aboutImg} 
                    alt="Jeremy Clayman" 
                    class="lene-filter w-full rounded-xl shadow-lg object-cover aspect-[4/5]"
                    loading="eager"
                />
            </div>

            {/* COLUMN 2: The Story */}
            <div class="flex flex-col justify-center h-full space-y-6">
                <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-[var(--theme-cinnabar)]" style="font-family: var(--font-display);">
                    About Me
                </h1>
                
                <div class="prose prose-lg prose-cactus max-w-none leading-relaxed opacity-90">
                    <p class="text-xl font-medium text-global-text">
                        I'm a jazz guitarist and educator based out of Prince Rupert, B.C. Canada.
                    </p>
                    <p>
                        Since 2016, I have been working as a K-12 Music Educator specializing in secondary school music education and jazz guitar. My music aims to pay tribute to both traditional idioms and emerging trends inspired by musical innovations.
                    </p>
                    <p>
                        I seek to create music that explores and draws upon relationships between people and places, improvisation and composition, as well as the familiar and abstract.
                    </p>
                    <p>
                        As an educator, I believe the best way to reinforce understanding is through sharing. My work strives to inspire new understandings for
                        <sparkly-text class="pl-1 inline-block font-bold text-[var(--theme-cinnabar)]" number-of-sparkles="5" style="--sparkly-text-color: var(--theme-cinnabar)">
                            creative minds everywhere.
                        </sparkly-text>
                    </p>
                </div>
            </div>
        </div>

        {/* BOTTOM SECTION: Info Grid (FAQ + Contact) */}
        <div class="grid md:grid-cols-2 gap-12 pt-12 border-t border-dashed border-gray-300">
            
            {/* FAQ Area */}
            <div>
                <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
                    <span class="text-[var(--theme-cinnabar)]">?</span> FAQ
                </h2>
                <dl class="space-y-8">
                    {faqs.map((item) => (
                        <div>
                            <dt class="font-bold text-lg mb-2">{item.question}</dt>
                            <dd class="opacity-80 leading-relaxed text-sm">{item.answer}</dd>
                        </div>
                    ))}
                </dl>
            </div>

            {/* Contact Area */}
            <div class="bg-[var(--theme-cinnabar)] text-white p-8 rounded-2xl shadow-lg flex flex-col justify-center items-start">
                <span class="text-4xl mb-4">👋</span>
                <h2 class="text-3xl font-bold mb-4">Let's talk!</h2>
                <p class="text-lg opacity-90 mb-8 leading-relaxed">
                    Whether you have a project in mind, an opportunity to share, or just want to connect.
                </p>
                <a href="mailto:hello@jeremysheeshka.ca" class="inline-block bg-white text-[var(--theme-cinnabar)] px-6 py-3 rounded-lg font-bold hover:bg-opacity-90 transition-all">
                    hello@jeremysheeshka.ca
                </a>
            </div>

        </div>
    </div>
</PageLayout>

<script>
  import "@stefanjudis/sparkly-text";
</script>

{/* Removed the <style> block completely. 
    Since we removed the red header box, we don't need to force the nav links to be white anymore. 
    They will naturally inherit your site's default theme colors. 
*/}