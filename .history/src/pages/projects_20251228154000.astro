---
import { getCollection } from "astro:content";
import { Image } from "astro:assets"; // Import Image
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import Note from "@/components/note/Note.astro";
import projectImg from "@/assets/jeremy/desktop.jpg"; // Projects Image

const allProjects = await getCollection("note");
const sortedProjects = allProjects.sort(collectionDateSort);

const meta = {
    title: "Projects",
    description: "A collection of my projects and ideas.",
};
---

<PageLayout meta={meta} themeColor="green">
    
    <div class="w-full bg-theme-green relative z-10">
        <div class="max-w-5xl mx-auto px-6 md:px-12 py-12 md:py-20 grid md:grid-cols-2 gap-8 items-center">
            
            <div>
                <h1 class="font-bold text-5xl md:text-7xl mb-6 tracking-tight text-white" style="font-family: var(--font-display);">
                    Projects
                </h1>
                <p class="text-xl md:text-2xl leading-relaxed text-white/90 text-pretty">
                    Here are some of the things I've been working on. A mix of code, music, and experiments.
                </p>
            </div>

            <div class="flex justify-center md:justify-end">
                <Image 
                    src={projectImg} 
                    alt="Jeremy's Desktop" 
                    class="rounded-xl shadow-lg -rotate-1 hover:rotate-0 transition-transform duration-500 w-full max-w-sm"
                    loading="eager"
                />
            </div>

        </div>
    </div>

    <div class="max-w-3xl mx-auto px-6 md:px-12 py-12">
        {sortedProjects.length === 0 ? (
            <p class="text-lg opacity-80">Coming soon...</p>
        ) : (
            <ul class="space-y-8">
                {sortedProjects.map((project) => (
                    <li class="border-b border-dashed border-textColor/20 pb-8 last:border-0">
                        <Note note={project} as="h2" /> 
                    </li>
                ))}
            </ul>
        )}
    </div>

</PageLayout>