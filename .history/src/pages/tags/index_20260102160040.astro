---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const counts = allTags.map(([_, val]) => val);
const maxCount = Math.max(...counts);
const minCount = Math.min(...counts);

const meta = {
    description: "A clustered wordle cloud of my blog topics",
    title: "Topics",
};
---

<PageLayout meta={meta}>
    <div class="flex flex-col items-center justify-center min-h-[85vh] w-full px-6 overflow-hidden relative">
        
        <div class="flex-grow flex items-center justify-center w-full">
            <ul 
                id="wordle-cloud"
                class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 max-w-5xl mx-auto relative opacity-0 transition-opacity duration-700"
            >
                {
                    allTags.map(([tag, val]) => {
                        const frequency = (val - minCount) / (maxCount - minCount || 1);
                        const size = 1.1 + (frequency * 2.5); 

                        return (
                            <li 
                                class="tag-item flex items-center justify-center transition-all duration-300"
                                data-weight={val}
                            >
                                <a
                                    class="cactus-link font-bold tracking-tighter text-center leading-none select-none hover:scale-110 transition-transform inline-block"
                                    href={`/tags/${tag}/`}
                                    style={`
                                        font-size: ${size}rem; 
                                        opacity: ${0.6 + (frequency * 0.4)};
                                        color: ${val === maxCount ? 'var(--theme-accent)' : 'inherit'};
                                    `}
                                >
                                    {tag}
                                </a>
                            </li>
                        );
                    })
                }
            </ul>
        </div>

        <div class="mt-12 mb-8 animate-in" style="--delay: 800ms">
            <a 
                href="/posts/" 
                class="group inline-flex items-center gap-x-2 text-sm font-medium opacity-60 hover:opacity-100 transition-all"
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform group-hover:-translate-x-1">
                    <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
                <span>Back to Blog</span>
            </a>
        </div>

    </div>
</PageLayout>

<script>
    function initWordle() {
        const cloud = document.getElementById('wordle-cloud');
        if (!cloud) return;

        const items = Array.from(cloud.querySelectorAll('.tag-item')) as HTMLElement[];
        
        // Shuffle tags
        const shuffled = items.sort(() => Math.random() - 0.5);
        shuffled.forEach((item) => {
            const link = item.querySelector('a');
            if (link) {
                const rotation = Math.random() * 4 - 2; // Subtle -2 to 2 degrees
                link.style.transform = `rotate(${rotation}deg)`;
            }
            cloud.appendChild(item);
        });

        // Trigger visibility
        requestAnimationFrame(() => {
            cloud.classList.remove('opacity-0');
        });
    }

    // Runs on initial load
    initWordle();
    // Runs after Astro view transitions
    document.addEventListener("astro:after-swap", initWordle);
</script>

<style>
    #wordle-cloud { list-style: none; padding: 0; }

    /* Only blur other items when the cloud is hovered */
    #wordle-cloud:hover .tag-item:not(:hover) {
        opacity: 0.3;
        filter: grayscale(1) blur(1px);
    }

    .animate-in {
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
        animation-delay: var(--delay, 0ms);
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>