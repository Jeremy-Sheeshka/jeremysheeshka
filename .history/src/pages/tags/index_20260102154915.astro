---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const counts = allTags.map(([_, val]) => val);
const maxCount = Math.max(...counts);
const minCount = Math.min(...counts);

const meta = {
	description: "An interactive, randomized wordle cloud of my blog topics",
	title: "Topics",
};
---

<PageLayout meta={meta}>
	<div class="flex flex-col items-center justify-center min-h-[80vh] w-full px-6 overflow-hidden">
		
		<ul 
			id="wordle-cloud"
			class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 max-w-5xl mx-auto relative opacity-0 transition-opacity duration-1000"
		>
			{
				allTags.map(([tag, val]) => {
					const frequency = (val - minCount) / (maxCount - minCount || 1);
					// Base size calculation
					const size = 1 + (frequency * 3.5); 

					return (
						<li 
							class="tag-item flex items-center justify-center p-2 transition-all duration-500"
							data-weight={val}
						>
							<a
								class="cactus-link font-bold tracking-tighter text-center leading-none select-none hover:scale-125 transition-transform"
								href={`/tags/${tag}/`}
								style={`
									font-size: ${size}rem; 
									opacity: ${0.3 + (frequency * 0.7)};
									color: ${val === maxCount ? 'var(--theme-accent)' : frequency > 0.5 ? 'var(--theme-link)' : 'inherit'};
								`}
							>
								{tag}
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</PageLayout>

<script>
	// This code runs in the user's browser
	function initWordle() {
		const cloud = document.getElementById('wordle-cloud');
		const items = Array.from(document.querySelectorAll('.tag-item')) as HTMLElement[];
		
		if (!cloud) return;

		// 1. Shuffle the items client-side
		const shuffled = items.sort(() => Math.random() - 0.5);
		
		// 2. Apply random orientations and subtle rotations
		shuffled.forEach((item) => {
			const link = item.querySelector('a');
			if (!link) return;

			// 20% chance of being vertical
			if (Math.random() > 0.8 && item.dataset.weight !== "8") {
				link.style.writingMode = 'vertical-rl';
			}

			// Random rotation between -8 and 8 degrees
			const rotation = Math.random() * 16 - 8;
			link.style.transform = `rotate(${rotation}deg)`;
			
			// Re-inject into the DOM in the new order
			cloud.appendChild(item);
		});

		// 3. Fade in the cloud once organized
		cloud.classList.remove('opacity-0');
	}

	// Initialize on page load and after Astro transitions
	initWordle();
	document.addEventListener("astro:after-swap", initWordle);
</script>

<style>
	#wordle-cloud {
		list-style: none;
		padding: 0;
	}

	.tag-item:hover ~ .tag-item {
		opacity: 0.3;
		filter: blur(1px);
	}

	a {
		display: inline-block;
		text-decoration: none !important;
		white-space: nowrap;
	}
</style>