---
// File: src/pages/tags/[tag].astro
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import PostPreview from "@/components/blog/PostPreview.astro";

export async function getStaticPaths() {
	const allPosts = await getAllPosts();
	const allTags = new Set();
	
    // Collect all unique tags
	allPosts.map((post) => {
		post.data.tags?.map((tag) => allTags.add(tag.toLowerCase()));
	});

	return Array.from(allTags).map((tag) => {
		const filterPosts = allPosts.filter((post) => 
            post.data.tags?.some((t) => t.toLowerCase() === tag)
        );
		return {
			params: { tag },
			props: { posts: filterPosts },
		};
	});
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const meta = {
	title: `Posts about ${tag}`,
	description: `All posts tagged with ${tag}`,
};
---

<PageLayout meta={meta}>
    <h1 class="mb-6 flex items-center gap-3 text-3xl font-bold text-zinc-900 dark:text-white">
		Posts about <span class="text-[var(--theme-bright-sun)]">{tag}</span>
	</h1>

	<section aria-label="Blog post list">
		<ul class="space-y-8">
			{
				posts.map((p) => (
					<li class="flex flex-col flex-wrap gap-2 sm:flex-row [&_q]:basis-full">
						<PostPreview post={p} as="h2" />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>