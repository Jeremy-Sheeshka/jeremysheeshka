---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const counts = allTags.map(([_, val]) => val);
const minCount = Math.min(...counts);
const maxCount = Math.max(...counts);

// Sizing limits
const minSize = 1.2; 
const maxSize = 4.5; 

const meta = {
	description: "A visual wordle cloud of all blog topics",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<div class="flex flex-col items-center justify-center min-h-[70vh] w-full px-6">
		<h1 class="title mb-16 opacity-50">Topic Cloud</h1>
		
		<ul class="tag-cloud-wrapper flex flex-wrap items-center justify-center gap-x-12 gap-y-10 max-w-5xl mx-auto py-10">
			{
				allTags.map(([tag, val]) => {
					// 1. Calculate Size
					const size = maxCount === minCount 
						? minSize 
						: minSize + ((val - minCount) * (maxSize - minSize)) / (maxCount - minCount);

					const frequency = (val - minCount) / (maxCount - minCount || 1);

					// 2. Logic for Vertical vs Horizontal
					// About 25% of tags will be vertical
					const isVertical = Math.random() > 0.75;
					
					// 3. Random subtle rotation (-5 to 5 degrees)
					const rotation = (Math.random() * 10 - 5).toFixed(2);

					return (
						<li class={`flex items-center justify-center transition-transform hover:scale-110 active:scale-95 ${isVertical ? 'vertical-tag' : ''}`}>
							<a
								class="cactus-link font-bold tracking-tight text-center leading-none"
								href={`/tags/${tag}/`}
								title={`${val} posts`}
								style={`
									font-size: ${size}rem; 
									opacity: ${0.4 + (frequency * 0.6)};
									transform: rotate(${rotation}deg);
									color: ${frequency > 0.7 ? 'var(--theme-accent)' : frequency > 0.4 ? 'var(--theme-link)' : 'inherit'};
								`}
							>
								{tag}
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</PageLayout>

<style>
	.tag-cloud-wrapper {
		list-style: none;
		padding: 0;
	}

	/* Force the list items to be flexible containers */
	li {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 50px;
		min-height: 50px;
	}

	/* Vertical Text Magic */
	.vertical-tag a {
		writing-mode: vertical-rl;
		text-orientation: mixed;
		margin: 0 1rem;
	}

	a {
		display: inline-block;
		text-decoration: none !important;
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		white-space: nowrap;
	}

	/* Optional: Removes the # for a cleaner Wordle look */
	a::before {
		content: "";
	}
</style>