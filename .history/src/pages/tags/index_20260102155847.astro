---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const counts = allTags.map(([_, val]) => val);
const maxCount = Math.max(...counts);
const minCount = Math.min(...counts);

const meta = {
	description: "A clustered wordle cloud of my blog topics",
	title: "Topics",
};
---

<PageLayout meta={meta}>
	<div class="flex flex-col items-center justify-center min-h-[85vh] w-full px-6 overflow-hidden relative">
		
		
		<ul 
			id="wordle-cloud"
			class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 max-w-4xl mx-auto relative opacity-0 transition-opacity duration-1000"
		>
			{
				allTags.map(([tag, val]) => {
					const frequency = (val - minCount) / (maxCount - minCount || 1);
					// Size range: 1.1rem to 3.8rem
					const size = 1.1 + (frequency * 2.7); 

					return (
						<li 
							class="tag-item flex items-center justify-center p-1 transition-all duration-500"
							data-weight={val}
						>
							<a
								class="cactus-link font-bold tracking-tighter text-center leading-[0.85] select-none hover:scale-110 transition-transform"
								href={`/tags/${tag}/`}
								style={`
									font-size: ${size}rem; 
									opacity: ${0.5 + (frequency * 0.5)};
									color: ${val === maxCount ? 'var(--theme-accent)' : 'inherit'};
								`}
							>
								{tag}
							</a>
						</li>
					);
				})
			}
		</ul>

		<div class="mt-16 animate-in" style="--delay: 1000ms">
			<a 
				href="/posts/" 
				class="group inline-flex items-center gap-x-2 text-sm font-bold opacity-50 hover:opacity-100 transition-all hover:text-[var(--theme-bright-sun)]"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform group-hover:-translate-x-1"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
				Back to Blog
			</a>
		</div>

	</div>
</PageLayout>

<script>
	function initWordle() {
		const cloud = document.getElementById('wordle-cloud');
		const items = Array.from(document.querySelectorAll('.tag-item')) as HTMLElement[];
		if (!cloud) return;

		// Shuffle for randomness each time
		const shuffled = items.sort(() => Math.random() - 0.5);
		
		shuffled.forEach((item) => {
			const link = item.querySelector('a');
			if (!link) return;

			// No vertical writing mode
			// Subtle rotation (only -3 to 3 degrees) to keep it feeling hand-clustered but professional
			const rotation = Math.random() * 6 - 3;
			link.style.transform = `rotate(${rotation}deg)`;
			cloud.appendChild(item);
		});

		cloud.classList.remove('opacity-0');
	}

	initWordle();
	document.addEventListener("astro:after-swap", initWordle);
</script>

<style>
	#wordle-cloud { list-style: none; padding: 0; }

	/* The Hover focus effect */
	.tag-item:hover ~ .tag-item {
		opacity: 0.3;
		filter: grayscale(1) blur(0.5px);
	}

	a {
		display: inline-block;
		text-decoration: none !important;
		white-space: nowrap;
		color: currentColor; 
		padding: 0.1rem 0.2rem;
	}

	.animate-in {
		opacity: 0;
		animation: fadeInUp 0.8s ease-out forwards;
		animation-delay: var(--delay, 0ms);
	}

	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>