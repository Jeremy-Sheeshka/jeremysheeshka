---
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();
const { pathname } = Astro.url;

// Determine the variant class based on the current path
let variantClass = ""; // Default is empty (falls back to Cinnabar/Red)

if (pathname.includes("/projects")) {
    variantClass = "projects";
} else if (pathname.includes("/blog") || pathname.includes("/posts")) {
    variantClass = "blog";
}

const socialLinks = [
    {
        name: "Github",
        url: "https://github.com/jeremysheeshka",
        iconPath: "M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4 M9 18c-4.51 2-5-2-7-2",
        fill: "none",
        stroke: "currentColor"
    },
    {
        name: "YouTube",
        url: "https://youtube.com/@yourchannel",
        iconPath: "M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29.006 29.006 0 0 0 1 11.75a29.006 29.006 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29.006 29.006 0 0 0 .46-5.25 29.006 29.006 0 0 0-.46-5.33z M9.75 15.02l5.75-3.27-5.75-3.27v6.54z",
        fill: "none",
        stroke: "currentColor"
    },
    {
        name: "Spotify",
        url: "https://open.spotify.com/user/youruser",
        iconPath: "M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2m0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16m3.536 11.364a.5.5 0 0 1-.708 0 6.668 6.668 0 0 0-5.656 0 .5.5 0 0 1-.293-.941 7.668 7.668 0 0 1 6.657 0 .5.5 0 0 1 0 .848m1.237-2.753a.5.5 0 0 1-.707 0 9.17 9.17 0 0 0-8.132 0 .5.5 0 1 1-.414-.866 10.17 10.17 0 0 1 9.253 0 .5.5 0 0 1 0 .866m1.114-2.88a.5.5 0 0 1-.707 0 12.083 12.083 0 0 0-11.364 0 .5.5 0 1 1-.447-.894 13.083 13.083 0 0 1 12.518 0 .5.5 0 0 1 0 .894",
        fill: "currentColor", 
        stroke: "none"
    },
];
---

<footer class={`mt-auto w-full transition-colors duration-300 ${variantClass}`}>
    
    <div 
        class="w-full leading-[0] overflow-hidden transform translate-y-px" 
        style="background-color: var(--footer-bg);"
    >
        <svg 
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 1200 120" 
            preserveAspectRatio="none" 
            class="block w-full h-16 sm:h-24 fill-[var(--theme-bg)]"
        >
            <path d="M1200 120 0 16.48V0h1200z"></path>
        </svg>
    </div>

    <div 
        class="text-white w-full px-6 md:px-12 pb-8 pt-4" 
        style="background-color: var(--footer-bg);"
    >
        
        <div class="flex flex-col items-center justify-center gap-y-2 text-center align-top font-semibold sm:flex-row sm:justify-between sm:text-xs">
            <div class="me-0 sm:me-4">
                © {siteConfig.author}
                {year}.
            </div>

            <nav
                aria-label="Social links"
                class="flex gap-x-4 items-center"
            >
                {socialLinks.map((link) => (
                    <a 
                        href={link.url} 
                        class="inline-block hover:opacity-80 transition-opacity"
                        style="color: inherit;"
                        aria-label={link.name}
                        target={link.url.startsWith("http") ? "_blank" : "_self"}
                        rel={link.url.startsWith("http") ? "noreferrer noopener" : ""}
                    >
                        <svg 
                            xmlns="http://www.w3.org/2000/svg" 
                            viewBox="0 0 24 24" 
                            class="w-5 h-5"
                            fill={link.fill}
                            stroke={link.stroke}
                            stroke-width="2"
                            stroke-linecap="round" 
                            stroke-linejoin="round"
                        >
                            <path d={link.iconPath} fill-rule="evenodd" clip-rule="evenodd" />
                        </svg>
                    </a>
                ))}
            </nav>
        </div>
    </div>
</footer>

<style>
    /* 1. DEFAULT (About Page) - Red
       We use your existing --theme-cinnabar variable.
       Since this variable already handles dark/light switching in your global CSS,
       we don't need to manually override it here.
    */
    footer {
        --footer-bg: var(--theme-cinnabar);
    }

    /* 2. PROJECTS PAGE - Blue */
    footer.projects {
        --footer-bg: #2563EB; /* Light Mode: Blue-600 */
    }

    /* 3. BLOG PAGE - Yellow/Gold */
    footer.blog {
        --footer-bg: #D97706; /* Light Mode: Amber-600 */
    }

    /* --- DARK MODE OVERRIDES --- 
       We target global dark class/attributes to trigger the color change. 
       This works regardless of if you use class="dark" or data-theme="dark".
    */

    :global(.dark) footer.projects,
    :global([data-theme="dark"]) footer.projects {
        --footer-bg: #1E3A8A; /* Dark Mode: Blue-900 */
    }

    :global(.dark) footer.blog,
    :global([data-theme="dark"]) footer.blog {
        --footer-bg: #78350F; /* Dark Mode: Amber-900 */
    }
</style>