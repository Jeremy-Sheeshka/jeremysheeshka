let themeClass = "theme-cinnabar"; 
let svgViewBox = "0 0 1200 120";
let svgPath = "M0 16.48 L1200 120 V120 H0 Z"; 

// --- 2. PAGE SPECIFIC OVERRIDES ---

if (isHome) {
    themeClass = "theme-home";
} else if (pathname.includes("/projects")) {
    themeClass = "theme-royal-blue";
    svgViewBox = "0 0 1440 320"; 
    svgPath = "m0 192 34.3-5.3C68.6 181 137 171 206 181.3 274.3 192 343 224 411 240c69 16 138 16 206 26.7 68.7 10.3 137 32.3 206 32 68.4.3 137-21.7 206-32 68.1-10.7 137-10.7 205-26.7 68.9-16 137-48 172-64l34-16 V320 H0 Z";
} else if (pathname.includes("/blog") || pathname.includes("/posts") || pathname.includes("/tags")) {
    themeClass = "theme-bright-sun";
    svgViewBox = "0 0 1200 120";
    svgPath = "M0 46.29c47.79 22.2 103.59 32.17 158 28 70.36-5.37 136.33-33.31 206.8-37.5 73.84-4.36 147.54 16.88 218.2 35.26 69.27 18 138.3 24.88 209.4 13.08 36.15-6 69.85-17.84 104.45-29.34C989.49 25 1113-14.29 1200 52.47 V120 H0 Z";
}

