---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";

const logoText = "Jeremy Sheeshka";
---

<header class="w-full bg-cinnabar px-6 md:px-12 py-6 flex justify-between items-center relative z-40" id="main-header">
    
    <a
        aria-current={Astro.url.pathname === "/" ? "page" : false}
        class="inline-flex items-center group"
        href="/"
    >
        <div id="name" class="homemade-apple-regular text-2xl sm:text-3xl relative z-10 text-white">
            {
                logoText.split("").map((char, index) => {
                    if (char === " ") return <span>&nbsp;</span>;
                    const delay = `${5000 + index * 100}ms`;
                    return <span style={{ animationDelay: delay }}>{char}</span>;
                })
            }
        </div>
    </a>

    <div class="flex items-center gap-6">
        <nav
            aria-label="Main menu"
            class="hidden sm:flex items-center gap-6"
            id="desktop-menu"
        >
            {
                menuLinks.map((link) => (
                    <a
                        aria-current={Astro.url.pathname === link.path ? "page" : false}
                        class="text-base font-bold text-white/90 hover:text-white transition-colors uppercase tracking-wide"
                        href={link.path}
                    >
                        {link.title}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center gap-2 text-white">
            <Search />
            <ThemeToggle />
        </div>

        <mobile-button>
            <button
                aria-expanded="false"
                aria-haspopup="menu"
                class="group relative h-7 w-7 sm:hidden flex items-center justify-center text-white"
                id="toggle-navigation-menu"
                type="button"
            >
                <span class="sr-only">Open main menu</span>
                <svg aria-hidden="true" class="absolute transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0" fill="none" focusable="false" stroke="currentColor" stroke-width="1.5" width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <svg aria-hidden="true" class="absolute scale-0 opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100" fill="none" focusable="false" stroke="currentColor" stroke-width="1.5" width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </button>
        </mobile-button>
    </div>
</header>

<nav
    id="mobile-drawer"
    class="fixed inset-x-0 top-[76px] bg-global-bg border-b border-textColor/10 p-4 hidden flex-col gap-4 sm:hidden z-50 shadow-lg"
>
    {
        menuLinks.map((link) => (
            <a href={link.path} class="text-lg font-medium text-gray-600 dark:text-gray-300 hover:text-accent">
                {link.title}
            </a>
        ))
    }
</nav>

<style>
    /* Colors */
    .bg-cinnabar { background-color: #E54848; }
    :global(.dark) .bg-cinnabar { background-color: #d55b56; }

    /* Fonts */
    .homemade-apple-regular { font-family: "Homemade Apple", cursive; font-weight: bold; letter-spacing: -0.1rem; }

    /* Animation */
    :root { --rb-0: #ffffff; --rb-1: #FFD8D4; --rb-2: #3BBE58; --rb-3: #4862E5; --rb-4: #F5CF38; --rb-5: #ffffff; --rb-6: #60B978; --rb-7: #ffffff; }
    #name span { animation: highlight-unified 160s linear infinite; display: inline-block; color: var(--rb-0); }
    @keyframes highlight-unified { 0% { color: var(--rb-0); } 14.28% { color: var(--rb-1); } 28.56% { color: var(--rb-2); } 42.84% { color: var(--rb-3); } 57.12% { color: var(--rb-4); } 71.4% { color: var(--rb-5); } 85.68% { color: var(--rb-6); } 100% { color: var(--rb-7); } }
</style>

<script>
    import { toggleClass } from "@/utils/domElement";
    class MobileNavBtn extends HTMLElement {
        connectedCallback() {
            const headerEl = document.getElementById("main-header")!;
            const drawerEl = document.getElementById("mobile-drawer")!;
            const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");
            mobileButtonEl?.addEventListener("click", () => {
                toggleClass(headerEl, "menu-open");
                toggleClass(drawerEl, "hidden");
                toggleClass(drawerEl, "flex");
                const isExpanded = mobileButtonEl.getAttribute("aria-expanded") === "true";
                mobileButtonEl.setAttribute("aria-expanded", (!isExpanded).toString());
            });
        }
    }
    customElements.define("mobile-button", MobileNavBtn);
</script>