---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";

interface Props {
    themeColor?: "cinnabar" | "royal-blue" | "bright-sun" | "green" | "cream";
}

const { themeColor = "cinnabar" } = Astro.props;
const logoText = "Jeremy Sheeshka";

// Map the passed 'themeColor' prop to the actual CSS variable for the active state
const activeColorVar = `var(--theme-${themeColor})`;
---

<header 
    class="w-full px-6 md:px-12 py-5 flex flex-wrap justify-between items-center fixed top-0 z-50 transition-all duration-300 bg-white/80 dark:bg-[#110f0b]/80 backdrop-blur-md border-b border-transparent dark:border-white/5" 
    id="main-header"
>
    
    {/* LOGO AREA */}
    <a
        aria-current={Astro.url.pathname === "/" ? "page" : false}
        class="inline-flex items-center group order-1"
        href="/"
    >
        <div id="name" class="homemade-apple-regular text-2xl sm:text-3xl relative z-10 whitespace-nowrap">
            {
                logoText.split("").map((char, index) => {
                    if (char === " ") return <span>&nbsp;</span>;
                    return <span style={{ "--char-index": index }}>{char}</span>;
                })
            }
        </div>
    </a>

    {/* THEME TOGGLE */}
    <div class="flex items-center transition-colors duration-300 ease-in-out order-2 sm:order-3 relative z-50 text-global-text">
        <ThemeToggle />
    </div>

    {/* NAVIGATION MENU */}
    <nav
        aria-label="Main menu"
        class="flex items-center gap-6 order-3 w-full sm:w-auto sm:order-2 mt-4 sm:mt-0 justify-start sm:ml-auto sm:mr-6"
        id="desktop-menu"
    >
        {
            menuLinks.map((link) => {
                const isActive = Astro.url.pathname === link.path || (link.path !== '/' && Astro.url.pathname.startsWith(link.path));
                
                return (
                    <a
                        aria-current={isActive ? "page" : false}
                        class="text-sm sm:text-base font-bold uppercase tracking-wide transition-colors duration-300 ease-in-out"
                        style={isActive ? `color: ${activeColorVar}; opacity: 1;` : "color: var(--header-text); opacity: 0.7;"}
                        href={link.path}
                    >
                        {/* Hover Effect: Slide up slightly on hover */}
                        <span class="inline-block hover:-translate-y-0.5 transition-transform duration-200">
                            {link.title}
                        </span>
                    </a>
                )
            })
        }
    </nav>

</header>

<script is:inline>
    // Sync animation to ensure the rainbow flows smoothly
    const duration = 160000; 
    const offset = Date.now() % duration;
    document.documentElement.style.setProperty('--anim-sync', `-${offset}ms`);
</script>

<style>
    .homemade-apple-regular { font-family: "Homemade Apple", cursive; font-weight: bold; letter-spacing: -0.1rem; }

    /* Animation Logic */
    #name span {
        display: inline-block;
        /* Default color uses the global text color (Dark Grey or White) */
        color: var(--header-text); 
        animation: highlight-unified 160s linear infinite;
        animation-delay: calc(var(--anim-sync) + 5000ms + (var(--char-index) * 100ms));
    }

    /* The Rainbow Animation 
       Since we switched pages to "Cream" (Neutral) backgrounds, 
       these colors will now pop beautifully on both Light and Dark mode.
    */
    @keyframes highlight-unified {
        0%      { color: var(--header-text); }
        14.28%  { color: var(--rb-1); } /* Red */
        28.56%  { color: var(--rb-2); } /* Pink */
        42.84%  { color: var(--rb-3); } /* Blue */
        57.12%  { color: var(--rb-4); } /* Green */
        71.4%   { color: var(--rb-5); } /* Bright Green */
        85.68%  { color: var(--rb-6); } /* Yellow */
        100%    { color: var(--header-text); }
    }
</style>