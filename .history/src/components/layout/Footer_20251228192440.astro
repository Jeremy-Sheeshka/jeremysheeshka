---
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
    class="mt-auto flex w-full flex-col items-center justify-center gap-y-2 pt-20 pb-4 text-center align-top font-semibold text-current opacity-60 sm:flex-row sm:justify-between sm:text-xs hover:opacity-100 transition-opacity"
>
    <div class="me-0 sm:me-4">
        &copy; {siteConfig.author}
        {year}.<span class="inline-block">&nbsp;🚀&nbsp;{siteConfig.title}</span>
    </div>
    <nav
        aria-labelledby="footer_links"
        class="flex gap-x-2 sm:gap-x-0 sm:divide-x sm:divide-current"
    >
        <p id="footer_links" class="sr-only">More on this site</p>
        {
            menuLinks.map((link) => (
                <a class="px-4 py-2 hover:underline sm:py-0" href={link.path}>
                    {link.title}
                </a>
            ))
        }
    </nav>
</footer>