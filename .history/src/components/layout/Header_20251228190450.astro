---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";

interface Props {
    themeColor?: "cinnabar" | "royal-blue" | "bright-sun" | "green" | "cream";
}

const { themeColor = "cinnabar" } = Astro.props;
const logoText = "Jeremy Sheeshka";
const bgClass = `bg-theme-${themeColor}`;
---

<header class={`w-full ${bgClass} px-6 md:px-12 py-5 flex flex-wrap justify-between items-center relative z-40 overflow-hidden transition-all duration-300`} id="main-header">
    
    <a
        aria-current={Astro.url.pathname === "/" ? "page" : false}
        class="inline-flex items-center group order-1"
        href="/"
    >
        <div id="name" class="homemade-apple-regular text-2xl sm:text-3xl relative z-10 whitespace-nowrap">
            {
                logoText.split("").map((char, index) => {
                    if (char === " ") return <span>&nbsp;</span>;
                    return <span style={{ "--char-index": index }}>{char}</span>;
                })
            }
        </div>
    </a>

    <div class="flex items-center transition-colors duration-300 ease-in-out order-2 sm:order-3" style="color: var(--anim-start);">
        <ThemeToggle />
    </div>

    <nav
        aria-label="Main menu"
        class="flex items-center gap-6 order-3 w-full sm:w-auto sm:order-2 mt-4 sm:mt-0 justify-start sm:ml-auto sm:mr-6"
        id="desktop-menu"
    >
        {
            menuLinks.map((link) => (
                <a
                    aria-current={Astro.url.pathname === link.path ? "page" : false}
                    class="text-sm sm:text-base font-bold uppercase tracking-wide opacity-90 hover:opacity-100 transition-colors duration-300 ease-in-out"
                    style="color: var(--anim-start);" 
                    href={link.path}
                >
                    {link.title}
                </a>
            ))
        }
    </nav>

</header>

<script is:inline>
    const duration = 160000; 
    const offset = Date.now() % duration;
    document.documentElement.style.setProperty('--anim-sync', `-${offset}ms`);
</script>

<style>
    .homemade-apple-regular { font-family: "Homemade Apple", cursive; font-weight: bold; letter-spacing: -0.1rem; }

    /* --- 1. GLOBAL DEFAULTS --- */
    :root {
        /* Standard Rainbow Colors */
        --rb-1: #E54848; --rb-2: #E54867; --rb-3: #4862E5; 
        --rb-4: #60B978; --rb-5: #3BBE58; --rb-6: #F5CF38;
        
        /* Light Mode Default Start: WHITE (For Red/Blue/Green themes) */
        --anim-start: #ffffff; 
    }

    /* Dark Mode Default Start: BLACK (For Red/Blue/Green themes) */
    :global(.dark), :global([data-theme="dark"]) {
        --anim-start: #000000; 
    }

    /* --- 2. SPECIFIC THEME OVERRIDES --- */

    /* A. CREAM THEME (White/Grey BG) */
    /* Light: Start Dark Grey */
    header.bg-theme-cream { 
        --anim-start: #2e2e2e; 
    }
    /* Dark: Start White */
    :global(.dark) header.bg-theme-cream,
    :global([data-theme="dark"]) header.bg-theme-cream { 
        --anim-start: #ffffff !important; 
    }

    /* B. BRIGHT SUN (Yellow BG) - EXCEPTION */
    /* Always Start Black/Dark (White is invisible on yellow) */
    header.bg-theme-bright-sun { 
        --anim-start: #1a1810; 
        --rb-6: #1a1810; /* Camouflage Fix: Change Yellow part of rainbow to Black */
    }
    :global(.dark) header.bg-theme-bright-sun, 
    :global([data-theme="dark"]) header.bg-theme-bright-sun { 
        --anim-start: #1a1810 !important; 
        --rb-6: #1a1810; 
    }

    /* C. CINNABAR (Red BG) */
    /* Light: Starts White. Fix: Make Red part of rainbow White. */
    header.bg-theme-cinnabar { --rb-1: #ffffff; }
    /* Dark: Starts Black. Fix: Make Red part of rainbow Black. */
    :global(.dark) header.bg-theme-cinnabar { --rb-1: #000000; }

    /* D. ROYAL BLUE (Blue BG) */
    /* Light: Starts White. Fix: Make Blue part of rainbow White. */
    header.bg-theme-royal-blue { --rb-3: #ffffff; }
    /* Dark: Starts Black. Fix: Make Blue part of rainbow Black. */
    :global(.dark) header.bg-theme-royal-blue { --rb-3: #000000; }

    /* E. GREEN (Green BG) */
    /* Light: Starts White. Fix: Make Green part of rainbow White. */
    header.bg-theme-green { --rb-5: #ffffff; }
    /* Dark: Starts Black. Fix: Make Green part of rainbow Black. */
    :global(.dark) header.bg-theme-green { --rb-5: #000000; }


    /* --- ANIMATION --- */
    #name span {
        display: inline-block;
        color: var(--anim-start); 
        animation: highlight-unified 160s linear infinite;
        animation-delay: calc(var(--anim-sync) + 5000ms + (var(--char-index) * 100ms));
    }

    @keyframes highlight-unified {
        0%      { color: var(--anim-start); }
        14.28%  { color: var(--rb-1); }
        28.56%  { color: var(--rb-2); }
        42.84%  { color: var(--rb-3); }
        57.12%  { color: var(--rb-4); }
        71.4%   { color: var(--rb-5); }
        85.68%  { color: var(--rb-6); }
        100%    { color: var(--anim-start); }
    }
</style>