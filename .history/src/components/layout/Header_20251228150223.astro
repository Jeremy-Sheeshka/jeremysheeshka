---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";

interface Props {
    themeColor?: "cinnabar" | "royal-blue" | "bright-sun";
}

const { themeColor = "cinnabar" } = Astro.props;
const logoText = "Jeremy Sheeshka";
const bgClass = `bg-theme-${themeColor}`;
---

<header class={`w-full ${bgClass} px-6 md:px-12 py-6 flex justify-between items-center relative z-40 overflow-hidden`} id="main-header">
    
    <a aria-current={Astro.url.pathname === "/" ? "page" : false} class="inline-flex items-center group" href="/">
        <div id="name" class="homemade-apple-regular text-2xl sm:text-3xl relative z-10">
            {
                logoText.split("").map((char, index) => {
                    if (char === " ") return <span>&nbsp;</span>;
                    return <span style={{ "--char-index": index }}>{char}</span>;
                })
            }
        </div>
    </a>

    <div class="flex items-center gap-6">
        <nav aria-label="Main menu" class="hidden sm:flex items-center gap-6" id="desktop-menu">
            {
                menuLinks.map((link) => (
                    <a
                        aria-current={Astro.url.pathname === link.path ? "page" : false}
                        class="text-base font-bold transition-colors uppercase tracking-wide opacity-90 hover:opacity-100"
                        style="color: inherit;"
                        href={link.path}
                    >
                        {link.title}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center gap-2" style="color: inherit;">
            <Search />
            <ThemeToggle />
        </div>

        <mobile-button>
            <button
                aria-expanded="false"
                aria-haspopup="menu"
                class="group relative h-7 w-7 sm:hidden flex items-center justify-center"
                style="color: inherit;"
                id="toggle-navigation-menu"
                type="button"
            >
                <span class="sr-only">Open main menu</span>
                <svg aria-hidden="true" class="absolute transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0" fill="none" focusable="false" stroke="currentColor" stroke-width="1.5" width="24" height="24" viewBox="0 0 24 24"><path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                <svg aria-hidden="true" class="absolute scale-0 opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100" fill="none" focusable="false" stroke="currentColor" stroke-width="1.5" width="24" height="24" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
        </mobile-button>
    </div>
</header>

<nav id="mobile-drawer" class="fixed inset-x-0 top-[76px] bg-global-bg border-b border-textColor/10 p-4 hidden flex-col gap-4 sm:hidden z-50 shadow-lg">
    {menuLinks.map((link) => <a href={link.path} class="text-lg font-medium text-gray-600 dark:text-gray-300 hover:text-accent">{link.title}</a>)}
</nav>

<script is:inline>
    const duration = 160000; 
    const offset = Date.now() % duration;
    document.documentElement.style.setProperty('--anim-sync', `-${offset}ms`);
</script>

<style>
    .homemade-apple-regular {
        font-family: "Homemade Apple", cursive;
        font-weight: bold;
        letter-spacing: -0.1rem; 
    }

    /* --- 1. RAINBOW PALETTE (Natural Progression) --- */
    :root {
        --rb-1: #E54848; /* Red */
        --rb-2: #E54867; /* Pink */
        --rb-3: #4862E5; /* Blue */
        --rb-4: #60B978; /* Teal */
        --rb-5: #3BBE58; /* Green */
        --rb-6: #F5CF38; /* Yellow */
        
        /* DEFAULT ANIMATION START COLOR (Light Mode) */
        --anim-start: #ffffff; 
    }

    /* --- 2. DARK MODE OVERRIDES --- */
    :global(.dark), :global([data-theme="dark"]) {
        /* Subdued Rainbow */
        --rb-1: #C76C6C;
        --rb-2: #D97085;
        --rb-3: #7F8DE0;
        --rb-4: #93C4A4;
        --rb-5: #78C992;
        --rb-6: #E6D36F;

        /* DARK MODE START COLOR */
        --anim-start: #000000; 
    }

    /* --- 3. PAGE-SPECIFIC OVERRIDES --- */

    /* Yellow/Blog Page: ALWAYS start Black (Light & Dark) for contrast */
    header.bg-theme-bright-sun { 
        --anim-start: #2e2e2e; 
    }
    :global(.dark) header.bg-theme-bright-sun { 
        --anim-start: #1a1810; 
    }

    /* Camouflage Fixes (Tint Shifting) */
    header.bg-theme-cinnabar { --rb-1: #FFC4C4; } 
    :global(.dark) header.bg-theme-cinnabar { --rb-1: #FFD1D1; }

    header.bg-theme-royal-blue { --rb-3: #C4D6FF; }
    :global(.dark) header.bg-theme-royal-blue { --rb-3: #D0E1FF; }

    header.bg-theme-bright-sun { --rb-6: #D97706; }
    :global(.dark) header.bg-theme-bright-sun { --rb-6: #B45309; }


    /* --- 4. ANIMATION LOGIC --- */
    #name span {
        display: inline-block;
        /* Use the variable instead of 'inherit' */
        color: var(--anim-start); 
        animation: highlight-unified 160s linear infinite;
        animation-delay: calc(var(--anim-sync) + 5000ms + (var(--char-index) * 100ms));
    }

    @keyframes highlight-unified {
        0%      { color: var(--anim-start); }
        14.28%  { color: var(--rb-1); }
        28.56%  { color: var(--rb-2); }
        42.84%  { color: var(--rb-3); }
        57.12%  { color: var(--rb-4); }
        71.4%   { color: var(--rb-5); }
        85.68%  { color: var(--rb-6); }
        100%    { color: var(--anim-start); }
    }
</style>

<script>
    import { toggleClass } from "@/utils/domElement";
    class MobileNavBtn extends HTMLElement {
        connectedCallback() {
            const headerEl = document.getElementById("main-header")!;
            const drawerEl = document.getElementById("mobile-drawer")!;
            const btn = this.querySelector<HTMLButtonElement>("button");
            btn?.addEventListener("click", () => {
                toggleClass(headerEl, "menu-open"); toggleClass(drawerEl, "hidden"); toggleClass(drawerEl, "flex");
                btn.setAttribute("aria-expanded", (btn.getAttribute("aria-expanded") === "false").toString());
            });
        }
    }
    customElements.define("mobile-button", MobileNavBtn);
</script>