---
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();
const { pathname } = Astro.url;

// Check if we are on the homepage
const isHome = pathname === "/" || pathname === "";

// --- 1. DEFAULTS ---
let themeClass = "theme-cinnabar"; 
let svgViewBox = "0 0 1200 120";
let svgPath = "M0 16.48 L1200 120 V120 H0 Z"; 

// --- 2. PAGE SPECIFIC OVERRIDES ---

if (isHome) {
    themeClass = "theme-home";
} else if (pathname.includes("/projects")) {
    themeClass = "theme-royal-blue";
    svgViewBox = "0 0 1440 320"; 
    svgPath = "m0 192 34.3-5.3C68.6 181 137 171 206 181.3 274.3 192 343 224 411 240c69 16 138 16 206 26.7 68.7 10.3 137 32.3 206 32 68.4.3 137-21.7 206-32 68.1-10.7 137-10.7 205-26.7 68.9-16 137-48 172-64l34-16 V320 H0 Z";
} else if (pathname.includes("/blog") || pathname.includes("/posts") || pathname.includes("/tags")) {
    themeClass = "theme-bright-sun";
    svgViewBox = "0 0 1200 120";
    svgPath = "M0 46.29c47.79 22.2 103.59 32.17 158 28 70.36-5.37 136.33-33.31 206.8-37.5 73.84-4.36 147.54 16.88 218.2 35.26 69.27 18 138.3 24.88 209.4 13.08 36.15-6 69.85-17.84 104.45-29.34C989.49 25 1113-14.29 1200 52.47 V120 H0 Z";
}

const socialLinks = [
    {
        name: "Github",
        // Corrected with hyphen to match your actual GitHub username
        url: "https://github.com/Jeremy-Sheeshka",
        iconPath: "M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4 M9 18c-4.51 2-5-2-7-2",
        fill: "none",
        stroke: "currentColor",
        isMe: true 
    },
    {
        name: "YouTube",
        url: "https://youtube.com/@yourchannel",
        iconPath: "M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29.006 29.006 0 0 0 1 11.75a29.006 29.006 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29.006 29.006 0 0 0 .46-5.25 29.006 29.006 0 0 0-.46-5.33z M9.75 15.02l5.75-3.27-5.75-3.27v6.54z",
        fill: "none",
        stroke: "currentColor",
        isMe: false
    },
    {
        name: "Mastodon",
        url: "https://mastodon.social/@jsheeshka",
        iconPath: "M21.32 19.1c0 .5-.4.9-.9.9h-4.3c-.5 0-.9-.4-.9-.9v-4.1c0-.5.4-.9.9-.9h4.3c.5 0 .9.4.9.9v4.1zm-8.2 0c0 .5-.4.9-.9.9H7.9c-.5 0-.9-.4-.9-.9v-4.1c0-.5.4-.9.9-.9h4.3c.5 0 .9.4.9.9v4.1zm8.2-7.5c0 .5-.4.9-.9.9h-4.3c-.5 0-.9-.4-.9-.9V7.5c0-.5.4-.9.9-.9h4.3c.5 0 .9.4.9.9v4.1zm-8.2 0c0 .5-.4.9-.9.9H7.9c-.5 0-.9-.4-.9-.9V7.5c0-.5.4-.9.9-.9h4.3c.5 0 .9.4.9.9v4.1zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z",
        fill: "currentColor", 
        stroke: "none",
        isMe: true 
    },
];
---

<footer class={`mt-auto w-full transition-colors duration-300 ${themeClass}`}>
    
    { !isHome && (
        <div class="w-full leading-[0] overflow-hidden transform translate-y-px">
            <svg 
                xmlns="http://www.w3.org/2000/svg" 
                viewBox={svgViewBox}
                preserveAspectRatio="none" 
                class="block w-full h-16 sm:h-24"
                style="fill: var(--footer-bg); transform: scale(1.01); transform-origin: bottom;" 
            >
                <path d={svgPath}></path>
            </svg>
        </div>
    )}

    <div 
        class="w-full px-6 md:px-12 pb-8 pt-4" 
        style="background-color: var(--footer-bg); color: var(--footer-text);"
    >
        
        <div class="flex flex-col items-center justify-center gap-y-2 text-center align-top font-semibold sm:flex-row sm:justify-between sm:text-xs">
            <div class="me-0 sm:me-4">
                © {siteConfig.author} {year}.
            </div>

            <nav aria-label="Social links" class="flex gap-x-4 items-center">
                {socialLinks.map((link) => (
                    <a 
                        href={link.url} 
                        class="inline-block hover:opacity-75 transition-opacity"
                        style="color: inherit;"
                        aria-label={link.name}
                        target="_blank"
                        rel={link.isMe ? "me" : "noreferrer noopener"}
                    >
                        <svg 
                            xmlns="http://www.w3.org/2000/svg" 
                            viewBox="0 0 24 24" 
                            class="w-5 h-5"
                            fill={link.fill}
                            stroke={link.stroke}
                            stroke-width="2"
                            stroke-linecap="round" 
                            stroke-linejoin="round"
                        >
                            <path d={link.iconPath} fill-rule="evenodd" clip-rule="evenodd" />
                        </svg>
                    </a>
                ))}
            </nav>
        </div>
    </div>
</footer>

<style>
    footer.theme-home {
        --footer-bg: transparent; 
        --footer-text: currentColor; 
    }
    footer.theme-cinnabar {
        --footer-bg: var(--theme-cinnabar);
        --footer-text: #ffffff;
    }
    footer.theme-royal-blue {
        --footer-bg: var(--theme-royal-blue); 
        --footer-text: #ffffff;
    }
    footer.theme-bright-sun {
        --footer-bg: var(--theme-bright-sun);
        --footer-text: #1a1810; 
    }
</style>