---
import { menuLinks } from "@/site.config";

interface Props {
    themeColor?: "cinnabar" | "royal-blue" | "bright-sun" | "green" | "cream";
}

const { themeColor = "cinnabar" } = Astro.props;
const logoText = "Jeremy Sheeshka";
---

<header 
    class="w-full px-6 md:px-12 py-6 flex items-center justify-between relative z-40 transition-all duration-300" 
    id="main-header"
>
    <a
        aria-current={Astro.url.pathname === "/" ? "page" : false}
        class="inline-flex items-center group flex-shrink-0"
        href="/"
    >
        <div id="name" class="homemade-apple-regular text-xl sm:text-2xl relative z-10 whitespace-nowrap">
            {
                logoText.split("").map((char, index) => {
                    if (char === " ") return <span>&nbsp;</span>;
                    return <span style={{ "--char-index": index }}>{char}</span>;
                })
            }
        </div>
    </a>

    <nav
        aria-label="Main menu"
        class="flex items-center gap-x-4 sm:gap-x-8"
        id="desktop-menu"
    >
        {
            menuLinks.map((link) => (
                <a
                    aria-current={Astro.url.pathname === link.path ? "page" : false}
                    class="text-[13px] sm:text-sm font-bold uppercase tracking-[0.15em] opacity-70 hover:opacity-100 transition-all duration-300 ease-in-out nav-link"
                    style="color: var(--header-text);" 
                    href={link.path}
                >
                    {link.title}
                </a>
            ))
        }

        <div class="w-10 sm:w-20 h-1 flex-shrink-0"></div>
    </nav>
</header>

<script is:inline>
    const duration = 160000; 
    const offset = Date.now() % duration;
    document.documentElement.style.setProperty('--anim-sync', `-${offset}ms`);
</script>

<style>
    .homemade-apple-regular { 
        font-family: "Homemade Apple", cursive; 
        font-weight: bold; 
        letter-spacing: -0.05rem; 
    }

    #name span {
        display: inline-block;
        color: var(--header-text); 
        animation: highlight-unified 160s linear infinite;
        animation-delay: calc(var(--anim-sync) + 5000ms + (var(--char-index) * 100ms));
    }

    @keyframes highlight-unified {
        0%      { color: var(--header-text); }
        14.28%  { color: var(--rb-1); }
        28.56%  { color: var(--rb-2); }
        42.84%  { color: var(--rb-3); }
        57.12%  { color: var(--rb-4); }
        71.4%   { color: var(--rb-5); }
        85.68%  { color: var(--rb-6); }
        100%    { color: var(--header-text); }
    }

    .nav-link[aria-current="page"] {
        opacity: 1;
        position: relative;
    }
    
    .nav-link[aria-current="page"]::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 100%;
        height: 1px;
        background-color: currentColor;
        opacity: 0.5;
    }
</style>