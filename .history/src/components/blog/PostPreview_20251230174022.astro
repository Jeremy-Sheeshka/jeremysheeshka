---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
}

const { post, withDesc = false } = Astro.props;
const date = post.data.updatedDate ?? post.data.publishDate;
---

<a
	href={`/posts/${post.slug}/`}
	class="group block w-full rounded-xl bg-gray-200 p-6 border-4 border-gray-200 transition-colors duration-200 hover:border-cinnabar dark:bg-gray-800 dark:border-gray-800 dark:hover:border-cinnabar"
	data-astro-prefetch
>
	<div class="flex flex-col gap-2">
		<h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">
			{post.data.title}
		</h2>

		<div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
			<FormattedDate date={date} />
			{
				post.data.tags && (
					<span class="opacity-70">
						• {post.data.tags.slice(0, 2).join(", ")}
					</span>
				)
			}
		</div>

		{
			withDesc && post.data.description && (
				<p class="mt-2 text-base italic leading-relaxed text-gray-700 dark:text-gray-300">
					{post.data.description}
				</p>
			)
		}
	</div>
</a>