---
import { getWebmentionsForUrl } from "@/utils/webmentions";
import Comments from "./Comments.astro";
import Likes from "./Likes.astro";

// This ensures we get the full absolute URL for Webmention.io to look up
const url = new URL(Astro.url.pathname, Astro.site);

const webMentions = await getWebmentionsForUrl(`${url}`);

// Return null if no webmentions so we don't render an empty section
if (!webMentions.length) return null;
---

<div class="mt-20 border-t-2 border-stone-200 dark:border-zinc-800 pt-12">
    <h2 class="mb-8 text-2xl font-bold">Webmentions</h2>
    <div class="space-y-10">
        <Likes mentions={webMentions} />
        <Comments mentions={webMentions} />
    </div>
    <p class="mt-8 text-sm text-stone-500">
        Responses powered by{" "}
        <a 
            href="https://webmention.io" 
            rel="noreferrer" 
            target="_blank"
            class="underline hover:text-accent"
        >
            Webmention.io
        </a>
    </p>
</div>