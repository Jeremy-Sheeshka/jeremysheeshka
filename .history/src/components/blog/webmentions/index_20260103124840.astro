---
import { getWebmentionsForUrl } from "@/utils/webmentions";
import Comments from "./Comments.astro";
import Likes from "./Likes.astro";

// get the absolute URL for the current post
const url = new URL(Astro.url.pathname, Astro.site).href;
const webMentions = await getWebmentionsForUrl(url);

if (!webMentions.length) return null;
---

<section class="mt-24 pt-12 border-t border-stone-200 dark:border-zinc-800">
    <div class="flex items-center justify-between mb-12">
        <h2 class="text-xs font-bold text-stone-400 uppercase tracking-[0.2em] m-0">
            Community Responses
        </h2>
        <a 
            href="https://webmention.io" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-[10px] text-stone-400 hover:text-accent uppercase tracking-widest transition-colors"
        >
            via Webmention.io
        </a>
    </div>

    <div class="space-y-16">
        <Likes mentions={webMentions} />
        <Comments mentions={webMentions} />
    </div>

    <p class="mt-16 text-sm text-stone-500 italic text-pretty">
        Mention this post on Mastodon, Bluesky, or your own blog to join the conversation.
    </p>
</section>