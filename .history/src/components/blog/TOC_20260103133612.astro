---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Fix: Removed the frontmatter destructuring which was causing the TS error.
// TOC is now gated by heading length. If you want to hide it manually, 
// use the 'showToc: false' in the Markdown file which is handled by the Layout.
const shouldShowToc = headings.length > 0;

const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const toc = generateToc(filteredHeadings);
---

{shouldShowToc && (
    <details open class="lg:sticky lg:top-12 lg:order-2 lg:-me-32 lg:basis-64">
        <summary class="title hover:marker:text-accent cursor-pointer text-lg">Table of Contents</summary>
        <nav class="ms-4 lg:w-full">
            <ol class="mt-4">
                {toc.map((heading) => <TOCHeading heading={heading} />)}
            </ol>
        </nav>
    </details>
)}

<style>
    summary {
        list-style: none;
    }
    summary::-webkit-details-marker {
        display: none;
    }
</style>