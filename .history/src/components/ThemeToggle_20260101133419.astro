<style>
    /* ==================================
       1. VARIABLES MAPPING
       Map your 'theme-bright-sun' to the generic variables Lene uses.
    ================================== */
    :global(:root) {
        --color-primary: var(--theme-bright-sun, #facc15); /* Yellow */
        --color-text: #1a1a1a;
        --color-bg: #ffffff;
    }

    :global([data-theme="dark"]) {
        /* When OFF: Bulb is dim */
        --color-primary: rgba(255, 255, 255, 0.05); 
        --color-text: #525252;
        --color-bg: #27272a;
    }

    /* ==================================
       2. HANGING POSITION
    ================================== */
    custom-lightbulb {
        position: absolute;
        top: 0;
        right: 2rem; /* Move left/right here */
        z-index: 50;
        pointer-events: none; /* Let clicks pass through the container, catch on button */
    }

    .theme-toggle-btn {
        pointer-events: auto;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        transform-origin: 50% 0; /* Swing from top */
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    /* Swing on hover */
    .theme-toggle-btn:hover {
        transform: rotate(3deg);
    }
    .theme-toggle-btn:active {
        transform: translateY(2px);
    }

    /* ==================================
       3. BULB STATES (ON/OFF)
    ================================== */
    /* By default (Light mode), Rays are visible but transparent */
    .bulb-rays {
        opacity: 0.6; /* ----> CHANGED THIS VALUE (adjust between 0.1 and 1.0) */
        transition: opacity 0.3s ease;
    }

    /* In Dark mode, Rays are hidden */
    :global([data-theme="dark"]) .bulb-rays {
        opacity: 0;
    }

    /* Pendulum Swing Animation */
    :global(.pendulum) {
        transform-origin: 50% 0;
        animation: swing 1s ease-in-out forwards;
    }

    @keyframes swing {
        0% { transform: rotate(0deg); }
        25% { transform: rotate(5deg); }
        50% { transform: rotate(-3deg); }
        75% { transform: rotate(2deg); }
        100% { transform: rotate(0deg); }
    }

    @media (max-width: 768px) {
        custom-lightbulb {
            right: 1rem;
            transform: scale(0.8);
            transform-origin: top right;
        }
    }
</style>

<script>
    // Import your existing helper if you want, or use this self-contained logic
    // matching Lene's logic exactly.

    class CustomLightbulb extends HTMLElement {
        constructor() {
            super();
            this.storageKey = "theme-preference";
            this.button = this.querySelector("button");
            this.svg = this.querySelector("svg");
            this.currentTheme = "light";
        }

        connectedCallback() {
            this.currentTheme = this.getColorPreference();
            // Sync initial state without animation
            this.reflectPreference(); 

            this.button.addEventListener("click", () => this.toggleTheme());
            
            window.matchMedia("(prefers-color-scheme: dark)")
                  .addEventListener("change", this.handleSystemThemeChange.bind(this));
        }

        toggleTheme() {
            this.currentTheme = this.currentTheme === "light" ? "dark" : "light";
            this.updateTheme();
        }

        handleSystemThemeChange(e) {
            this.currentTheme = e.matches ? "dark" : "light";
            this.updateTheme();
        }

        getColorPreference() {
            if (localStorage.getItem(this.storageKey)) {
                return localStorage.getItem(this.storageKey);
            }
            return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        updateTheme() {
            // 1. Update Persistence
            localStorage.setItem(this.storageKey, this.currentTheme);
            
            // 2. Trigger the "Pendulum" swing animation
            this.triggerPendulumEffect();
            
            // 3. Reflect the changes
            this.reflectPreference();
        }

        reflectPreference() {
            // Set global data-theme (for CSS)
            document.documentElement.setAttribute("data-theme", this.currentTheme);
            
            if (this.currentTheme === "dark") {
                document.documentElement.classList.add("dark");
                this.button.setAttribute("aria-pressed", "true");
                this.button.setAttribute("aria-label", "Switch to light theme");
            } else {
                document.documentElement.classList.remove("dark");
                this.button.setAttribute("aria-pressed", "false");
                this.button.setAttribute("aria-label", "Switch to dark theme");
            }
        }

        triggerPendulumEffect() {
            if (this.svg) {
                this.svg.classList.remove("pendulum");
                // Force reflow
                void this.svg.offsetWidth;
                this.svg.classList.add("pendulum");
            }
        }
    }

    customElements.define("custom-lightbulb", CustomLightbulb);
</script>