    </button>
</custom-lightbulb>

<style>
    /* Theme Logic:
       - Dark Mode: HIDE #lightcircle (The big glow). 
                    The #innerbulb (glass) stays visible but transparent fill.
       - Light Mode: Show the rays (#lightlines).
    */
    :global([data-theme="dark"]) #lightcircle {
        opacity: 0;
    }
    
    :global([data-theme="dark"]) #innerbulb {
        fill: transparent;
        stroke: currentColor;
        stroke-width: 2px;
        opacity: 0.5;
    }
    
    /* Ensure the bulb casing color matches background */
    :root { --color-bg-toggle: #ffffff; }
    :global([data-theme="dark"]) { --color-bg-toggle: #1a1810; }

    :global([data-theme="light"]) #lightlines {
        opacity: 1;
    }

    /* Pendulum Swing Animation */
    :global(.pendulum) {
        animation: swing 1s ease-in-out forwards;
        transform-origin: 50% 0;
    }

    @keyframes swing {
        0% { transform: rotate(0deg); }
        25% { transform: rotate(15deg); }
        50% { transform: rotate(-10deg); }
        75% { transform: rotate(5deg); }
        100% { transform: rotate(0deg); }
    }
</style>

<script>
    class CustomLightbulb extends HTMLElement {
        constructor() {
            super();
            this.button = this.querySelector("button");
            this.svg = this.querySelector("svg");
            // Random bright colors for Light Mode "On" state
            this.colors = ["#ffd700","#ebdf22","#d5e73f","#bded59","#a2f372","#82f88b","#5cfca3","#1cfebc","#00ffd3","#00fde9","#00fbfc","#00f6ff","#67eeff","#8ae8ff","#9ee3ff","#ace0ff","#b7dcff","#c1d9ff","#cad6ff","#d3d2ff","#ddceff","#e8c9ff","#f6c3ff","#ffbaff","#ffbbf8","#ffbee8","#ffc0dc","#ffc2d1","#ffc3c7","#ffc5be","#ffc6b4","#ffc7a9","#ffc99b","#ffca8a","#ffcc6f","#ffcf35"];
        }

        connectedCallback() {
            const theme = localStorage.getItem("theme-preference") || 
                         (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            
            this.setTheme(theme, false);

            this.button.addEventListener("click", () => {
                const current = document.documentElement.getAttribute("data-theme");
                const next = current === "light" ? "dark" : "light";
                this.setTheme(next, true);
            });
        }

        setTheme(theme, animate) {
            document.documentElement.setAttribute("data-theme", theme);
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }

            localStorage.setItem("theme-preference", theme);
            this.button.setAttribute("aria-pressed", theme === "dark");
            
            if (theme === "light") {
                const randomColor = this.colors[Math.floor(Math.random() * this.colors.length)];
                document.documentElement.style.setProperty("--color-primary", randomColor);
            }

            if (animate && this.svg) {
                this.svg.classList.remove("pendulum");
                void this.svg.offsetWidth; 
                this.svg.classList.add("pendulum");
            }
        }
    }
    customElements.define("custom-lightbulb", CustomLightbulb);
</script>