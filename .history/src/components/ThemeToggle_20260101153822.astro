---
// src/components/ThemeToggle.astro
---

<theme-toggle>
    <button class="theme-toggle-btn" type="button" aria-label="Toggle Dark Mode">
        <span class="sr-only">Dark Theme</span>
        
        {/* SVG DEFAULT SIZE: Set to the Large Desktop size (133x281).
            CSS will shrink this for smaller screens.
        */}
        <svg width="133" height="281" viewBox="0 0 133 281" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="lightbulb">
            <g id="bulb">
                {/* Glow/Light Circle */}
                <ellipse id="lightcircle" cx="66.5" cy="213.5" rx="66.5" ry="67.5" fill="var(--bulb-primary)" class="bulb-glow" />
                
                {/* The Wire - Clicks pass through */}
                <path id="Line 1" stroke="var(--bulb-text)" stroke-width="2" d="M73-5v179" />
                
                {/* The Main Bulb - Clickable */}
                <g id="mainbulb">
                    <path id="innerbulb" d="M57.278 213.158c0 8.475 6.87 15.345 15.345 15.345 8.474 0 15.344-6.869 15.344-15.345 0-5.511-3.67-10.111-4.551-11.688-.882-1.579-1.56-4.058-1.681-5.574-.4-4.957-4.08-9.113-9.112-9.113-5.031 0-8.392 4.076-9.111 9.113-.215 1.507-.64 3.996-1.681 5.574-1.014 1.537-4.553 6.177-4.553 11.688Z" fill="var(--bulb-primary)" />
                    <g id="regular">
                        <path d="M66.523 183.78s-.663-6.329 5.167-6.435c5.83-.107 8.587 2.745 8.017 3.885-.57 1.141-.692 1.595-.692 1.595s2.584 1.407 1.163 3.138c-1.422 1.731-2.278 2.491-2.278 2.491s-2.475-2.675-5.277-1.671c-2.802 1.006-5.959 2.712-5.959 2.712s-3.153-3.547-.14-5.715Z" fill="var(--bulb-bg)" />
                        <path d="M67.385 177.356c-.346-1.695 1.683-3.539 4.531-4.121 2.849-.582 5.437.319 5.784 2.013.346 1.694-1.495 1.607-4.342 2.189-2.848.582-5.627 1.613-5.973-.081Z" fill="var(--bulb-text)" />
                        <path d="M65.145 188.523c-.515-2.791 2.368-5.192 6.738-6.002 4.264-.79 8.087.135 8.601 2.923" stroke="var(--bulb-text)" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M85.614 208.644c0 9.822-7.962 17.784-17.784 17.784a17.697 17.697 0 0 1-9.897-3.008c3.192 4.757 8.618 7.887 14.776 7.887 9.822 0 17.784-7.962 17.784-17.784 0-6.158-3.13-11.584-7.886-14.776a17.695 17.695 0 0 1 3.007 9.897Z" fill="var(--bulb-bg)" />
                        <path d="M78.773 189.094s1.325-.769 1.405-3.131c.056-1.699-1.163-3.138-1.163-3.138s.927-1.038.538-2.743c-.521-2.292-3.99-3.529-7.863-2.737-3.871.791-6.022 2.328-5.931 4.678.039 1.023.765 1.757.765 1.757s-1.455 1.159-1.455 3.285c0 1.85 1.728 2.029 1.728 2.029" stroke="var(--bulb-text)" stroke-width="3" stroke-miterlimit="10" />
                        <path d="M66.169 187.925c-1.736 1.767-2.871 4.433-3.264 7.187-.23 1.607-.683 4.263-1.794 5.946-1.082 1.639-4.856 6.589-4.856 12.468 0 9.04 7.328 16.367 16.367 16.367s16.367-7.328 16.367-16.367c0-5.879-3.915-10.785-4.856-12.468-.94-1.683-1.663-4.327-1.793-5.946-.233-2.89-1.513-5.527-3.502-7.322" stroke="var(--bulb-text)" stroke-width="2" stroke-miterlimit="10" stroke-linejoin="round" />
                        <path d="M82.766 197.078c-.439-5.582-4.47-10.265-9.98-10.265-5.512 0-9.194 4.594-9.981 10.265" stroke="var(--bulb-text)" stroke-width="1.8" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M70.159 187.868v16.263l-3.992 8.498H79.08l-3.992-8.498v-16.263" stroke="var(--bulb-text)" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                    </g>
                    {/* Light Rays */}
                    <g id="lightlines" class="bulb-rays" stroke="var(--bulb-text)" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M98.005 212.106h5.351" />
                        <path d="M42.293 212.106h5.351" />
                        <path d="m90.63 229.912 3.784 3.784" />
                        <path d="m51.235 190.515 3.784 3.786" />
                        <path d="m55.02 229.912-3.785 3.784" />
                        <path d="m94.414 190.515-3.784 3.786" />
                    </g>
                </g>
            </g>
        </svg>
    </button>
</theme-toggle>

<style>
    /* ==================================
       THEME VARIABLES
    ================================== */
    :global(:root) {
        --bulb-primary: var(--theme-bright-sun, #facc15);
        --bulb-text: #1a1a1a;
        --bulb-bg: #ffffff;
    }
    
    :global([data-theme="dark"]) {
        --bulb-primary: rgba(255, 255, 255, 0.05);
        --bulb-text: #525252;
        --bulb-bg: #27272a;
    }

    /* ==================================
       POSITIONING & BUTTON STYLES
    ================================== */
    
    /* DEFAULT: LARGE SCREENS (Desktop) */
    .theme-toggle-btn {
        position: absolute;
        top: -12.5%; /* Long wire */
        right: 1.5rem;
        z-index: 50;
        
        pointer-events: none; /* Disable clicks on container */

        background: none;
        border: none;
        padding: 0;
        margin: 0;
        transform-origin: 50% 0;
        transition: transform 0.3s ease;
        outline: none;
    }
    
    /* DEFAULT: FULL SIZE BULB */
    .lightbulb {
        width: 400px;
        height: 202px;
        transition: width 0.3s, height 0.3s;
    }

    /* ==================================
       MEDIA QUERY: MEDIUM & SMALL SCREENS
       (Tablets and Mobiles: < 1024px)
    ================================== */
    @media (max-width: 1024px) {
        .theme-toggle-btn {
            top: -40px; /* Shortened wire */
        }
        
        .lightbulb {
            width: 80px;   /* Shrink bulb width */
            height: 169px; /* Shrink bulb height */
        }
    }
    
    /* EXTRA SMALL ADJUSTMENT (Mobile) */
    @media (max-width: 640px) {
        .theme-toggle-btn {
            right: 1rem;
        }
    }

    /* FIX: Re-enable clicks ONLY on the bulb head */
    #mainbulb {
        pointer-events: auto; 
        cursor: pointer;
    }

    /* Swing on hover */
    .theme-toggle-btn:hover {
        transform: rotate(3deg);
    }
    
    .theme-toggle-btn:active {
        transform: translateY(2px);
    }

    /* ==================================
       STATE TRANSITIONS
    ================================== */
    .bulb-rays {
        transition: opacity 0.3s ease;
        opacity: 0.5; /* Transparent lines */
    }

    .bulb-glow {
        transition: opacity 0.3s ease;
        opacity: 0.5; /* Transparent glow */
    }

    :global([data-theme="dark"]) .bulb-rays {
        opacity: 0;
    }
</style>

<script>
    import { rootInDarkMode } from "@/utils/domElement";

    class ThemeToggle extends HTMLElement {
        constructor() {
            super();
            const button = this.querySelector("button");

            if (button) {
                button.setAttribute("role", "switch");
                button.setAttribute("aria-checked", String(rootInDarkMode()));

                button.addEventListener("click", () => {
                    const event = new CustomEvent("theme-change", {
                        detail: {
                            theme: rootInDarkMode() ? "light" : "dark",
                        },
                    });
                    document.dispatchEvent(event);
                    button.setAttribute("aria-checked", String(!rootInDarkMode()));
                });
            }
        }
    }

    customElements.define("theme-toggle", ThemeToggle);
</script>