---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Header from '../../components/curator/Header.astro';
import Hero from '../../components/curator/Hero.astro';
import ArchitectureDiagram from '../../components/curator/ArchitectureDiagram.astro';
import GrowthStrategy from '../../components/curator/GrowthStrategy.astro';
import Engine from '../../components/curator/Engine.astro';
import Applications from '../../components/curator/Applications.astro';
import Partners from '../../components/curator/Partners.astro';
import WhyLocal from '../../components/curator/WhyLocal.astro';
import Contact from '../../components/curator/Contact.astro';
import FinalCta from '../../components/curator/FinalCta.astro';
import Footer from '../../components/curator/Footer.astro';
---

<LandingLayout
  title="Curator — Local-first AI infrastructure for education"
  description="Curator builds open-source, local-first AI infrastructure that lets schools and studios run intelligent workflows on their own knowledge."
>
  <Header />

  <!-- Orange wave SVG beneath nav bar -->
  <div aria-hidden="true" style="width: 100%; overflow: hidden; line-height: 0; margin-top: -1px;">
    <img
      src="/images/curator/signal-wave-header.svg"
      alt=""
      style="width: 100%; height: auto; display: block; opacity: 0.6;"
    />
  </div>

  <main id="top" style="position: relative; overflow: hidden;">
    <!-- Decorative background orbs -->
    <div aria-hidden="true" style="position: absolute; top: 15%; left: 5%; width: 200px; height: 200px; background: rgba(232,115,47,0.06); border-radius: 24px; z-index: 0; pointer-events: none;"></div>
    <div aria-hidden="true" style="position: absolute; top: 40%; right: 8%; width: 300px; height: 300px; background: rgba(232,115,47,0.04); border-radius: 50%; z-index: 0; pointer-events: none;"></div>
    <div aria-hidden="true" style="position: absolute; top: 60%; left: 12%; width: 160px; height: 160px; background: rgba(220,100,80,0.05); border-radius: 20px; z-index: 0; pointer-events: none;"></div>
    <div aria-hidden="true" style="position: absolute; top: 25%; right: 20%; width: 120px; height: 120px; background: rgba(232,115,47,0.05); border-radius: 50%; z-index: 0; pointer-events: none;"></div>
    <div aria-hidden="true" style="position: absolute; bottom: 20%; left: 40%; width: 240px; height: 240px; background: rgba(232,115,47,0.04); border-radius: 28px; z-index: 0; pointer-events: none;"></div>
    <div aria-hidden="true" style="position: absolute; top: 75%; right: 5%; width: 180px; height: 180px; background: rgba(220,100,80,0.05); border-radius: 50%; z-index: 0; pointer-events: none;"></div>

    <Hero />
    <ArchitectureDiagram />
    <GrowthStrategy />
    <Engine />
    <Applications />
    <Partners />
    <WhyLocal />
    <Contact />
    <FinalCta />
  </main>

<style>
  #top > section,
  #top > .architecture-section,
  #top > div:not([aria-hidden]) {
    position: relative;
    z-index: 1;
  }
</style>

  <Footer />
</LandingLayout>
