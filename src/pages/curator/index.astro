---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Header from '../../components/curator/Header.astro';
import Hero from '../../components/curator/Hero.astro';
import ArchitectureDiagram from '../../components/curator/ArchitectureDiagram.astro';
import GrowthStrategy from '../../components/curator/GrowthStrategy.astro';
import Engine from '../../components/curator/Engine.astro';
import Applications from '../../components/curator/Applications.astro';
import Partners from '../../components/curator/Partners.astro';
import WhyLocal from '../../components/curator/WhyLocal.astro';
import Contact from '../../components/curator/Contact.astro';
import FinalCta from '../../components/curator/FinalCta.astro';
import Footer from '../../components/curator/Footer.astro';
---

<LandingLayout
  title="Curator — Local-first AI infrastructure for education"
  description="Curator builds open-source, local-first AI infrastructure that lets schools and studios run intelligent workflows on their own knowledge."
>
  <Header />

  <!-- Orange wave SVG beneath nav bar -->
  <div aria-hidden="true" style="width: 100%; overflow: hidden; line-height: 0; margin-top: -1px;">
    <img
      src="/images/curator/signal-wave-header.svg"
      alt=""
      style="width: 100%; height: auto; display: block; opacity: 0.6;"
    />
  </div>

  <main id="top" style="position: relative; overflow: hidden;">
    <!-- Decorative orbs — one per section, behind content -->
    <!-- Hero area -->
    <div aria-hidden="true" style="position: absolute; top: 4%; left: 50%; transform: translateX(-50%); width: 400px; height: 400px; background: rgba(232,115,47,0.03); border-radius: 50%; z-index: 0; pointer-events: none;"></div>
    <!-- Architecture stack -->
    <div aria-hidden="true" style="position: absolute; top: 16%; left: 8%; width: 340px; height: 340px; background: rgba(232,115,47,0.04); border-radius: 32px; z-index: 0; pointer-events: none;"></div>
    <!-- Growth strategy -->
    <div aria-hidden="true" style="position: absolute; top: 30%; right: 6%; width: 280px; height: 280px; background: rgba(220,100,80,0.04); border-radius: 50%; z-index: 0; pointer-events: none;"></div>
    <!-- Engine / Platform -->
    <div aria-hidden="true" style="position: absolute; top: 48%; left: 5%; width: 400px; height: 400px; background: rgba(232,115,47,0.03); border-radius: 28px; z-index: 0; pointer-events: none;"></div>
    <!-- Applications -->
    <div aria-hidden="true" style="position: absolute; top: 62%; right: 10%; width: 240px; height: 240px; background: rgba(220,100,80,0.04); border-radius: 50%; z-index: 0; pointer-events: none;"></div>
    <!-- Partners / Page 3 -->
    <div aria-hidden="true" style="position: absolute; top: 76%; left: 50%; transform: translateX(-50%); width: 380px; height: 380px; background: rgba(232,115,47,0.03); border-radius: 36px; z-index: 0; pointer-events: none;"></div>
    <!-- Contact area -->
    <div aria-hidden="true" style="position: absolute; top: 92%; right: 12%; width: 260px; height: 260px; background: rgba(220,100,80,0.04); border-radius: 32px; z-index: 0; pointer-events: none;"></div>

    <Hero />
    <ArchitectureDiagram />
    <GrowthStrategy />
    <Engine />
    <Applications />
    <Partners />
    <WhyLocal />
    <Contact />
    <FinalCta />
  </main>

<style>
  #top > section,
  #top > .architecture-section,
  #top > div:not([aria-hidden]) {
    position: relative;
    z-index: 1;
  }
</style>

  <Footer />
</LandingLayout>
