---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Header from '../../components/curator/Header.astro';
import Hero from '../../components/curator/Hero.astro';
import ArchitectureDiagram from '../../components/curator/ArchitectureDiagram.astro';
import GrowthStrategy from '../../components/curator/GrowthStrategy.astro';
import Engine from '../../components/curator/Engine.astro';
import Applications from '../../components/curator/Applications.astro';
import Partners from '../../components/curator/Partners.astro';
import WhyLocal from '../../components/curator/WhyLocal.astro';
import Contact from '../../components/curator/Contact.astro';
import FinalCta from '../../components/curator/FinalCta.astro';
import Footer from '../../components/curator/Footer.astro';
---

<LandingLayout
  title="Curator — Local-first AI infrastructure for education"
  description="Curator builds open-source, local-first AI infrastructure that lets schools and studios run intelligent workflows on their own knowledge."
>
  <Header />

  <!-- Orange wave SVG beneath nav bar -->
  <div aria-hidden="true" style="width: 100%; overflow: hidden; line-height: 0; margin-top: -1px;">
    <img
      src="/images/curator/signal-wave-header.svg"
      alt=""
      style="width: 100%; height: auto; display: block; opacity: 0.6;"
    />
  </div>

  <main id="top" style="position: relative; overflow: hidden;">
    <!-- Decorative orbs — one per section, behind content -->
    <!-- Architecture stack -->
    <div aria-hidden="true" style="position: absolute; top: 8%; left: 8%; width: 300px; height: 300px; background: rgba(232,115,47,0.04); border-radius: 32px; z-index: 0; pointer-events: none;"></div>
    <!-- Growth strategy -->
    <div aria-hidden="true" style="position: absolute; top: 22%; right: 6%; width: 240px; height: 240px; background: rgba(220,100,80,0.04); border-radius: 50%; z-index: 0; pointer-events: none;"></div>
    <!-- Engine / Platform -->
    <div aria-hidden="true" style="position: absolute; top: 42%; left: 5%; width: 360px; height: 360px; background: rgba(232,115,47,0.03); border-radius: 28px; z-index: 0; pointer-events: none;"></div>
    <!-- Applications -->
    <div aria-hidden="true" style="position: absolute; top: 58%; right: 10%; width: 200px; height: 200px; background: rgba(220,100,80,0.04); border-radius: 50%; z-index: 0; pointer-events: none;"></div>
    <!-- Partners / Page 3 -->
    <div aria-hidden="true" style="position: absolute; top: 72%; left: 50%; transform: translateX(-50%); width: 340px; height: 340px; background: rgba(232,115,47,0.03); border-radius: 36px; z-index: 0; pointer-events: none;"></div>
    <!-- WhyLocal / About -->
    <div aria-hidden="true" style="position: absolute; top: 88%; right: 8%; width: 220px; height: 220px; background: rgba(220,100,80,0.04); border-radius: 50%; z-index: 0; pointer-events: none;"></div>

    <Hero />
    <ArchitectureDiagram />
    <GrowthStrategy />
    <Engine />
    <Applications />
    <Partners />
    <WhyLocal />
    <Contact />
    <FinalCta />
  </main>

<style>
  #top > section,
  #top > .architecture-section,
  #top > div:not([aria-hidden]) {
    position: relative;
    z-index: 1;
  }
</style>

  <Footer />
</LandingLayout>
