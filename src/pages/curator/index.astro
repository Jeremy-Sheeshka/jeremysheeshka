---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Header from '../../components/curator/Header.astro';
import Hero from '../../components/curator/Hero.astro';
import GrowthStrategy from '../../components/curator/GrowthStrategy.astro';
import Engine from '../../components/curator/Engine.astro';
import Applications from '../../components/curator/Applications.astro';
import Partners from '../../components/curator/Partners.astro';
import WhyLocal from '../../components/curator/WhyLocal.astro';
import Contact from '../../components/curator/Contact.astro';
import FinalCta from '../../components/curator/FinalCta.astro';
import Footer from '../../components/curator/Footer.astro';
---

