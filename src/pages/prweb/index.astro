---
import PrinceRupertLayout from "@/layouts/PrinceRupertLayout.astro";
---

<PrinceRupertLayout
  title="Prince Rupert Web Design — North Coast Websites That Work"
  description="Prince Rupert Web Design builds beautiful, fast websites for small businesses with big ideas on BC's North Coast. Subscription plans from $99/month."
  mobileCta
>

  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <img
      class="hero-bg"
      src="/images/prweb/skeena-river.svg"
      data-swap="/images/prweb/skeena-river-fog.svg"
      alt="Abstracted Skeena River at sunset, flowing toward the harbour"
      data-sound="wave"
    />
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-badge" data-sound="chime-high">Prince Rupert · British Columbia</div>
      <h1 data-sound="wave">Invest in Yourself. Success is only a click away.</h1>
      <p data-sound="gull">Creating online experiences for small business owners with big ideas — built on the North Coast, for the North Coast.</p>
      <div class="hero-cta">
        <a href="#quote" class="btn btn-salmon btn-lg" data-sound="chime">Get a Quote</a>
        <a href="#services" class="btn btn-outline btn-lg" data-sound="chime-low">See Our Services</a>
      </div>
    </div>
  </section>

  <!-- ============ WELCOME ============ -->
  <section class="section" id="welcome">
    <div class="container">
      <div class="welcome-grid">
        <div class="welcome-copy reveal">
          <div class="badge">Welcome</div>
          <h2>Welcome to Prince Rupert Web Design</h2>
          <h3>Experienced Web Design Professionals with a Passion for Delivering Excellence.</h3>
          <p>
            Prince Rupert Web Design is a North Coast web design company. We help business owners local
            and far build their businesses better and take their company to the next level. Our team is
            dedicated to providing exceptional web design services tailored to your unique needs, ensuring
            your online presence stands out from the competition.
          </p>
          <p>
            From the harbour to the Skeena, we know what it takes for a business to thrive here — and we
            put that into every site we build.
          </p>
        </div>
        <div class="welcome-art reveal" data-sound="gull">
          <img
            src="/images/prweb/container-ship.svg"
            data-swap="/images/prweb/container-ship-night.svg"
            alt="Container ship at Prince Rupert's deep-water port"
          />
          <div class="art-caption">The Prince Rupert container port — connecting the North Coast to the world.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ OUR SERVICES EMPOWER YOU TO ============ -->
  <section class="section section-alt" id="empower">
    <div class="container">
      <div class="section-header reveal">
        <div class="badge">What we do</div>
        <h2>Our Services Empower You to</h2>
      </div>
      <div class="empower-list">
        <div class="empower-item reveal" data-sound="chime">
          <div class="empower-num">01</div>
          <h4>Enhance Your Business.</h4>
          <p>A website that presents your business at its best — clear, fast, and built to convert visitors into customers.</p>
        </div>
        <div class="empower-item reveal" data-sound="chime-high">
          <div class="empower-num">02</div>
          <h4>Elevate Your Brand.</h4>
          <p>Colours, typography and design that reflect the quality of your work and make your business unforgettable.</p>
        </div>
        <div class="empower-item reveal" data-sound="chime-low">
          <div class="empower-num">03</div>
          <h4>Grow Your Investment.</h4>
          <p>Search engine optimisation and ongoing care that keep your website working for you, month after month.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLIENT STORIES ============ -->
  <section class="section" id="stories">
    <div class="container">
      <div class="section-header reveal">
        <div class="badge">Client Stories</div>
        <h2>North Coast businesses, better online</h2>
      </div>
      <div class="testimonial-slider reveal" data-sound="wave">
        <div class="testimonial-track">
          <div class="testimonial-slide">
            <p class="testimonial-quote">"Prince Rupert Web Design exceeded my expectations with their exceptional web design services. Their attention to detail and creativity truly set them apart."</p>
            <p class="testimonial-author">Mark Stevens, BC</p>
            <p class="testimonial-role">Harbour-view restaurant owner</p>
          </div>
          <div class="testimonial-slide">
            <p class="testimonial-quote">"Our new website brought in more bookings in the first month than we'd had all year. They understood exactly what our guests needed to see."</p>
            <p class="testimonial-author">Sarah &amp; Dan, BC</p>
            <p class="testimonial-role">Lodge &amp; adventure outfitters</p>
          </div>
          <div class="testimonial-slide">
            <p class="testimonial-quote">"Fast, friendly, and local. They answered our questions on a Sunday and had our shop online by Friday. Couldn't recommend them more."</p>
            <p class="testimonial-author">James W., BC</p>
            <p class="testimonial-role">Retail &amp; fishing supplies</p>
          </div>
        </div>
        <div class="testimonial-nav" role="tablist" aria-label="Testimonials">
          <button class="testimonial-dot active" aria-label="Story 1"></button>
          <button class="testimonial-dot" aria-label="Story 2"></button>
          <button class="testimonial-dot" aria-label="Story 3"></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section section-alt" id="services">
    <div class="container">
      <div class="section-header reveal">
        <div class="badge">Services</div>
        <h2>Our Services Include <br><span style="font-size: 1.1rem; font-weight: 400; color: var(--pr-text-muted);">(but are not limited to)</span></h2>
      </div>
      <div class="services-grid">
        <div class="service-tile reveal" data-sound="chime"><div class="tile-icon">🖥️</div>Design &amp; creation of website (5 pages)</div>
        <div class="service-tile reveal" data-sound="chime-high"><div class="tile-icon">🔍</div>Search Engine Optimisation (SEO)</div>
        <div class="service-tile reveal" data-sound="chime-low"><div class="tile-icon">🛠️</div>Monthly Maintenance</div>
        <div class="service-tile reveal" data-sound="chime"><div class="tile-icon">📞</div>3 On-Call Adjustments</div>
        <div class="service-tile reveal" data-sound="chime-high"><div class="tile-icon">📋</div>Submission Forms</div>
        <div class="service-tile reveal" data-sound="chime-low"><div class="tile-icon">💳</div>Pricing Plans</div>
        <div class="service-tile reveal" data-sound="chime"><div class="tile-icon">✍️</div>Blog Creation</div>
        <div class="service-tile reveal" data-sound="chime-high"><div class="tile-icon">🗓️</div>Blog Management</div>
      </div>
    </div>
  </section>

  <!-- ============ SUBSCRIPTIONS ============ -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="section-header reveal">
        <div class="badge">Subscriptions</div>
        <h2>Subscription based services starting at $99 a month.</h2>
        <p>No minimum. No obligation. Cancel anytime.</p>
      </div>
      <div class="pricing-grid">
        <div class="pricing-card reveal" data-sound="chime">
          <div class="pricing-icon">🎨</div>
          <h4>Design</h4>
          <div class="pricing-price">$99<span>/month</span></div>
          <p>Colours, fonts and other designs are the basic foundation to marketing. Let the experts handle this — we'll keep your site looking sharp and on-brand.</p>
          <a href="#quote" class="btn btn-outline" style="color: var(--pr-teal); border-color: var(--pr-aqua);">Get Started</a>
        </div>
        <div class="pricing-card featured reveal" data-sound="chime-high">
          <div class="price-badge">Most Popular</div>
          <div class="pricing-icon">🛠️</div>
          <h4>Monthly Maintenance</h4>
          <div class="pricing-price">$199<span>/month</span></div>
          <p>Maintaining your website shouldn't be your job. Focus on what you do best, and let us handle the rest — updates, backups, security, and on-call adjustments.</p>
          <a href="#quote" class="btn btn-primary">Get Started</a>
        </div>
        <div class="pricing-card reveal" data-sound="chime-low">
          <div class="pricing-icon">🚀</div>
          <h4>SEO</h4>
          <div class="pricing-price">$149<span>/month</span></div>
          <p>Search engine optimisation is the #1 way to increase site traffic, bringing more customers to your business. We'll get you found on Google.</p>
          <a href="#quote" class="btn btn-outline" style="color: var(--pr-teal); border-color: var(--pr-aqua);">Get Started</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AS FEATURED IN ============ -->
  <section class="section section-dark" id="featured">
    <div class="container">
      <div class="section-header reveal">
        <div class="badge">As Featured In</div>
        <h2>Trusted across the North Coast</h2>
      </div>
      <div class="featured-strip reveal">
        <span class="featured-logo" data-sound="chime">North Coast Business Journal</span>
        <span class="featured-logo" data-sound="chime-high">Harbour Radio</span>
        <span class="featured-logo" data-sound="chime-low">The Daily News</span>
        <span class="featured-logo" data-sound="chime">Ridley Terminals</span>
        <span class="featured-logo" data-sound="chime-high">CityWest</span>
      </div>
    </div>
  </section>

  <!-- ============ GET A QUOTE ============ -->
  <section class="section section-dark" id="quote" style="padding-top: 0;">
    <div class="container">
      <div class="quote-grid">
        <div class="quote-copy reveal">
          <h3>Get a Quote!</h3>
          <p>Tell us about your business and we'll send you a free, no-obligation quote within one business day.</p>
          <div class="quote-points">
            <div class="quote-point" data-sound="chime">
              <div class="qp-icon">⚡</div>
              <div><strong>Fast turnaround</strong><span>Most new sites are live within two weeks.</span></div>
            </div>
            <div class="quote-point" data-sound="chime-high">
              <div class="qp-icon">🤝</div>
              <div><strong>Local &amp; friendly</strong><span>Real people in Prince Rupert, ready to help.</span></div>
            </div>
            <div class="quote-point" data-sound="chime-low">
              <div class="qp-icon">🔒</div>
              <div><strong>No obligation</strong><span>Free quote, cancel anytime, no minimums.</span></div>
            </div>
          </div>
        </div>
        <form class="quote-form reveal" data-endpoint="" novalidate>
          <div class="form-group">
            <label for="quote-name">First name</label>
            <input type="text" id="quote-name" name="name" placeholder="Your name" required>
          </div>
          <div class="form-group">
            <label for="quote-email">Email</label>
            <input type="email" id="quote-email" name="email" placeholder="Enter your email here" required>
          </div>
          <div class="form-group">
            <label for="quote-service">Services Needed</label>
            <select id="quote-service" name="service">
              <option value="New website">New website</option>
              <option value="Website redesign">Website redesign</option>
              <option value="Monthly maintenance">Monthly maintenance</option>
              <option value="SEO">Search engine optimisation (SEO)</option>
              <option value="Blog setup / management">Blog setup / management</option>
              <option value="Not sure yet">Not sure yet — help me decide</option>
            </select>
          </div>
          <div class="form-group">
            <label for="quote-message">Tell us about your business (optional)</label>
            <textarea id="quote-message" name="message" rows="3" placeholder="A few words about what you do…"></textarea>
          </div>
          <div class="form-group checkbox-group">
            <input type="checkbox" id="quote-newsletter" name="newsletter" checked>
            <label for="quote-newsletter">Yes, subscribe me to your newsletter.</label>
          </div>
          <button type="submit" class="btn btn-salmon btn-lg" style="width: 100%;" data-sound="chime-high">Send</button>
          <div class="form-status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section" id="contact">
    <div class="container">
      <div class="section-header reveal">
        <div class="badge">Find Us</div>
        <h2>Get in Touch to Elevate Your Online Presence</h2>
      </div>
      <div class="contact-grid">
        <div class="contact-card reveal" data-sound="chime">
          <div class="contact-icon">📍</div>
          <h4>Visit</h4>
          <p>Prince Rupert, BC<br>Canada</p>
        </div>
        <div class="contact-card reveal" data-sound="chime-high">
          <div class="contact-icon">📧</div>
          <h4>Email</h4>
          <p>hello@princerupertwebdesign.ca</p>
        </div>
        <div class="contact-card reveal" data-sound="chime-low">
          <div class="contact-icon">🌊</div>
          <h4>Serving</h4>
          <p>Prince Rupert, Port Edward, Terrace, Kitimat &amp; the North Coast</p>
        </div>
      </div>
    </div>
  </section>

</PrinceRupertLayout>
