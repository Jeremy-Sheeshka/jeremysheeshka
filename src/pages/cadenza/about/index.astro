---
import LandingLayout from "../../../layouts/LandingLayout.astro";
---

<LandingLayout title="About | Cadenza Studio" description="Built by a teacher, not around one. Learn about Cadenza Studio.">


  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a href="/cadenza" class="nav-logo">
        <img src="/images/cadenza/logo.png" alt="Cadenza Studio Logo">
        Cadenza Studio
      </a>
      <div class="nav-links">
        <a href="/cadenza/features" class="nav-link">Features</a>
        <a href="/cadenza/pricing" class="nav-link">Pricing</a>
        <a href="/cadenza/solutions" class="nav-link">Solutions</a>
        <a href="/cadenza/about" class="nav-link">About</a>
        <a href="/cadenza/contact" class="nav-link">Contact</a>
      </div>
      <div class="nav-cta">
        <a href="/cadenza-app" class="btn btn-primary">Get Started</a>
      </div>
      <button class="mobile-menu-btn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu">
    <a href="/cadenza/features" class="nav-link">Features</a>
    <a href="/cadenza/pricing" class="nav-link">Pricing</a>
    <a href="/cadenza/solutions" class="nav-link">Solutions</a>
    <a href="/cadenza/about" class="nav-link">About</a>
    <a href="/cadenza/contact" class="nav-link">Contact</a>
  </div>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>Built by a teacher, not around one.</h1>
    </div>
  </section>

  <!-- Our Story -->
  <section class="section">
    <div class="container">
      <div style="max-width: 800px; margin: 0 auto;">
        <h2 style="margin-bottom: 1.5rem;">Our Story</h2>
        <p style="font-size: 1.125rem; line-height: 1.8; margin-bottom: 1.5rem;">Cadenza Studio didn't start as a business plan — it started as a working teacher's spreadsheet, calendar, and phone full of parent texts, teacher contacts, and leads. Today it runs the same studio it was built for, and its next step is a first pilot alongside other music teachers.</p>

        <div style="text-align: center; margin: 2.5rem 0;">
          <img
            src="/images/cadenza/headshot.jpg"
            alt="Jeremy Sheeshka — CEO & Founder of Cadenza Studio"
            style="width: 180px; height: 180px; border-radius: 50%; object-fit: cover; display: inline-block; box-shadow: 0 4px 20px rgba(0,0,0,0.12);"
          />
        </div>

        <h3 style="margin-top: 2rem; margin-bottom: 1rem;">Meet the Founder</h3>
        <p style="font-size: 1rem; line-height: 1.8; color: var(--color-text-secondary);"><strong>Jeremy Sheeshka — CEO & Founder.</strong> Jeremy is a K-12 music educator and MET student at UBC who is passionate about jazz guitar and educational technology. He is fascinated by building software, and learning about open-source technologies, which led to him to create Cadenza Studio after losing many evenings to inefficient paperwork and administrative processes.</p>
      </div>
    </div>
  </section>

  <!-- Our Mission -->
  <section class="section section-alt">
    <div class="container">
      <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <h2 style="margin-bottom: 1.5rem;">Our Mission</h2>
        <p style="font-size: 1.25rem; line-height: 1.8; color: var(--color-text);">To give music teachers back the hours spreadsheets and text threads were quietly taking, one studio at a time.</p>
        <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap;">
          <a href="/cadenza/features" class="btn btn-primary btn-lg">See what Cadenza Studio can do</a>
          <a href="/cadenza/contact" class="btn btn-secondary btn-lg">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Join our community of music teachers</h2>
      <p>Start using Cadenza Studio today and see the difference it makes.</p>
      <a href="/cadenza-app" class="btn btn-secondary btn-lg">Get Started Free</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/cadenza" class="nav-logo">
            <img src="/images/cadenza/logo.png" alt="Cadenza Studio Logo">
            Cadenza Studio
          </a>
          <p>The complete studio management platform for music teachers.</p>
          <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.5rem;"><a href="/curator" style="color: inherit; text-decoration: underline;">Built on Curator</a>, open, local-first AI for education.</p>
        </div>
        <div class="footer-column">
          <h4>Product</h4>
          <a href="/cadenza/features">Features</a>
          <a href="/cadenza/pricing">Pricing</a>
        </div>
        <div class="footer-column">
          <h4>Company</h4>
          <a href="/cadenza/about">About</a>
          <a href="/cadenza/contact">Contact</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Cadenza Studio. All rights reserved.</p>
        <div class="social-links">
          <a href="https://github.com/jeremysheeshka/Cadenza-Studio-App" class="social-link" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

</LandingLayout>
