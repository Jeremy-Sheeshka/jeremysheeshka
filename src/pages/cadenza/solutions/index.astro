---
import LandingLayout from "../../../layouts/LandingLayout.astro";
---

<LandingLayout title="Solutions for Music Teachers | Cadenza Studio" description="Studio management built for music teachers. Spend your evenings teaching, not rebuilding your week in a spreadsheet.">


  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a href="/cadenza" class="nav-logo">
        <img src="/images/cadenza/logo.png" alt="Cadenza Studio Logo">
        Cadenza Studio
      </a>
      <div class="nav-links">
        <a href="/cadenza/features" class="nav-link">Features</a>
        <a href="/cadenza/pricing" class="nav-link">Pricing</a>
        <a href="/cadenza/solutions" class="nav-link">Solutions</a>
        <a href="/cadenza/about" class="nav-link">About</a>
        <a href="/cadenza/contact" class="nav-link">Contact</a>
      </div>
      <div class="nav-cta">
        <a href="/cadenza-app" class="btn btn-primary">Get Started</a>
      </div>
      <button class="mobile-menu-btn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu">
    <a href="/cadenza/features" class="nav-link">Features</a>
    <a href="/cadenza/pricing" class="nav-link">Pricing</a>
    <a href="/cadenza/solutions" class="nav-link">Solutions</a>
    <a href="/cadenza/about" class="nav-link">About</a>
    <a href="/cadenza/contact" class="nav-link">Contact</a>
  </div>

  <!-- Video Hero -->
  <section style="position: relative; overflow: hidden; min-height: 400px; display: flex; align-items: center; justify-content: center;">
    <video
      autoplay loop muted playsinline
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; z-index: 0;"
    >
      <source src="/videos/herobannervideopiano.mp4" type="video/mp4" />
    </video>
    <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.55); z-index: 1;"></div>
    <div class="container" style="position: relative; z-index: 2; text-align: center; padding: 4rem 1rem;">
      <h1 style="color: #fff; font-size: 2.5rem; font-weight: 800;">Studio management built for music teachers</h1>
    </div>
  </section>

  <!-- App Screenshots -->
  <section class="section" style="padding-bottom: 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 1000px; margin: 0 auto;">
        <a href="/images/cadenza/cascaderesources.png" class="blog-lightbox" style="display: block; cursor: zoom-in;">
          <img
            src="/images/cadenza/cascaderesources.png"
            alt="Cadenza Studio resources and files interface"
            style="width: 100%; height: auto; border-radius: 0.75rem; box-shadow: 0 2px 16px rgba(0,0,0,0.08); display: block;"
          />
        </a>
        <a href="/images/cadenza/cascadecalendar.png" class="blog-lightbox" style="display: block; cursor: zoom-in;">
          <img
            src="/images/cadenza/cascadecalendar.png"
            alt="Cadenza Studio calendar and scheduling interface"
            style="width: 100%; height: auto; border-radius: 0.75rem; box-shadow: 0 2px 16px rgba(0,0,0,0.08); display: block;"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- How Cadenza Helps -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div class="badge">How Cadenza Studio helps</div>
        <h2>Purpose-built tools that make managing your studio effortless.</h2>
      </div>
      <div class="grid grid-2">
        <div class="feature-card">
          <div class="feature-card-icon">📅</div>
          <h4>Smart Scheduling</h4>
          <p>Recurring lessons, conflict detection, and a calendar built for back-to-back time slots.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">🔄</div>
          <h4>Automatic Makeup Tracking</h4>
          <p>Every owed lesson tracked automatically, nothing lives in your memory anymore.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">👨‍👩‍👧</div>
          <h4>Family Grouping</h4>
          <p>Siblings under one account, one shared bill, no duplicate entries.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">💬</div>
          <h4>Built-In Messaging</h4>
          <p>Practice reminders, recital updates, and progress reports sent directly, not repeated five times.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">🎯</div>
          <h4>Gamified Practice Tracking</h4>
          <p>Streaks and achievements that make a student want to open the app.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section" style="padding-bottom: 0;">
    <div class="container" style="max-width: 800px; margin: 0 auto;">
      <video
        controls
        preload="metadata"
        style="width: 100%; border-radius: 1rem; box-shadow: 0 4px 24px rgba(0,0,0,0.1);"
      >
        <source src="/videos/skeptics-checklist.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge">Frequently asked questions</div>
        <h2>Common questions from music teachers</h2>
      </div>
      <div style="max-width: 700px; margin: 0 auto;">
        <details class="faq-item" style="border-bottom: 1px solid #e5e1da; padding: 1.5rem 0;">
          <summary style="font-weight: 600; cursor: pointer; font-size: 1rem;">What is the best software for music teachers?</summary>
          <p style="margin-top: 1rem; color: #6b7280; line-height: 1.6;">Cadenza Studio is a studio management platform built specifically for music teachers, scheduling, student management, billing, messaging, portals, local AI, and gamified practice tracking, in one place.</p>
        </details>
        <details class="faq-item" style="border-bottom: 1px solid #e5e1da; padding: 1.5rem 0;">
          <summary style="font-weight: 600; cursor: pointer; font-size: 1rem;">How do music teachers manage their students?</summary>
          <p style="margin-top: 1rem; color: #6b7280; line-height: 1.6;">With software built for the job: student profiles, recurring scheduling, practice reminders, billing, and family communication, all from one platform instead of four.</p>
        </details>
        <details class="faq-item" style="border-bottom: 1px solid #e5e1da; padding: 1.5rem 0;">
          <summary style="font-weight: 600; cursor: pointer; font-size: 1rem;">Is there a free app for music teachers?</summary>
          <p style="margin-top: 1rem; color: #6b7280; line-height: 1.6;">Yes. Full scheduling, messaging, portals, practice tracking, and local AI, free, unlimited if self-hosted. No credit card required.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to simplify your music studio?</h2>
      <p>Join teachers saving hours every week with Cadenza Studio. Free to start, no credit card required.</p>
      <a href="/cadenza-app" class="btn btn-secondary btn-lg">Get Started Free</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/cadenza" class="nav-logo">
            <img src="/images/cadenza/logo.png" alt="Cadenza Studio Logo">
            Cadenza Studio
          </a>
          <p>The complete studio management platform for music teachers.</p>
          <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.5rem;"><a href="/curator" style="color: inherit; text-decoration: underline;">Built on Curator</a>, open, local-first AI for education.</p>
        </div>
        <div class="footer-column">
          <h4>Product</h4>
          <a href="/cadenza/features">Features</a>
          <a href="/cadenza/pricing">Pricing</a>
        </div>
        <div class="footer-column">
          <h4>Company</h4>
          <a href="/cadenza/about">About</a>
          <a href="/cadenza/contact">Contact</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Cadenza Studio. All rights reserved.</p>
        <div class="social-links">
          <a href="https://github.com/jeremysheeshka/Cadenza-Studio-App" class="social-link" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

</LandingLayout>
