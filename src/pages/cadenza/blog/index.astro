---
import LandingLayout from "../../layouts/LandingLayout.astro";
---

<LandingLayout title="Blog | Cadenza Studio" description="Tips, guides, and insights for music teachers.">


  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a href="/cadenza" class="nav-logo">
        <img src="/images/cadenza/logo-placeholder.svg" alt="Cadenza Studio Logo">
        Cadenza Studio
      </a>
      <div class="nav-links">
        <a href="/cadenza/features" class="nav-link">Features</a>
        <a href="/cadenza/pricing" class="nav-link">Pricing</a>
        <a href="/cadenza/solutions" class="nav-link">Solutions</a>
        <a href="/cadenza/blog" class="nav-link">Blog</a>
        <a href="/cadenza/compare" class="nav-link">Compare</a>
        <a href="/cadenza/about" class="nav-link">About</a>
      </div>
      <div class="nav-cta">
        
        <a href="/cadenza-app" class="btn btn-primary">Get Started</a>
      </div>
      <button class="mobile-menu-btn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu">
    <a href="/cadenza/features" class="nav-link">Features</a>
    <a href="/cadenza/pricing" class="nav-link">Pricing</a>
    <a href="/cadenza/solutions" class="nav-link">Solutions</a>
    <a href="/cadenza/blog" class="nav-link">Blog</a>
    <a href="/cadenza/compare" class="nav-link">Compare</a>
    <a href="/cadenza/about" class="nav-link">About</a>
    <a href="/cadenza/contact" class="nav-link">Contact</a>
  </div>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>Blog</h1>
      <p>Tips, guides, and insights for music teachers.</p>
    </div>
  </section>

  <!-- Topic Collections -->
  <section class="section" style="padding-bottom: var(--space-2xl);">
    <div class="container">
      <div class="section-header">
        <div class="badge">Topic collections</div>
        <h2>Start with the pillar, then follow the supporting guides</h2>
        <p>The blog is organized into practical portfolios so teachers can move from a broad studio question to the templates, scripts, and tools that make the answer usable.</p>
      </div>
      <div class="grid grid-3" style="margin-bottom: var(--space-2xl);">
        <div class="feature-card">
          <h4>Studio Operations</h4>
          <p>Scheduling, policies, cancellations, billing, and the systems that keep a studio manageable.</p>
        </div>
        <div class="feature-card">
          <h4>Software and Tools</h4>
          <p>Studio software, setup decisions, online teaching tools, and practical technology choices.</p>
        </div>
        <div class="feature-card">
          <h4>Practice and Engagement</h4>
          <p>Practice habits, motivation, student choice, and the between-lesson behaviors that drive progress.</p>
        </div>
        <div class="feature-card">
          <h4>Parent Communication</h4>
          <p>Parent expectations, progress updates, difficult conversations, and family trust.</p>
        </div>
        <div class="feature-card">
          <h4>Teaching Situations</h4>
          <p>Pedagogy, repertoire, exams, recitals, adults, teens, beginners, and tricky lesson moments.</p>
        </div>
        <div class="feature-card">
          <h4>Studio Growth</h4>
          <p>Rates, referrals, retention, capacity, and sustainable income decisions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Filters -->
  <section class="section section-alt" style="padding-top: var(--space-4xl);">
    <div class="container">
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 3rem;">
        <a href="#" class="btn btn-primary btn-sm">All</a>
        <a href="#" class="btn btn-ghost btn-sm">Teaching Tips</a>
        <a href="#" class="btn btn-ghost btn-sm">Studio Management</a>
        <a href="#" class="btn btn-ghost btn-sm">Student Engagement</a>
        <a href="#" class="btn btn-ghost btn-sm">Technology</a>
        <a href="#" class="btn btn-ghost btn-sm">Business Growth</a>
        <a href="#" class="btn btn-ghost btn-sm">Practice Strategies</a>
        <a href="#" class="btn btn-ghost btn-sm">Parent Communication</a>
      </div>

      <div class="grid grid-3">
        <div class="blog-card">
          <div class="blog-card-image">📝</div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-tag">Practice Strategies</span>
              <span class="blog-card-date">Jun 28, 2026 · 11 min read</span>
            </div>
            <h3>A Beginner Practice Reset Plan for Students Who Stall After the First Month</h3>
            <p>Use this beginner music student practice plan to rebuild habits after the first month.</p>
          </div>
        </div>
        <div class="blog-card">
          <div class="blog-card-image">🎵</div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-tag">Teaching Tips</span>
              <span class="blog-card-date">Jun 27, 2026 · 8 min read</span>
            </div>
            <h3>How to Introduce Jazz and Improvisation to Classical Students</h3>
            <p>A practical teaching tips guide for music teachers.</p>
          </div>
        </div>
        <div class="blog-card">
          <div class="blog-card-image">🏆</div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-tag">Student Engagement</span>
              <span class="blog-card-date">Jun 26, 2026 · 9 min read</span>
            </div>
            <h3>Why Some Music Students Need Competition and Others Should Avoid It</h3>
            <p>A practical student engagement guide for music teachers.</p>
          </div>
        </div>
        <div class="blog-card">
          <div class="blog-card-image">👨‍👩‍👧</div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-tag">Practice Strategies</span>
              <span class="blog-card-date">Jun 25, 2026 · 8 min read</span>
            </div>
            <h3>How to Help Students Move from Parent-Managed to Self-Managed Practice</h3>
            <p>A practical practice strategies guide for music teachers.</p>
          </div>
        </div>
        <div class="blog-card">
          <div class="blog-card-image">🎤</div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-tag">Studio Management</span>
              <span class="blog-card-date">Jun 24, 2026 · 9 min read</span>
            </div>
            <h3>Planning Your First Studio Recital Step by Step</h3>
            <p>A practical guide for music teachers planning a first studio recital.</p>
          </div>
        </div>
        <div class="blog-card">
          <div class="blog-card-image">📚</div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-tag">Teaching Tips</span>
              <span class="blog-card-date">Jun 23, 2026 · 8 min read</span>
            </div>
            <h3>Back-to-School Transitions for Music Students: 5 Ways to Keep Lessons Steady</h3>
            <p>A practical teaching tips guide for music teachers.</p>
          </div>
        </div>
      </div>

      <div class="text-center" style="margin-top: 3rem;">
        <a href="#" class="btn btn-secondary btn-lg">Load More Articles</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/cadenza" class="nav-logo">
            <img src="/images/cadenza/logo-placeholder.svg" alt="Cadenza Studio Logo">
            Cadenza Studio
          </a>
          <p>The complete studio management platform for music teachers.</p>
          <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.5rem;"><a href="/curator" style="color: inherit; text-decoration: underline;">Built on Curator</a>, open, local-first AI for education.</p>
        </div>
        <div class="footer-column">
          <h4>Product</h4>
          <a href="/cadenza/features">Features</a>
          <a href="/cadenza/pricing">Pricing</a>
          <a href="/cadenza/blog">Blog</a>
          <a href="/cadenza/compare">Compare</a>
        </div>
        <div class="footer-column">
          <h4>Company</h4>
          <a href="/cadenza/about">About</a>
          <a href="/cadenza/contact">Contact</a>
        </div>
        <div class="footer-column">
          <h4>Legal</h4>
          <a href="/cadenza/privacy">Privacy Policy</a>
          <a href="/cadenza/terms">Terms of Service</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Cadenza Studio. All rights reserved.</p>
        <div class="social-links">
          <a href="https://github.com/jeremysheeshka/Cadenza-Studio-App" class="social-link" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  

</LandingLayout>
