---
import LandingLayout from "../../layouts/LandingLayout.astro";
---

<LandingLayout title="Cadenza Studio - Studio Management for Music Teachers" description="Scheduling, invoicing, parent messages, practice tracking, student records, and local AI, all running on your own computer, free.">


  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a href="/cadenza" class="nav-logo">
        <img src="/images/cadenza/logo-placeholder.svg" alt="Cadenza Studio Logo">
        Cadenza Studio
      </a>
      <div class="nav-links">
        <a href="/cadenza/features" class="nav-link">Features</a>
        <a href="/cadenza/pricing" class="nav-link">Pricing</a>
        <a href="/cadenza/solutions" class="nav-link">Solutions</a>
        <a href="/cadenza/blog" class="nav-link">Blog</a>
        <a href="/cadenza/compare" class="nav-link">Compare</a>
        <a href="/cadenza/about" class="nav-link">About</a>
      </div>
      <div class="nav-cta">
        
        <a href="/cadenza-app" class="btn btn-primary">Get Started</a>
      </div>
      <button class="mobile-menu-btn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu">
    <a href="/cadenza/features" class="nav-link">Features</a>
    <a href="/cadenza/pricing" class="nav-link">Pricing</a>
    <a href="/cadenza/solutions" class="nav-link">Solutions</a>
    <a href="/cadenza/blog" class="nav-link">Blog</a>
    <a href="/cadenza/compare" class="nav-link">Compare</a>
    <a href="/cadenza/about" class="nav-link">About</a>
    <a href="/cadenza/contact" class="nav-link">Contact</a>
    <div style="margin-top: 2rem; display: flex; flex-direction: column; gap: 1rem;">
      <a href="/cadenza-app" class="btn btn-primary btn-lg">Get Started Free</a>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-badge">Free & open source · Local AI included · No credit card required</div>
      <h1>Run your studio from one app. Starting this week.</h1>
      <p>Scheduling, invoicing, parent messages, practice tracking, student records, and local AI that listens to lessons and does the paperwork, all running on your own computer, free. Your students and families connect from anywhere, always free. Only linking your studio to another teacher's requires Premium.</p>
      <div class="hero-cta">
        <a href="/cadenza-app" class="btn btn-primary btn-lg">Start Free</a>
        <a href="/cadenza/features" class="btn btn-secondary btn-lg">See How It Works</a>
      </div>
      <p class="hero-subtext">Built for piano teachers, guitar instructors, voice coaches, and private studios ready to leave spreadsheets behind.</p>
      <div class="hero-image">
        <img src="/images/cadenza/hero-placeholder.svg" alt="Cadenza Studio dashboard shown on laptop and phone — weekly schedule, student list, and attendance tracking">
      </div>
    </div>
  </section>

  <!-- What You Get Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge">What you get</div>
        <h2>Everything your studio needs, without the patchwork.</h2>
        <p>Cadenza runs entirely on your own computer, including the AI. Nothing here is a teaser for a paid tier; it's the whole studio, free.</p>
      </div>
      <div class="grid grid-4">
        <div class="feature-card">
          <div class="feature-card-icon">👥</div>
          <h4>Student & Family Profiles</h4>
          <p>Every student's contact info, notes, instrument, and lesson history in one place, not scattered across three apps.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">📅</div>
          <h4>Recurring Lesson Scheduling</h4>
          <p>Set weekly lessons once. Cadenza catches double-bookings before they happen.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">✓</div>
          <h4>Attendance & Makeup Tracking</h4>
          <p>Know exactly who owes a makeup lesson and who's used theirs, without checking your notes.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">💳</div>
          <h4>Invoicing & Payments</h4>
          <p>Send an invoice, take a card payment, and see who's paid, without a single follow-up text.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">👨‍👩‍👧</div>
          <h4>Parent & Student Portal</h4>
          <p>Families check the portal instead of texting you at 9pm to ask when the next lesson is.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">🎯</div>
          <h4>Practice Logs & Achievements</h4>
          <p>Students log practice, build streaks, and stay motivated without you having to ask.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">💬</div>
          <h4>Family Messaging</h4>
          <p>One thread per family, not scattered across text, email, and whatever app they downloaded once.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">📝</div>
          <h4>Lesson Notes & Resources</h4>
          <p>Attach sheet music, notes, and assignments directly to the lesson they belong to.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">🤖</div>
          <h4>Local AI, Included</h4>
          <p>Lesson transcription, a RAG-searchable resource library, and on-demand transposition, running on your machine, at no cost, because it costs us nothing to give you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Before/After Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div class="badge">Before Cadenza Studio. After Cadenza Studio.</div>
        <h2>The same studio work, with fewer places to check.</h2>
      </div>
      <div class="before-after">
        <div class="before-after-card before-card">
          <h3>Before</h3>
          <p>Google Calendar for lessons. A spreadsheet for billing. Text threads for parents. Sticky notes for who owes a makeup.</p>
          <ul>
            <li>Parents ask the same schedule and payment question, every week, in a different thread.</li>
            <li>Students leave with a practice goal on Tuesday. By Sunday, neither of you remembers what it was.</li>
          </ul>
        </div>
        <div class="before-after-card after-card">
          <h3>After</h3>
          <ul>
            <li>One place for lessons, billing, messages, and practice, for you and for them.</li>
            <li>Families check the portal instead of texting you.</li>
            <li>Students see exactly what to practice, log it, and watch a streak build.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Setup Steps Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge">Fast setup</div>
        <h2>Set up your studio in one sitting.</h2>
        <p>Bring what you already have. Add your students, build the week, connect billing, and invite families whenever you're ready, no migration project required.</p>
      </div>
      <div class="grid grid-4">
        <div class="step-card">
          <div class="step-number">1</div>
          <h4>Add Students</h4>
          <p>Create profiles for your current roster, or import your existing list.</p>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <h4>Build the Schedule</h4>
          <p>Set recurring lessons, locations, and colors. Conflicts get caught automatically.</p>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <h4>Set Up Billing</h4>
          <p>Create your first invoice. Online payments available with Premium.</p>
        </div>
        <div class="step-card">
          <div class="step-number">4</div>
          <h4>Invite Families</h4>
          <p>Turn on portal access whenever your studio and you are ready.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Five Headaches Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div class="badge">Five studio headaches, finally connected.</div>
        <h2>Built around the real weekly loop of a private studio.</h2>
      </div>
      <div class="grid grid-2">
        <div class="feature-card">
          <h3>Student records stop living in a spreadsheet.</h3>
          <p>Families, notes, attendance, history, and resources, tied to the right student, not a tab you have to remember to update.</p>
        </div>
        <div class="feature-card">
          <h3>Cancellations stop wrecking your calendar.</h3>
          <p>Recurring lessons, drag-and-drop rescheduling, and makeup credits that track themselves.</p>
        </div>
        <div class="feature-card">
          <h3>Payment follow-up stops feeling personal.</h3>
          <p>Send an invoice and take a payment without it turning into an awkward conversation.</p>
        </div>
        <div class="feature-card">
          <h3>Parent communication stops scattering everywhere.</h3>
          <p>Messages, announcements, and files in one thread, off your personal phone.</p>
        </div>
        <div class="feature-card">
          <h3>Practice stops disappearing between lessons.</h3>
          <p>Students see what to practice, log it, and build a streak they actually want to keep.</p>
        </div>
      </div>
      <p class="text-center" style="margin-top: 2rem;">
        See how Cadenza Studio compares to <a href="/cadenza/compare" style="color: var(--color-primary); font-weight: 500;">other platforms</a>, or explore solutions for <a href="/cadenza/solutions" style="color: var(--color-primary); font-weight: 500;">your instrument</a>.
      </p>
    </div>
  </section>

  <!-- Auto-Scribe Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge">Coming to Cadenza Studio, free, like everything else here</div>
        <h2>Auto-Scribe: the lesson writes its own paperwork.</h2>
      </div>
      <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <p style="font-size: 1.125rem; line-height: 1.8; margin-bottom: 1.5rem;">During a lesson, Auto-Scribe listens locally, with your permission, on your own machine and turns what was actually covered into three things: a practice plan built from the lesson, the exact sheet music transposed to what your student needs, and a parent update drafted in your voice. One click sends it. Nothing leaves your device, and nothing about this requires a subscription.</p>
        <div style="display: inline-block; padding: 0.5rem 1.5rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 600;">In development, part of the free, open-source core.</div>
      </div>
    </div>
  </section>

  <!-- Studio Network Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div class="badge">For studios with more than one teacher</div>
        <h2>Your studio doesn't have to stop at your WiFi router.</h2>
      </div>
      <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <p style="font-size: 1.125rem; line-height: 1.8; margin-bottom: 1.5rem;">Everything above runs free, forever, for one teacher and as many students and families as you have. They connect from home, from anywhere, at no cost. If you want to link your studio to a second teacher who isn't standing in your building, that's Cadenza Studio Premium: a secure, private tunnel between your local database and theirs, so a co-teacher, a substitute, or a partner studio can see what they need without either of you touching the cloud.</p>
        <a href="/cadenza/pricing" class="btn btn-primary btn-lg">See Premium →</a>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge">Loved by music teachers</div>
        <h2>See what other teachers are saying.</h2>
      </div>
      <div class="grid grid-3">
        <div class="testimonial-card">
          <blockquote>"I used to spend Sunday nights rebuilding my week in a spreadsheet. Now it takes ten minutes."</blockquote>
          <div class="author">
            <div class="avatar">SM</div>
            <div class="author-info">
              <h4>Sarah M.</h4>
              <p>Piano Teacher — Austin, TX</p>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <blockquote>"My students actually check their practice streak. I've never seen that happen with a paper log."</blockquote>
          <div class="author">
            <div class="avatar">MR</div>
            <div class="author-info">
              <h4>Michael R.</h4>
              <p>Guitar Instructor — Portland, OR</p>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <blockquote>"Scheduling, billing, and messaging finally live in the same place. I stopped dreading Mondays."</blockquote>
          <div class="author">
            <div class="avatar">JL</div>
            <div class="author-info">
              <h4>Jennifer L.</h4>
              <p>Voice Coach — Nashville, TN</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div class="badge">Common questions</div>
        <h2>Quick answers for music teachers.</h2>
      </div>
      <div style="max-width: 700px; margin: 0 auto;">
        <div class="faq-item">
          <button class="faq-question">
            Is Cadenza Studio really free?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Yes. Free covers your whole studio, unlimited students if self-hosted, up to 10 on Cadenza's hosted free tier, plus scheduling, attendance, messaging, the student/family portal, and local AI, all at no cost. Premium is only for linking your studio to another teacher's beyond your own network.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question">
            I'm not very technical. Is this hard to set up?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Most teachers are running their first lesson through Cadenza the same day they sign up. If you can send an email, you can set this up.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question">
            Can parents see their child's schedule?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Yes. The student portal lets families view schedules, track practice, and receive updates.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question">
            What if I want to switch from another tool?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>You can import your student roster and start fresh. <a href="/cadenza/contact" style="color: var(--color-primary);">Contact us</a> if you need help migrating.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Build your first Cadenza Studio setup today.</h2>
      <p>Start free, add your first students, and see your schedule, billing, messages, and practice tracking work as one system.</p>
      <a href="/cadenza-app" class="btn btn-secondary btn-lg">Start Free</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/cadenza" class="nav-logo">
            <img src="/images/cadenza/logo-placeholder.svg" alt="Cadenza Studio Logo">
            Cadenza Studio
          </a>
          <p>The complete studio management platform for music teachers.</p>
          <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.5rem;"><a href="/curator" style="color: inherit; text-decoration: underline;">Built on Curator</a>, open, local-first AI for education.</p>
        </div>
        <div class="footer-column">
          <h4>Product</h4>
          <a href="/cadenza/features">Features</a>
          <a href="/cadenza/pricing">Pricing</a>
          <a href="/cadenza/blog">Blog</a>
          <a href="/cadenza/compare">Compare</a>
        </div>
        <div class="footer-column">
          <h4>Company</h4>
          <a href="/cadenza/about">About</a>
          <a href="/cadenza/contact">Contact</a>
        </div>
        <div class="footer-column">
          <h4>Legal</h4>
          <a href="/cadenza/privacy">Privacy Policy</a>
          <a href="/cadenza/terms">Terms of Service</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Cadenza Studio. All rights reserved.</p>
        <div class="social-links">
          <a href="https://github.com/jeremysheeshka/Cadenza-Studio-App" class="social-link" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  

</LandingLayout>
