---
import LandingLayout from "../../../layouts/LandingLayout.astro";
---

<LandingLayout title="Terms and Conditions | Cadenza Studio" description="Cadenza Studio Terms and Conditions.">


  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a href="/cadenza" class="nav-logo">
        <img src="/images/cadenza/logo-placeholder.svg" alt="Cadenza Studio Logo">
        Cadenza Studio
      </a>
      <div class="nav-links">
        <a href="/cadenza/features" class="nav-link">Features</a>
        <a href="/cadenza/pricing" class="nav-link">Pricing</a>
        <a href="/cadenza/solutions" class="nav-link">Solutions</a>
        <a href="/cadenza/blog" class="nav-link">Blog</a>
        <a href="/cadenza/compare" class="nav-link">Compare</a>
        <a href="/cadenza/about" class="nav-link">About</a>
      </div>
      <div class="nav-cta">
        
        <a href="/cadenza-app" class="btn btn-primary">Get Started</a>
      </div>
      <button class="mobile-menu-btn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu">
    <a href="/cadenza/features" class="nav-link">Features</a>
    <a href="/cadenza/pricing" class="nav-link">Pricing</a>
    <a href="/cadenza/solutions" class="nav-link">Solutions</a>
    <a href="/cadenza/blog" class="nav-link">Blog</a>
    <a href="/cadenza/compare" class="nav-link">Compare</a>
    <a href="/cadenza/about" class="nav-link">About</a>
    <a href="/cadenza/contact" class="nav-link">Contact</a>
  </div>

  <!-- Terms Content -->
  <div class="legal-content container">
    <h1>Terms and Conditions</h1>
    <p class="effective-date">Effective date: May 31, 2026</p>

    <h2>Acceptance</h2>
    <p>By using Cadenza Studio, you agree to these terms.</p>

    <h2>Use of Service</h2>
    <p>You agree to use Cadenza Studio only for lawful purposes.</p>

    <h2>Accounts</h2>
    <p>You are responsible for maintaining the security of your account credentials.</p>

    <h2>Payments</h2>
    <p>Paid features may require a valid payment method and are subject to recurring billing. Cadenza Studio Premium is available as a monthly subscription ($10/month) or an annual subscription ($100/year). Subscriptions renew automatically until canceled.</p>

    <h2>Cancellations and Refunds</h2>
    <p>You may cancel a paid subscription at any time. Cancellation takes effect at the end of the current billing period, and you keep access to paid features until that period ends. Refunds may be provided where required by law or at our discretion.</p>

    <h2>Disclaimer</h2>
    <p>The service is provided "as is" without warranties to the extent allowed by law.</p>

    <h2>Changes</h2>
    <p>We may update these terms at any time. Continued use means you accept the updated version.</p>

    <h2>Contact</h2>
    <p>For questions about these terms, contact us through our <a href="/cadenza/contact">contact page</a>.</p>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/cadenza" class="nav-logo">
            <img src="/images/cadenza/logo-placeholder.svg" alt="Cadenza Studio Logo">
            Cadenza Studio
          </a>
          <p>The complete studio management platform for music teachers.</p>
          <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.5rem;"><a href="/curator" style="color: inherit; text-decoration: underline;">Built on Curator</a>, open, local-first AI for education.</p>
        </div>
        <div class="footer-column">
          <h4>Product</h4>
          <a href="/cadenza/features">Features</a>
          <a href="/cadenza/pricing">Pricing</a>
          <a href="/cadenza/blog">Blog</a>
          <a href="/cadenza/compare">Compare</a>
        </div>
        <div class="footer-column">
          <h4>Company</h4>
          <a href="/cadenza/about">About</a>
          <a href="/cadenza/contact">Contact</a>
        </div>
        <div class="footer-column">
          <h4>Legal</h4>
          <a href="/cadenza/privacy">Privacy Policy</a>
          <a href="/cadenza/terms">Terms of Service</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Cadenza Studio. All rights reserved.</p>
        <div class="social-links">
          <a href="https://github.com/jeremysheeshka/Cadenza-Studio-App" class="social-link" aria-label="GitHub">
