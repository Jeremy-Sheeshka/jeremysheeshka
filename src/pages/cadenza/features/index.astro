---
import CadenzaLayout from "../../../layouts/CadenzaLayout.astro";
---

<CadenzaLayout title="Features | Cadenza Studio" description="Powerful features for modern music teachers. Everything you need to run a studio, without needing a manual to use it.">






  <!-- Video Hero -->
  <section style="position: relative; overflow: hidden; min-height: 400px; display: flex; align-items: center; justify-content: center;">
    <video
      autoplay loop muted playsinline
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; z-index: 0;"
    >
      <source src="/videos/herobannervideo.mp4" type="video/mp4" />
    </video>
    <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.55); z-index: 1;"></div>
    <div class="container" style="position: relative; z-index: 2; text-align: center; padding: 4rem 1rem;">
      <h1 style="color: #fff; font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem;">Powerful features for modern music teachers</h1>
      <p style="color: rgba(255,255,255,0.85); font-size: 1.2rem;">Everything you need to run a studio.</p>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="gap: 3rem;">
        <!-- Student & Family Management -->
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Student & Family Management</div>
          <h2 style="margin-bottom: 1rem;">Keep every student's information where you'll actually look for it.</h2>
          <ul style="margin: 0;">
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Full profiles with contact info, notes, and history</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Family grouping for siblings without duplicate entries</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Status tracking so nobody falls through the cracks</li>
          </ul>
        </div>

        <!-- Smart Scheduling -->
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Smart Scheduling</div>
          <h2 style="margin-bottom: 1rem;">Calendar tools that catch problems before you do.</h2>
          <ul style="margin: 0;">
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Recurring lessons with flexible patterns</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Month, week, day, and agenda views</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Conflict detection and makeup credit tracking</li>
          </ul>
        </div>

        <!-- Billing & Invoicing -->
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Billing & Invoicing</div>
          <h2 style="margin-bottom: 1rem;">Get paid without the awkward follow-up text.</h2>
          <ul style="margin: 0;">
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Auto-generate invoices tied to lessons</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Online payments via Premium</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Track cash, card, or Venmo at a glance</li>
          </ul>
        </div>

        <!-- Messaging -->
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Messaging & Communication</div>
          <h2 style="margin-bottom: 1rem;">One thread per family. Not five apps.</h2>
          <ul style="margin: 0;">
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Direct messages off your personal number</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Broadcast announcements to select families</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ File sharing and read receipts</li>
          </ul>
        </div>

        <!-- Student Portal -->
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Student Portal</div>
          <h2 style="margin-bottom: 1rem;">Give students a reason to check in between lessons.</h2>
          <ul style="margin: 0;">
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Simple PIN login for young students</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ View schedule and assignments without texting you</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Access shared resources and message their teacher</li>
          </ul>
        </div>

        <!-- Practice Tracking -->
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Practice Tracking</div>
          <h2 style="margin-bottom: 1rem;">Turn practice into something students want to keep up.</h2>
          <ul style="margin: 0;">
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Daily logging with notes and streaks</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Points, levels, and achievements</li>
            <li style="padding: 0.4rem 0; font-size: 0.875rem; color: var(--color-text-secondary);">✓ Goals students set and actually track</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- App Screenshots -->
  <section class="section" style="padding-bottom: 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 1000px; margin: 0 auto;">
        <a href="/images/cadenza/cascaderesources.png" class="blog-lightbox" style="display: block; cursor: zoom-in;">
          <img
            src="/images/cadenza/cascaderesources.png"
            alt="Cadenza Studio resources and files interface"
            style="width: 100%; height: auto; border-radius: 0.75rem; box-shadow: 0 2px 16px rgba(0,0,0,0.08); display: block;"
          />
        </a>
        <a href="/images/cadenza/cascadecalendar.png" class="blog-lightbox" style="display: block; cursor: zoom-in;">
          <img
            src="/images/cadenza/cascadecalendar.png"
            alt="Cadenza Studio calendar and scheduling interface"
            style="width: 100%; height: auto; border-radius: 0.75rem; box-shadow: 0 2px 16px rgba(0,0,0,0.08); display: block;"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- Local AI Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div class="badge">Local AI</div>
        <h2>AI that runs on your machine, not someone else's server.</h2>
        <p>Cadenza's AI runs on your machine, not someone else's server, which is exactly why it's free. Transcription, resource search, and transposition are part of the free, open-source core, the same as scheduling or billing.</p>
      </div>
      <div class="grid grid-3">
        <div class="feature-card" style="text-align: center;">
          <div class="feature-card-icon" style="margin: 0 auto 1rem;">🎤</div>
          <h4>Lesson Transcription & Summarization</h4>
          <p>Turns what was covered into a structured practice plan, automatically.</p>
        </div>
        <div class="feature-card" style="text-align: center;">
          <div class="feature-card-icon" style="margin: 0 auto 1rem;">🔍</div>
          <h4>RAG-Powered Resource Search</h4>
          <p>Ask for "the tenor sax 2 part from Perdido" and get it, from your own library.</p>
        </div>
        <div class="feature-card" style="text-align: center;">
          <div class="feature-card-icon" style="margin: 0 auto 1rem;">🎵</div>
          <h4>On-Demand Transposition</h4>
          <p>Find a chart in your library and have it transposed automatically.</p>
        </div>
      </div>
      <p class="text-center" style="margin-top: 1.5rem; font-size: 0.875rem; color: var(--color-text-muted);">Transcription and RAG search: in development. Core scheduling, billing, and portal features: live today.</p>
    </div>
  </section>

  <!-- Studio Network (Premium) -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge">Studio Network (Premium)</div>
        <h2>Connect your studio to another teacher's.</h2>
        <p>Everything above is free and local. Premium is one thing on top of it: a secure tunnel connecting your studio's local database to another teacher's, for co-teaching, coverage, or partner studios, without routing anything through the cloud.</p>
      </div>
      <div class="text-center">
        <a href="/cadenza/pricing" class="btn btn-primary btn-lg">See how Premium works →</a>
      </div>
    </div>
  </section>

  <!-- And So Much More -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>And so much more</h2>
      </div>
      <div class="grid grid-3">
        <div class="feature-card">
          <div class="feature-card-icon">⚡</div>
          <h4>Time-Saving Automation</h4>
          <p>Auto-generate calendar events from your schedule and send reminders without lifting a finger.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">🔔</div>
          <h4>Real-Time Notifications</h4>
          <p>Know the moment a message, payment, or schedule change happens.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">📚</div>
          <h4>Resource Library</h4>
          <p>Sheet music, videos, and materials, organized in folders your future self will thank you for.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">📋</div>
          <h4>Assignments</h4>
          <p>Assign homework, see what's submitted, and leave feedback in one place.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">🏆</div>
          <h4>Gamification</h4>
          <p>Points, levels, streaks, and badges that keep students coming back to check in.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">📊</div>
          <h4>Dashboard Analytics</h4>
          <p>Your studio's health at a glance, no spreadsheet required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to simplify your music studio?</h2>
      <p>Join music teachers who are saving time and growing their studios with Cadenza Studio.</p>
      <a href="/cadenza-app" class="btn btn-secondary btn-lg">Get Started Free</a>
    </div>
  </section>



</CadenzaLayout>
