---
import LandingLayout from "../../../layouts/LandingLayout.astro";
---

<LandingLayout title="Features | Cadenza Studio" description="Powerful features for modern music teachers. Everything you need to run a studio, without needing a manual to use it.">


  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a href="/cadenza" class="nav-logo">
        <img src="/images/cadenza/logo-placeholder.svg" alt="Cadenza Studio Logo">
        Cadenza Studio
      </a>
      <div class="nav-links">
        <a href="/cadenza/features" class="nav-link">Features</a>
        <a href="/cadenza/pricing" class="nav-link">Pricing</a>
        <a href="/cadenza/solutions" class="nav-link">Solutions</a>
        <a href="/cadenza/blog" class="nav-link">Blog</a>
        <a href="/cadenza/compare" class="nav-link">Compare</a>
        <a href="/cadenza/about" class="nav-link">About</a>
      </div>
      <div class="nav-cta">
        
        <a href="http://localhost:5173" class="btn btn-primary">Get Started</a>
      </div>
      <button class="mobile-menu-btn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu">
    <a href="/cadenza/features" class="nav-link">Features</a>
    <a href="/cadenza/pricing" class="nav-link">Pricing</a>
    <a href="/cadenza/solutions" class="nav-link">Solutions</a>
    <a href="/cadenza/blog" class="nav-link">Blog</a>
    <a href="/cadenza/compare" class="nav-link">Compare</a>
    <a href="/cadenza/about" class="nav-link">About</a>
    <a href="/cadenza/contact" class="nav-link">Contact</a>
  </div>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>Powerful features for modern music teachers</h1>
      <p>Everything you need to run a studio, without needing a manual to use it.</p>
    </div>
  </section>

  <!-- Student & Family Management -->
  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="align-items: center;">
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Student & Family Management</div>
          <h2>Keep every student's information where you'll actually look for it.</h2>
          <ul style="margin: 1.5rem 0;">
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Full profiles: contact info, notes, and history in one card, not three tabs.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Family grouping, so siblings share a household without duplicate entries.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Custom tags for however you actually organize your roster.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Status tracking (active, inactive, waitlist) so nobody falls through the cracks.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Lesson history and attendance, automatically tied to the right student.
            </li>
          </ul>
          <a href="#" class="btn btn-primary">See how student profiles work →</a>
        </div>
        <div style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-radius: 1rem; height: 400px; display: flex; align-items: center; justify-content: center; color: white; font-size: 4rem;">
          👥
        </div>
      </div>
    </div>
  </section>

  <!-- Smart Scheduling -->
  <section class="section section-alt">
    <div class="container">
      <div class="grid grid-2" style="align-items: center;">
        <div style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-radius: 1rem; height: 400px; display: flex; align-items: center; justify-content: center; color: white; font-size: 4rem; order: -1;">
          📅
        </div>
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Smart Scheduling</div>
          <h2>Calendar tools that catch problems before you do.</h2>
          <ul style="margin: 1.5rem 0;">
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Recurring lessons with patterns flexible enough for a real week, not just "every Monday."
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Month, week, day, and agenda views, however you think about your week.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Makeup credit tracking, so a cancellation doesn't become a mental note you forget.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Conflict detection before you accidentally double-book a slot.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Organize by location and category when you teach in more than one place.
            </li>
          </ul>
          <a href="#" class="btn btn-primary">See scheduling in action →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Billing & Invoicing -->
  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="align-items: center;">
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Billing & Invoicing</div>
          <h2>Get paid without the awkward follow-up text.</h2>
          <ul style="margin: 1.5rem 0;">
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Generate invoices automatically, tied to lessons that already happened.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Take online payments (Premium), no chasing checks.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Track cash, check, Venmo, or card payments side by side either way.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              See invoice and payment status at a glance, not by scrolling a group chat.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Set your own tax rates and late fees once, not every time.
            </li>
          </ul>
          <a href="#" class="btn btn-primary">See how billing works →</a>
        </div>
        <div style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-radius: 1rem; height: 400px; display: flex; align-items: center; justify-content: center; color: white; font-size: 4rem;">
          💳
        </div>
      </div>
    </div>
  </section>

  <!-- Messaging & Communication -->
  <section class="section section-alt">
    <div class="container">
      <div class="grid grid-2" style="align-items: center;">
        <div style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-radius: 1rem; height: 400px; display: flex; align-items: center; justify-content: center; color: white; font-size: 4rem; order: -1;">
          💬
        </div>
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Messaging & Communication</div>
          <h2>One thread per family. Not five apps.</h2>
          <ul style="margin: 1.5rem 0;">
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Direct messages with individual families, off your personal number.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Broadcast announcements to everyone, or just the families who need it.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Email notifications so nothing gets missed in an app nobody opens daily.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Share files and attachments directly in the conversation.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Read receipts, so "I never got that" stops being a guessing game.
            </li>
          </ul>
          <a href="#" class="btn btn-primary">See messaging in action →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Student Portal -->
  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="align-items: center;">
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Student Portal</div>
          <h2>Give students a reason to check in between lessons.</h2>
          <ul style="margin: 1.5rem 0;">
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Secure PIN login built for a 9-year-old to use without help.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Upcoming lessons and schedule, visible without a text to you.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Assignment submission and progress tracking in the same place they practice from.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Shared resources (sheet music, recordings, notes), always where they left it.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Direct messages to their teacher, without needing a parent's phone.
            </li>
          </ul>
          <a href="#" class="btn btn-primary">See the student experience →</a>
        </div>
        <div style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-radius: 1rem; height: 400px; display: flex; align-items: center; justify-content: center; color: white; font-size: 4rem;">
          🎓
        </div>
      </div>
    </div>
  </section>

  <!-- Practice Tracking -->
  <section class="section section-alt">
    <div class="container">
      <div class="grid grid-2" style="align-items: center;">
        <div style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-radius: 1rem; height: 400px; display: flex; align-items: center; justify-content: center; color: white; font-size: 4rem; order: -1;">
          🎯
        </div>
        <div>
          <div class="badge" style="display: inline-block; padding: 0.25rem 1rem; background: rgba(99,102,241,0.1); color: var(--color-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Practice Tracking</div>
          <h2>Turn practice into something students want to keep up.</h2>
          <ul style="margin: 1.5rem 0;">
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Daily logging with notes, not just a checkbox.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Streaks that make five days in a row feel like something.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Points and levels that turn practice into progress you can see.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Achievements for real milestones, not participation trophies.
            </li>
            <li style="padding: 0.5rem 0; font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: flex-start; gap: 0.5rem;">
              <span style="color: var(--color-success); font-weight: 700;">✓</span>
              Goals students set and actually track, instead of a vague "practice more."
            </li>
          </ul>
          <a href="#" class="btn btn-primary">See practice tracking in action →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Local AI Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge">Local AI, Not a Bolt-On</div>
        <h2>AI that runs on your machine, not someone else's server.</h2>
        <p>Cadenza's AI runs on your machine, not someone else's server, which is exactly why it's free. Transcription, resource search, and transposition are part of the free, open-source core, the same as scheduling or billing.</p>
      </div>
      <div class="grid grid-3">
        <div class="feature-card" style="text-align: center;">
          <div class="feature-card-icon" style="margin: 0 auto 1rem;">🎤</div>
          <h4>Lesson Transcription & Summarization</h4>
          <p>Turns what was covered into a structured practice plan, automatically.</p>
        </div>
        <div class="feature-card" style="text-align: center;">
          <div class="feature-card-icon" style="margin: 0 auto 1rem;">🔍</div>
          <h4>RAG-Powered Resource Search</h4>
          <p>Ask for "the tenor sax 2 part from Perdido" and get it, from your own library.</p>
        </div>
        <div class="feature-card" style="text-align: center;">
          <div class="feature-card-icon" style="margin: 0 auto 1rem;">🎵</div>
          <h4>On-Demand Transposition</h4>
          <p>Request a key change and get the part, not a search result.</p>
        </div>
      </div>
      <p class="text-center" style="margin-top: 1.5rem; font-size: 0.875rem; color: var(--color-text-muted);">Transcription and RAG search: in development. Core scheduling, billing, and portal features: live today.</p>
    </div>
  </section>

  <!-- Studio Network (Premium) -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div class="badge">Studio Network (Premium)</div>
        <h2>Connect your studio to another teacher's.</h2>
        <p>Everything above is free and local. Premium is one thing on top of it: a secure tunnel connecting your studio's local database to another teacher's, for co-teaching, coverage, or partner studios, without routing anything through the cloud.</p>
      </div>
      <div class="text-center">
        <a href="/cadenza/pricing" class="btn btn-primary btn-lg">See how Premium works →</a>
      </div>
    </div>
  </section>

  <!-- And So Much More -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>And so much more</h2>
      </div>
      <div class="grid grid-3">
        <div class="feature-card">
          <div class="feature-card-icon">⚡</div>
          <h4>Time-Saving Automation</h4>
          <p>Auto-generate calendar events from your schedule and send reminders without lifting a finger.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">🔔</div>
          <h4>Real-Time Notifications</h4>
          <p>Know the moment a message, payment, or schedule change happens.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">📚</div>
          <h4>Resource Library</h4>
          <p>Sheet music, videos, and materials, organized in folders your future self will thank you for.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">📋</div>
          <h4>Assignments</h4>
          <p>Assign homework, see what's submitted, and leave feedback in one place.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">🏆</div>
          <h4>Gamification</h4>
          <p>Points, levels, streaks, and badges that keep students coming back to check in.</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">📊</div>
          <h4>Dashboard Analytics</h4>
          <p>Your studio's health at a glance, no spreadsheet required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to simplify your music studio?</h2>
      <p>Join music teachers who are saving time and growing their studios with Cadenza Studio.</p>
      <a href="http://localhost:5173" class="btn btn-secondary btn-lg">Get Started Free</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/cadenza" class="nav-logo">
            <img src="/images/cadenza/logo-placeholder.svg" alt="Cadenza Studio Logo">
            Cadenza Studio
          </a>
          <p>The complete studio management platform for music teachers.</p>
          <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.5rem;"><a href="/curator" style="color: inherit; text-decoration: underline;">Built on Curator</a>, open, local-first AI for education.</p>
        </div>
        <div class="footer-column">
          <h4>Product</h4>
          <a href="/cadenza/features">Features</a>
          <a href="/cadenza/pricing">Pricing</a>
          <a href="/cadenza/blog">Blog</a>
          <a href="/cadenza/compare">Compare</a>
        </div>
        <div class="footer-column">
          <h4>Company</h4>
          <a href="/cadenza/about">About</a>
          <a href="/cadenza/contact">Contact</a>
        </div>
        <div class="footer-column">
          <h4>Legal</h4>
          <a href="/cadenza/privacy">Privacy Policy</a>
          <a href="/cadenza/terms">Terms of Service</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Cadenza Studio. All rights reserved.</p>
        <div class="social-links">
          <a href="https://github.com/jeremysheeshka/Cadenza-Studio-App" class="social-link" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  

</LandingLayout>
