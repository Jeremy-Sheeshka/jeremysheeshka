---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getAllPosts } from "@/data/post";
import BlogPost from "@/layouts/BlogPost.astro";
import ImmersivePost from "@/layouts/ImmersivePost.astro";
import PresentationPost from "@/layouts/PresentationPost.astro";
// Notice the capital M here
import WebMentions from "@/components/blog/webmentions/index.astro";

export const getStaticPaths = (async () => {
    const blogEntries = await getAllPosts();
    return blogEntries.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content } = await render(post);
---

{
    post.data.presentation ? (
        /* The deck is the page — no cover, no link out to the real thing. */
        <PresentationPost post={post} />
    ) : post.data.immersive ? (
        /* The piece is the page; the writing lives below it. */
        <ImmersivePost post={post}>
            <Content />
        </ImmersivePost>
    ) : (
        <BlogPost post={post}>
            <div class="prose-base dark:prose-invert max-w-none">
                <Content />
            </div>

            {/* Use the capital M here to match the import above */}
            <WebMentions />
        </BlogPost>
    )
}