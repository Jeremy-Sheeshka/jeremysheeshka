---
import PageLayout from "@/layouts/Base.astro";
import {
  getEntriesByPhase,
  phases,
  portfolioEntries,
  rubricCriteria,
} from "@/data/portfolioData";
import type { Phase } from "@/data/portfolioData";
import RubricBadge from "@/components/RubricBadge.astro";
import TimelineEntry from "@/components/TimelineEntry.astro";
import ProjectShowcase from "@/components/ProjectShowcase.astro";
import Reflection from "../../../content/portfolio/etec522/reflection.mdx";

const meta = {
  title: "Participation Portfolio — ETEC 522",
  description:
    "A self-assessed participation portfolio for UBC's ETEC 522: nine postings mapped to the A4 rubric, a 500-word reflective statement, and constructive suggestions.",
};

const entryCount = portfolioEntries.length;

const phaseData = phases.map((phase) => ({
  ...phase,
  entries: getEntriesByPhase(phase.phase as Phase),
}));
---

<PageLayout meta={meta} themeColor="cream">
  <div class="mx-auto max-w-6xl px-6 py-12 md:px-12 md:py-20">
    <!-- ============================ HERO ============================ -->
    <header class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-stone-500 dark:text-zinc-400">
        ETEC 522 · Participation Portfolio
      </p>
      <h1 class="mt-3 text-4xl font-black leading-tight tracking-tight text-stone-900 dark:text-zinc-50 sm:text-5xl md:text-6xl">
        Participation Portfolio
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-stone-700 dark:text-zinc-300">
        Educator · Developer · Musician. A self-assessed record of{" "}
        <strong class="font-semibold">{entryCount} postings</strong> that bridge
        creative educational composition with the dispassionate, risk-aware
        analysis of an Educational Venture Analyst — mapped to the A4 rubric.
      </p>

      <nav class="mt-6 flex flex-wrap gap-2" aria-label="On this page">
        <a href="#rubric" class="rounded-full border border-stone-300 px-4 py-1.5 text-sm font-semibold text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-50">Rubric</a>
        <a href="#reflection" class="rounded-full border border-stone-300 px-4 py-1.5 text-sm font-semibold text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-50">Reflective Statement</a>
        <a href="#timeline" class="rounded-full border border-stone-300 px-4 py-1.5 text-sm font-semibold text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-50">Timeline of Postings</a>
        <a href="#letter" class="rounded-full border border-stone-300 px-4 py-1.5 text-sm font-semibold text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-50">Letter to the Next Cohort</a>
      </nav>
    </header>

    <!-- ===================== RUBRIC LEGEND ===================== -->
    <section id="rubric" class="mt-16 scroll-mt-24" aria-labelledby="rubric-heading">
      <h2 id="rubric-heading" class="text-2xl font-bold text-stone-900 dark:text-zinc-50">
        How this portfolio is graded
      </h2>
      <p class="mt-2 max-w-2xl text-stone-600 dark:text-zinc-400">
        The A4 rubric awards 25 points across four criteria. Every entry below is
        tagged with the criteria it evidences.
      </p>

      <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          rubricCriteria.map((criterion) => (
            <div class="rounded-2xl border border-stone-200 bg-white/90 p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/80">
              <dt class="flex items-center justify-between gap-2">
                <RubricBadge tag={criterion.name} showPoints={false} />
                <span class="text-sm font-black tabular-nums text-stone-900 dark:text-zinc-50">
                  {criterion.points}<span class="text-stone-400">/25</span>
                </span>
              </dt>
              <dd class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-zinc-400">
                {criterion.description}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ===================== REFLECTIVE STATEMENT ===================== -->
    <section
      id="reflection"
      class="mt-20 scroll-mt-24"
      aria-labelledby="reflection-heading"
    >
      <div class="mx-auto max-w-[68ch]">
        <div class="flex flex-wrap items-center gap-3">
          <h2 id="reflection-heading" class="text-2xl font-bold text-stone-900 dark:text-zinc-50">
            Reflective Statement
          </h2>
          <span class="rounded-full border border-stone-300 px-3 py-0.5 text-xs font-semibold text-stone-500 dark:border-zinc-700 dark:text-zinc-400">
            443 words · ≤ 500
          </span>
        </div>

        <div
          class="mt-8 border-t border-stone-300 pt-8 font-serif text-[1.0625rem] leading-[1.9] text-stone-800 dark:border-zinc-700 dark:text-zinc-200 prose prose-stone dark:prose-invert max-w-none prose-a:font-semibold prose-a:underline prose-a:decoration-stone-400 prose-a:underline-offset-4 prose-a:hover:decoration-[var(--color-link)]"
        >
          <Reflection />
        </div>
      </div>
    </section>

    <!-- ===================== TIMELINE ===================== -->
    <section id="timeline" class="mt-20 scroll-mt-24" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="text-2xl font-bold text-stone-900 dark:text-zinc-50">
        Timeline of Postings
      </h2>
      <p class="mt-2 max-w-2xl text-stone-600 dark:text-zinc-400">
        A colour-coded spine across the three stages of the course. The Cadenza
        Studio MVP breaks the rhythm as a Builder's Showcase.
      </p>

      <div class="mt-10 space-y-16">
        {
          phaseData.map((phase) => (
            <section aria-labelledby={`phase-${phase.phase}`}>
              <header class="flex flex-wrap items-center gap-4">
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-full text-lg font-black text-white"
                  style={`background-color: ${phase.color};`}
                  aria-hidden="true"
                >
                  {phase.phase}
                </span>
                <div>
                  <h3
                    id={`phase-${phase.phase}`}
                    class="text-xl font-bold text-stone-900 dark:text-zinc-50"
                  >
                    {phase.label}
                  </h3>
                  <p class="text-sm text-stone-500 dark:text-zinc-400">
                    {phase.description}
                  </p>
                </div>
              </header>

              <ol class="relative mt-8 space-y-10">
                <span
                  class="absolute bottom-4 left-[7px] top-4 w-0.5 rounded-full"
                  style={`background-color: ${phase.color};`}
                  aria-hidden="true"
                ></span>

                {
                  phase.entries.map((entry) => (
                    <li class="relative pl-8 sm:pl-10">
                      <span
                        class="absolute left-0 top-7 flex h-4 w-4 items-center justify-center rounded-full border-2 bg-white dark:bg-zinc-900"
                        style={`border-color: ${phase.color};`}
                        aria-hidden="true"
                      >
                        <span
                          class="h-1.5 w-1.5 rounded-full"
                          style={`background-color: ${phase.color};`}
                        ></span>
                      </span>

                      {
                        entry.type === "mvp" ? (
                          <ProjectShowcase entry={entry} />
                        ) : (
                          <TimelineEntry entry={entry} />
                        )
                      }
                    </li>
                  ))
                }
              </ol>
            </section>
          ))
        }
      </div>
    </section>

    <!-- ===================== LETTER TO NEXT COHORT ===================== -->
    <section id="letter" class="mt-20 scroll-mt-24" aria-labelledby="letter-heading">
      <div class="mx-auto max-w-[68ch]">
        <h2 id="letter-heading" class="text-2xl font-bold text-stone-900 dark:text-zinc-50">
          Letter to the Next Cohort
        </h2>

        <div class="mt-6 rounded-2xl border border-stone-200 bg-white/90 p-7 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/80">
          <p class="text-stone-700 dark:text-zinc-300 leading-relaxed">
            Dear future ETEC 522 cohort — two small suggestions, offered with
            gratitude for a course that rewarded showing up:
          </p>
          <ul class="mt-4 space-y-3 text-stone-700 dark:text-zinc-300 leading-relaxed">
            <li class="flex gap-3">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--theme-cinnabar)]" aria-hidden="true"></span>
              <span>
                <strong class="font-semibold text-stone-900 dark:text-zinc-100">Reduce platform friction.</strong>{" "}
                The WordPress comment system silently rejected posts containing
                hyperlinks or emoji (a database error), costing participants hours
                and cluttering threads with test replies. A clearer error message,
                or a markdown-friendly comment field, would protect the very
                conversational flow this portfolio is meant to reward.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--theme-royal-blue)]" aria-hidden="true"></span>
              <span>
                <strong class="font-semibold text-stone-900 dark:text-zinc-100">Pilot “VC Partner” Peer Circles.</strong>{" "}
                Pair each learner with a small, stable circle of investors who
                review one another's pitches across the term, so critical feedback
                is sustained and structured rather than concentrated in the final
                weeks.
              </span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</PageLayout>
