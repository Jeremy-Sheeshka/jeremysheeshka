---
const name = "Jeremy Sheeshka".split("");
---

<header class="wrapper">
  <a href="#main" class="skip-link">Skip to main content</a>

  <div class="repel ontop gutter-s row-1">
    <a href="/" class="logo cluster">
      <div id="name" class="homemade-apple-regular">
        {name.map((char, i) => (
          <span style={`animation-delay: ${i * 120}ms`}>
            {char === " " ? " " : char}
          </span>
        ))}
      </div>
    </a>
  </div>
</header>
