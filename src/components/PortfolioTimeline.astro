---
import { phases, getPostingsByPhase } from "@/data/portfolioData";
import TimelineEntry from "./TimelineEntry.astro";

const phaseData = phases.map((phase) => ({
  ...phase,
  entries: getPostingsByPhase(phase.phase),
}));
---

<h2 class="text-xl font-bold text-stone-900 dark:text-zinc-50">List of Postings &amp; Reviews</h2>
<p class="mt-2 max-w-2xl text-stone-600 dark:text-zinc-400">
  Ten contributions across every stage of the course — weekly discussion posts and peer reviews.
</p>

<div class="mt-8 space-y-12">
  {
    phaseData.map((phase) => (
      <section>
        <header class="flex flex-wrap items-center gap-3">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-full text-base font-black text-white"
            style={`background-color: ${phase.color};`}
            aria-hidden="true"
          >
            {phase.phase}
          </span>
          <div>
            <h3 class="text-base font-bold text-stone-900 dark:text-zinc-50">{phase.label}</h3>
            <p class="text-sm text-stone-500 dark:text-zinc-400">{phase.description}</p>
          </div>
        </header>

        <div class="relative mt-6">
          <span
            class="absolute bottom-3 left-[7px] top-3 w-0.5 rounded-full"
            style={`background-color: ${phase.color};`}
            aria-hidden="true"
          ></span>
          <ol class="space-y-6">
            {phase.entries.map((entry) => <TimelineEntry entry={entry} />)}
          </ol>
        </div>
      </section>
    ))
  }
</div>
