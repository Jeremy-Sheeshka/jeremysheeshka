---
import Nav from "./Nav.astro";
import LanguageSwitcher from "../i18n/LanguageSwitcher.astro";
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href="/">Jeremy Sheeshka</a>

    <div class="header-right">
      <Nav />
      <LanguageSwitcher />
    </div>
  </div>
</header>

<style>
.site-header {
  border-bottom: 1px solid var(--border, #ddd);
  padding: 1rem 0;
}

.inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.logo {
  font-weight: 700;
  text-decoration: none;
  font-size: 1.1rem;
}
</style>
