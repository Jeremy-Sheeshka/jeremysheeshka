		viewBox: "0 0 24 24",
		fill: "currentColor",
		stroke: "none",
		isMe: true,
	},
	{
		name: "YouTube",
		url: "https://www.youtube.com/@jeremysheeshka1023",
		iconPath:
			"M24.325 8.309s-2.655-.334-8.357-.334c-5.517 0-8.294.334-8.294.334A2.675 2.675 0 0 0 5 10.984v10.034a2.675 2.675 0 0 0 2.674 2.676s2.582.332 8.294.332c5.709 0 8.357-.332 8.357-.332A2.673 2.673 0 0 0 27 21.018V10.982a2.673 2.673 0 0 0-2.675-2.673zM13.061 19.975V12.03L20.195 16l-7.134 3.975z",
		viewBox: "0 0 32 32",
		fill: "currentColor",
		stroke: "none",
		isMe: false,
	},
	{
		name: "Mastodon",
		url: "https://mastodon.social/@jsheeshka",
		iconPath:
			"M499 112q-93 1 -166 11q-81 11 -128 33l-14 8q-16 10 -32 25q-22 21 -38 47q-21 33 -32 73q-14 47 -14 103v37q0 77 1 119q3 113 18 188q19 95 62 154q50 67 134 89q109 29 210 24q46 -3 88 -12q30 -7 55 -17l19 -8l-4 -75l-22 6q-28 6 -57 10q-41 6 -78 4q-53 -1 -80 -7 q-43 -8 -67 -30q-29 -25 -35 -72q-2 -14 -2 -29l25 6q31 6 65 10q48 7 93 9q42 2 92 -2q32 -2 88 -9t107 -30q49 -23 81.5 -54.5t38.5 -63.5q9 -45 13 -109q4 -46 5 -97v-41q0 -56 -14 -103q-11 -40 -32 -73q-16 -26 -38 -47q-15 -15 -32 -25q-12 -8 -14 -8 q-46 -22 -127 -33q-74 -10 -166 -11h-3zM367 267q73 0 109 56l24 39l24 -39q36 -56 109 -56q63 0 101 43t38 117v239h-95v-232q0 -74 -61 -74q-69 0 -69 88v127h-94v-127q0 -88 -69 -88q-61 0 -61 74v232h-95v-239q0 -74 38 -117t101 -43z",
		viewBox: "-10 -5 1034 1034",
		fill: "currentColor",
		stroke: "none",
		isMe: true,
	},
];
---

<footer class={`mt-auto w-full transition-colors duration-300 ${themeClass}`}>
	{
		!isHome && (
			<div class="w-full translate-y-px transform overflow-hidden leading-[0]">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 100 20"
					preserveAspectRatio="none"
					class="block h-20 w-full sm:h-28"
					style="fill: var(--footer-bg); transform: scale(1.01); transform-origin: bottom;"
					aria-hidden="true"
				>
					<path id="footer-wave-path" />
				</svg>
			</div>
		)
	}

	<div
		class="w-full px-6 pt-4 pb-8 md:px-12"
		style="background-color: var(--footer-bg); color: var(--footer-text);"
	>
		<div class="flex w-full flex-row items-center justify-between gap-4 text-xs font-semibold">
			<div class="whitespace-nowrap">© {siteConfig.author} {year}.</div>
			<nav aria-label="Social links" class="flex items-center gap-x-4">
				{
					socialLinks.map((link) => (
						<a
							href={link.url}
							class="inline-block transition-opacity hover:opacity-75"
							style="color: inherit;"
							target="_blank"
							rel={link.isMe ? "me" : "noreferrer noopener"}
						>
							<svg viewBox={link.viewBox || "0 0 24 24"} class="h-5 w-5" fill={link.fill}>
								<path d={link.iconPath} fill-rule="evenodd" clip-rule="evenodd" />
							</svg>
						</a>
					))
				}
			</nav>
		</div>
	</div>
</footer>

<script>
	const path = document.getElementById("footer-wave-path");
	const footer = path?.closest("footer");

	if (path && footer) {
		const numPoints = 60;
		const step = 100 / (numPoints - 1);

		// ── Physics ───────────────────────────────────────────────────────────
		// Soft spring + high friction = smooth glide, minimal overshoot.
		const tension = 0.018;
		const damping = 0.93;
		const spread = 0.1;
		const baselineY = 8;

		// ── Ambient wave ──────────────────────────────────────────────────────
		// Four overlapping sines at different speeds and frequencies.
		// Amplitudes are large enough that the resting wave is clearly visible
		// and organic-looking. A fourth layer adds fine texture.
		// The drift speed is slightly faster than before (0.010) so the wave
		// feels alive and in motion even without any cursor interaction.
		let time = 0;
		const TIME_STEP = 0.006;

		function ambientY(i, t) {
			const x = i / (numPoints - 1);
			return (
				baselineY +
				Math.sin(x * Math.PI * 2.0 + t * 0.55) * 2.4 + // big slow roll
				Math.sin(x * Math.PI * 3.7 - t * 0.38) * 1.2 + // mid counter-roll
				Math.sin(x * Math.PI * 5.8 + t * 0.22) * 0.55 + // faster ripple
				Math.sin(x * Math.PI * 8.1 - t * 0.6) * 0.2
			); // fine texture
		}

		// Initialise pre-shaped so the wave is alive from the very first frame.
		const currentY = Array.from({ length: numPoints }, (_, i) => ambientY(i, 0));
		const targetY = Array.from({ length: numPoints }, (_, i) => ambientY(i, 0));
		const velocities = new Array(numPoints).fill(0);

		// ── Cursor influence ──────────────────────────────────────────────────
		// cursorInfluence blends 0 (pure ambient) → 1 (pure cursor dip).
		//
		// FADE_IN  : ~30 frames (~0.5 s) — snappy but not jarring.
		// FADE_OUT : ~330 frames (~5.5 s) — so slow the ambient motion
		//            completely masks it; no visible retract.
		//
		// The dip itself is wider (sigma 10) and deeper (peakLift 3.2) than
		// before, making it feel like the surface is genuinely being pulled up.

		let mouseOver = false;
		let cursorIndex = Math.floor(numPoints / 2);
		let cursorInfluence = 0;

		const FADE_IN = 0.033;
		const FADE_OUT = 0.003;
		const peakLift = 3.2;
		const sigma = 10;

		footer.addEventListener("mousemove", (e) => {
			mouseOver = true;
			const rect = footer.getBoundingClientRect();
			cursorIndex = Math.round(((e.clientX - rect.left) / rect.width) * (numPoints - 1));
		});

		footer.addEventListener("mouseleave", () => {
			mouseOver = false;
			// cursorIndex intentionally NOT reset — the dip fades from its
			// exit position so there is no sudden positional jump.
		});

		// ── Animation loop ────────────────────────────────────────────────────
		function animate() {
			time += TIME_STEP;

			// Advance influence weight toward its target (1 or 0).
			cursorInfluence += mouseOver ? FADE_IN : -FADE_OUT;
			cursorInfluence = Math.max(0, Math.min(1, cursorInfluence));

			// 1. Blend ambient ↔ cursor dip to get each point's target Y.
			for (let i = 0; i < numPoints; i++) {
				const ambient = ambientY(i, time);
				const dist = Math.abs(i - cursorIndex);
				const cursorTarget = baselineY - peakLift * Math.exp(-(dist * dist) / (2 * sigma * sigma));
				targetY[i] = ambient + cursorInfluence * (cursorTarget - ambient);
			}

			// 2. Propagate wave energy to neighbours.
			const leftDeltas = new Array(numPoints).fill(0);
			const rightDeltas = new Array(numPoints).fill(0);

			for (let j = 0; j < 8; j++) {
				for (let i = 0; i < numPoints; i++) {
					if (i > 0) {
						leftDeltas[i] = spread * (currentY[i] - currentY[i - 1]);
						velocities[i - 1] += leftDeltas[i];
					}
					if (i < numPoints - 1) {
						rightDeltas[i] = spread * (currentY[i] - currentY[i + 1]);
						velocities[i + 1] += rightDeltas[i];
					}
				}
				for (let i = 0; i < numPoints; i++) {
					if (i > 0) currentY[i - 1] += leftDeltas[i];
					if (i < numPoints - 1) currentY[i + 1] += rightDeltas[i];
				}
			}

			// 3. Spring each point toward target, then damp.
			for (let i = 0; i < numPoints; i++) {
				const force = tension * (targetY[i] - currentY[i]);
				velocities[i] = (velocities[i] + force) * damping;
				currentY[i] += velocities[i];
			}

			// 4. Draw smooth quadratic-curve path.
			let d = `M 0 20 L 0 ${currentY[0].toFixed(2)} `;
			for (let i = 0; i < numPoints - 1; i++) {
				const x1 = i * step;
				const x2 = (i + 1) * step;
				const xc = (x1 + x2) / 2;
				const yc = (currentY[i] + currentY[i + 1]) / 2;
				d += `Q ${x1.toFixed(2)} ${currentY[i].toFixed(2)} ${xc.toFixed(2)} ${yc.toFixed(2)} `;
			}
			d += `L 100 ${currentY[numPoints - 1].toFixed(2)} L 100 20 V 20 H 0 Z`;

			path.setAttribute("d", d);
			requestAnimationFrame(animate);
		}

		animate();
	}
</script>

<style>
	footer.theme-home {
		--footer-bg: transparent;
		--footer-text: currentColor;
	}
	footer.theme-cinnabar {
		--footer-bg: var(--theme-cinnabar);
		--footer-text: #ffffff;
	}
	footer.theme-royal-blue {
		--footer-bg: var(--theme-royal-blue);
		--footer-text: #ffffff;
	}
	footer.theme-bright-sun {
		--footer-bg: var(--theme-bright-sun);
		--footer-text: #1a1810;
	}
</style>
