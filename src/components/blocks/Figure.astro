---
const { src, alt, caption, class: className = "" } = Astro.props;
---

<figure class={`my-8 ${className}`}>
  <img src={src} alt={alt} loading="lazy" class="w-full rounded-2xl border border-border" />
  {caption ? <figcaption class="mt-3 text-center text-sm opacity-80">{caption}</figcaption> : null}
</figure>
