---
/**
 * Disclosure — the Callout, folded shut.
 *
 * Same box and the same coloured left rule as Callout, but the body starts
 * closed, so a long note can sit in the flow of a post without pushing
 * everything below it off the page.  It is a native <details>, so it needs no
 * JavaScript and is keyboard-operable for free.
 */
const { title = "Note", variant = "note", class: className = "" } = Astro.props;

const variants = {
    note: "border-l-ring",
    tip: "border-l-chart-2",
    warning: "border-l-destructive",
};
const v = variants[variant] ?? variants.note;
---

<details class={`group rounded-2xl border border-border border-l-[6px] bg-muted/40 ${v} ${className}`}>
    <summary
        class="flex cursor-pointer select-none items-center gap-3 p-4 font-bold [&::-webkit-details-marker]:hidden"
    >
        <svg
            class="size-4 shrink-0 transition-transform duration-200 group-open:rotate-90"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M6 3.5 10.5 8 6 12.5"></path>
        </svg>
        <span>{title}</span>
    </summary>
    <div class="px-4 pb-4 text-sm leading-relaxed">
        <slot />
    </div>
</details>
