---
const { url } = Astro;
const segments = url.pathname.split("/").filter(Boolean);

const supported = ["en", "de", "fr"];

// detect language anywhere in the URL
const currentLang = supported.find((l) => segments.includes(l)) || "en";

// rebuild path for target language
function switchLang(lang) {
  const newSegments = segments.map((seg) =>
    supported.includes(seg) ? lang : seg
  );

  return "/" + newSegments.join("/") + "/";
}
---

<nav class="lang-switcher">
  <a
    href={switchLang("en")}
    aria-current={currentLang === "en" ? "true" : undefined}
  >
    EN
  </a>

  <a
    href={switchLang("de")}
    aria-current={currentLang === "de" ? "true" : undefined}
  >
    DE
  </a>
</nav>

<style>
.lang-switcher {
  display: flex;
  gap: 0.75rem;
  font-size: 0.9rem;
}

.lang-switcher a[aria-current="true"] {
  font-weight: 700;
  text-decoration: underline;
}
</style>
