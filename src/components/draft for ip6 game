<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>MARIO: SURVIVANCE — Against Erasure & Straightwashing</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&display=swap');

  :root {
    --pink: #ff4da6;
    --purple: #9b40d4;
    --gold: #ffd700;
    --green: #00e87a;
    --bg: #07030f;
    --overlay-bg: rgba(7,3,15,0.97);
    --border: #9b40d4;
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    width: 100vw;
    font-family: 'Share Tech Mono', 'Courier New', monospace;
    overflow: hidden;
    flex-direction: column;
  }

  #wrap {
    position: relative;
    display: inline-block;
  }

  canvas {
    display: block;
    image-rendering: pixelated;
    border: 3px solid #ff4da6;
    box-shadow: 0 0 0 2px #9b40d4, 0 0 30px #ff4da650, 0 0 80px #9b40d430;
  }

  #hud {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 24px;
    font-size: 14px;
    font-weight: bold;
    color: var(--gold);
    background: rgba(7,3,15,0.9);
    padding: 6px 20px;
    border-radius: 30px;
    border: 1px solid var(--pink);
    font-family: 'VT323', monospace;
    letter-spacing: 1px;
    z-index: 5;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }
  #hud span { color: white; margin-left: 6px; }
  #hud span:first-child { color: var(--gold); }

  #ctrl-hint {
    position: absolute;
    bottom: 10px;
    right: 16px;
    font-size: 10px;
    background: rgba(0,0,0,0.6);
    padding: 4px 8px;
    border-radius: 12px;
    color: #aaa;
    z-index: 5;
  }
  kbd {
    background: #1a1030;
    border: 1px solid var(--pink);
    border-radius: 4px;
    padding: 2px 6px;
    color: #ffb3d9;
    font-family: monospace;
  }

  #dlg {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 680px;
    max-width: calc(100% - 30px);
    background: #0c0520e6;
    border-left: 6px solid var(--pink);
    border-radius: 0 12px 12px 0;
    padding: 14px 18px;
    z-index: 20;
    display: none;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 28px black;
  }
  #dlg-title {
    font-family: 'VT323', monospace;
    color: var(--gold);
    font-size: 20px;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }
  #dlg-text {
    color: #e2d6ff;
    font-size: 12px;
    line-height: 1.6;
    max-height: 100px;
    overflow-y: auto;
  }
  #dlg-close {
    margin-top: 12px;
    background: transparent;
    border: 1px solid var(--pink);
    color: var(--pink);
    padding: 4px 20px;
    cursor: pointer;
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    transition: all 0.2s;
  }
  #dlg-close:hover { background: var(--pink); color: #0c0520; }

  #overlay {
    position: absolute;
    inset: 0;
    background: rgba(7,3,15,0.98);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 30;
    text-align: center;
    padding: 20px;
  }
  .game-title {
    font-family: 'VT323', monospace;
    font-size: 54px;
    letter-spacing: 6px;
    background: linear-gradient(135deg,#ff0080,#ff69b4,#da70d6,#00e87a,#ffd700);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 8px;
  }
  .intro-body {
    color: #cfc4f0;
    font-size: 12px;
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .start-btn {
    font-family: 'VT323', monospace;
    background: var(--pink);
    border: none;
    color: #07030f;
    padding: 12px 40px;
    font-size: 28px;
    cursor: pointer;
    transition: 0.2s;
    box-shadow: 0 0 15px #ff4da6;
  }
  .start-btn:hover { transform: scale(1.03); background: #ff80c0; }
  .stats-grid { display: flex; gap: 20px; margin: 15px 0; }
  .stat-box { border: 1px solid var(--pink); padding: 8px 20px; background: #1a1030; }
  .sval { font-size: 32px; color: var(--gold); font-family: 'VT323'; }
</style>
</head>
<body>
<div id="wrap">
  <canvas id="gameCanvas" width="800" height="480"></canvas>
  <div id="hud">
    🌟 WORLD <span id="h-lvl">1</span> &nbsp;| 🧠 GEMS <span id="h-gems">0</span> &nbsp;| ✦ EDUCATED <span id="h-edu">0</span> &nbsp;| 🍄 SCORE <span id="h-score">0</span>
  </div>
  <div id="ctrl-hint">
    <kbd>← →</kbd> MOVE &nbsp; <kbd>↑</kbd>/<kbd>SPACE</kbd> JUMP &nbsp; <kbd>E</kbd> EDUCATE (non-violent)
  </div>
  <div id="dlg"><div id="dlg-title"></div><div id="dlg-text"></div><button id="dlg-close">⚡ CONTINUE ⚡</button></div>
  <div id="overlay">
    <div class="game-title">🍄 MARIO: SURVIVANCE</div>
    <div class="game-sub" style="color:#ff4da6; font-size:14px; margin-bottom:12px;">⚧ THEY/THEM PLUMBER ⚧</div>
    <p class="intro-body">
      <strong>NOT A STRAIGHTWASHED MARIO.</strong> You are <strong>Mx. Plumber (they/them)</strong> — a queer game worker<br>
      fighting systemic erasure. Jump & collect <strong style="color:#ffd700">★ Knowledge Gems</strong>. Press <strong>[E]</strong> near Gatekeepers<br>
      to <strong>EDUCATE</strong> instead of stomping them. This game rejects colonial violence & heteronormativity.<br>
      Inspired by <em>Undertale, Never Alone, Hair Nah</em> & critical race/gender scholarship.
    </p>
    <div class="keys-row" style="margin:12px 0; font-size:11px;"><kbd>← →</kbd> Move | <kbd>↑</kbd> Jump | <kbd>E</kbd> Educate Gatekeepers</div>
    <button class="start-btn" id="start-btn">🌈 START RESISTING 🌈</button>
  </div>
</div>

<script>
  (function(){
    // --- CANVAS & CONTEXT
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const W = 800, H = 480;
    canvas.width = W; canvas.height = H;

    // --- INPUT
    const keys = {};
    document.addEventListener('keydown', e => {
      keys[e.code] = keys[e.key] = true;
      if (['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','KeyE'].includes(e.code)) e.preventDefault();
    });
    document.addEventListener('keyup', e => { keys[e.code] = keys[e.key] = false; });

    // --- GLOBAL STATE
    let score = 0, gemsTotal = 0, eduTotal = 0, levelIdx = 0;
    let dialogOpen = false, dialogQueue = [];
    let particles = [];
    let cameraX = 0;
    let gameStarted = false;
    let advancing = false;

    // DIALOGUE SYSTEM
    const dlgEl = document.getElementById('dlg');
    const dlgTitle = document.getElementById('dlg-title');
    const dlgText = document.getElementById('dlg-text');
    const dlgClose = document.getElementById('dlg-close');
    dlgClose.addEventListener('click', closeDialog);
    document.addEventListener('keydown', e => { if (e.key === 'Enter' && dialogOpen) closeDialog(); });
    function closeDialog() { dlgEl.style.display = 'none'; dialogOpen = false; processQueue(); }
    function showDialog(title, text) { dialogQueue.push({title, text}); if (!dialogOpen) processQueue(); }
    function processQueue() { if (!dialogQueue.length) return; const {title, text} = dialogQueue.shift(); dlgTitle.textContent = title; dlgText.textContent = text; dlgEl.style.display = 'block'; dialogOpen = true; }

    // --- PARTICLES
    function burst(x, y, color, n=18) { for (let i=0;i<n;i++) { let a = Math.PI*2*i/n; let s=2+Math.random()*4; particles.push({x,y, vx:Math.cos(a)*s, vy:Math.sin(a)*s-2, color, life:1, sz:3+Math.random()*5}); } }

    // --- PLATFORM
    class Platform { constructor(x,y,w,h,color='#5a3e2e') { this.x=x; this.y=y; this.w=w; this.h=h; this.color=color; }
      draw() { let sx = this.x - cameraX; if(sx+this.w<-20||sx>W+20) return; ctx.fillStyle=this.color; ctx.fillRect(sx,this.y,this.w,this.h); ctx.fillStyle='rgba(255,215,0,0.2)'; ctx.fillRect(sx,this.y,this.w,3); } }

    // --- QUESTION BLOCK (Mario style)
    class QuestionBlock { constructor(x, y, gemTitle, gemText) { this.x=x; this.y=y; this.w=32; this.h=32; this.active=true; this.gemTitle=gemTitle; this.gemText=gemText; this.anim=0; }
      draw() { if(!this.active) return; let sx=this.x-cameraX; if(sx+this.w<0||sx>W) return; ctx.fillStyle='#e8b05e'; ctx.fillRect(sx,this.y,this.w,this.h); ctx.fillStyle='#b87c2e'; ctx.fillRect(sx+4,this.y+4,24,24); ctx.fillStyle='#f9e45b'; ctx.font='bold 24px "VT323"'; ctx.textAlign='center'; ctx.fillText('?', sx+16, this.y+28); }
      interact(player) { if(!this.active) return false; if(player.y+player.h > this.y && player.y+player.h < this.y+20 && player.x+player.w/2 > this.x && player.x+player.w/2 < this.x+this.w && player.vy>0) { this.active=false; return true; } return false; } }

    // --- GEM (Knowledge)
    class Gem { constructor(x,y,color,title,text) { this.x=x; this.y=y; this.color=color; this.title=title; this.text=text; this.collected=false; this.t=Math.random()*100; }
      draw() { if(this.collected) return; this.t++; let sx=this.x-cameraX; let bob=Math.sin(this.t*0.1)*4; ctx.save(); ctx.shadowBlur=12; ctx.shadowColor=this.color; ctx.fillStyle=this.color; ctx.beginPath(); ctx.moveTo(sx+12,this.y+bob); ctx.lineTo(sx+22,this.y+10+bob); ctx.lineTo(sx+12,this.y+22+bob); ctx.lineTo(sx+2,this.y+10+bob); ctx.fill(); ctx.fillStyle='white'; ctx.font='bold 10px monospace'; ctx.fillText('★', sx+8, this.y+13+bob); ctx.restore(); } }

    // --- GATEKEEPER (Enemies but educated via E, not stomped)
    const GATEKEEPER_TYPES = { whitewasher:{c1:'#6f6f8a',c2:'#9a8faa',label:'WHITEWASHER'}, harasser:{c1:'#8b3c3c',c2:'#c25a5a',label:'HARASSER'}, troll:{c1:'#2d6a4f',c2:'#40916c',label:'TROLL'}, eraser:{c1:'#2b2d42',c2:'#4a4e69',label:'ERASER'} };
    class Gatekeeper { constructor(x,y,type,eduTitle,eduText,range=100) { this.x=x; this.y=y; this.w=28; this.h=32; this.type=type; this.eduTitle=eduTitle; this.eduText=eduText; this.educated=false; this.dir=1; this.startX=x; this.range=range; this.speed=type==='troll'?1.8:1.2; this.t=Math.random()*100; }
      update() { if(this.educated) return; this.t++; this.x+=this.speed*this.dir; if(this.x>this.startX+this.range||this.x<this.startX-this.range) this.dir*=-1; }
      draw() { let sx=this.x-cameraX; if(sx+this.w<-30||sx>W+30) return; let info=GATEKEEPER_TYPES[this.type]; ctx.save(); ctx.translate(sx+this.w/2, this.y+this.h/2); if(this.educated){ ctx.fillStyle='#00e87a'; ctx.shadowBlur=16; ctx.beginPath(); ctx.arc(0,0,18,0,Math.PI*2); ctx.fill(); ctx.fillStyle='#07030f'; ctx.font='bold 14px "VT323"'; ctx.fillText('♥', -6,6); ctx.font='8px monospace'; ctx.fillText('ALLY', -10, -8); ctx.restore(); return; } ctx.fillStyle=info.c1; ctx.fillRect(-12,-6,24,16); ctx.fillStyle=info.c2; ctx.fillRect(-9,-22,18,16); ctx.fillStyle='#ff7777'; ctx.fillRect(-6,-18,4,3); ctx.fillRect(2,-18,4,3); ctx.fillStyle='#222'; ctx.fillRect(-8,-20,6,2); ctx.fillRect(2,-20,6,2); ctx.fillStyle='#ffb347'; ctx.font='6px monospace'; ctx.fillText(info.label, -15,-28); ctx.restore(); let dx = (player.x+player.w/2)-(this.x+this.w/2); let dy=(player.y+player.h/2)-(this.y+this.h/2); if(Math.abs(dx)<90 && Math.abs(dy)<70 && !this.educated){ ctx.save(); ctx.strokeStyle='#00e87a'; ctx.setLineDash([4,6]); ctx.beginPath(); ctx.arc(sx+this.w/2, this.y+this.h/2, 80,0,Math.PI*2); ctx.stroke(); ctx.font='9px "Share Tech Mono"'; ctx.fillStyle='#00e87a'; ctx.fillText('[E] EDUCATE', sx+this.w/2-35, this.y-12); ctx.restore(); } } }

    // --- FLAGPOLE (anti-colonial finish)
    class Flagpole { constructor(x, y, label) { this.x=x; this.y=y; this.label=label; this.w=20; this.h=110; this.t=0; }
      draw() { this.t++; let sx=this.x-cameraX; ctx.fillStyle='#aa8c5e'; ctx.fillRect(sx, this.y, 8, this.h); let flagW=70; let colors=['#ff0018','#ffa52c','#ffff41','#008018','#0000f9','#86007d']; for(let i=0;i<colors.length;i++){ ctx.fillStyle=colors[i]; ctx.fillRect(sx+8, this.y+10+i*8, flagW- (Math.sin(this.t*0.05+i)*5), 7); } ctx.fillStyle='#ffd966'; ctx.font='bold 9px monospace'; ctx.fillText(this.label, sx+15, this.y-6); } }

    // --- PLAYER (QUEER PLUMBER)
    const player = {
      x:80, y:300, w:28, h:34, vx:0, vy:0, onGround:false, facing:1, walkCycle:0, eduCool:0, trail:[],
      reset(x,y){ this.x=x; this.y=y; this.vx=0; this.vy=0; this.onGround=false; this.eduCool=0; },
      update(){
        if(dialogOpen) return;
        let lvl = levels[levelIdx];
        let spd=4.6;
        if(keys['ArrowLeft']||keys['KeyA']){ this.vx=-spd; this.facing=-1; }
        else if(keys['ArrowRight']||keys['KeyD']){ this.vx=spd; this.facing=1; }
        else this.vx*=0.7;
        if((keys['ArrowUp']||keys['KeyW']||keys['Space']) && this.onGround){ this.vy=-12.5; this.onGround=false; }
        this.vy=Math.min(this.vy+0.55, 14);
        this.x+=this.vx; this.y+=this.vy;
        this.onGround=false;
        for(let p of lvl.platforms){
          if(this.x+this.w>p.x+4 && this.x<p.x+p.w-4 && this.y+this.h>=p.y && this.y+this.h<=p.y+p.h+Math.abs(this.vy)+2 && this.vy>=0){ this.y=p.y-this.h; this.vy=0; this.onGround=true; }
          if(this.x+this.w>p.x+4 && this.x<p.x+p.w-4 && this.y<=p.y+p.h && this.y>=p.y && this.vy<0){ this.y=p.y+p.h; this.vy=0; }
          if(this.y+this.h>p.y+5 && this.y<p.y+p.h-5){ if(this.x+this.w>p.x && this.x+this.w<p.x+14){ this.x=p.x-this.w; this.vx=0; } if(this.x<p.x+p.w && this.x>p.x+p.w-14){ this.x=p.x+p.w; this.vx=0; } }
        }
        if(this.y+this.h>H-10){ this.y=H-10-this.h; this.vy=0; this.onGround=true; }
        if(this.y<0){ this.y=0; this.vy=0; }
        if(this.x<0) this.x=0;
        if(this.x+this.w>lvl.width) this.x=lvl.width-this.w;
        if(this.y>H+70) this.reset(lvl.startX, lvl.startY);
        let target = this.x - W/2 + this.w/2;
        cameraX += (Math.max(0, Math.min(target, lvl.width-W)) - cameraX)*0.12;
        if(Math.abs(this.vx)>0.6 && this.onGround) this.walkCycle=(this.walkCycle+1)%8;
        else this.walkCycle=0;
        this.trail.push({x:this.x+this.w/2, y:this.y+this.h/2, life:1}); if(this.trail.length>10) this.trail.shift(); this.trail.forEach(t=>t.life-=0.07);
        if(this.eduCool>0) this.eduCool--;
        if((keys['KeyE']||keys['e']) && this.eduCool===0){ this.tryEducate(); this.eduCool=38; }
        for(let g of lvl.gems){ if(!g.collected && Math.abs(this.x+this.w/2-g.x-12)<34 && Math.abs(this.y+this.h/2-g.y-12)<34){ g.collected=true; gemsTotal++; score+=15; updateHUD(); burst(g.x,g.y,g.color); showDialog(g.title,g.text); } }
        for(let q of lvl.blocks){ if(q.interact(this)){ score+=25; gemsTotal++; updateHUD(); burst(q.x+16,q.y+8,'#ffcc44'); showDialog(q.gemTitle, q.gemText); } }
        if(lvl.flagpole && this.x+this.w>lvl.flagpole.x-10 && this.x<lvl.flagpole.x+40 && this.y+this.h>lvl.flagpole.y-10 && this.y<lvl.flagpole.y+120) nextLevel();
      },
      tryEducate(){
        let lvl=levels[levelIdx];
        for(let en of lvl.enemies){ if(!en.educated && Math.abs(this.x+this.w/2-(en.x+en.w/2))<95 && Math.abs(this.y+this.h/2-(en.y+en.h/2))<75){ en.educated=true; eduTotal++; score+=40; updateHUD(); burst(en.x+en.w/2, en.y+en.h/2, '#00ffaa',26); showDialog(en.eduTitle, en.eduText); return; } }
        showDialog('⚡ EDUCATE, NOT STOMP', 'In this queer reimagining of Mario, you do NOT kill enemies. Press E near Gatekeepers to share critical knowledge about race, gender & sexuality in games. Violence is colonial — education is survivance.');
      },
      draw(){
        this.trail.forEach((t,i)=>{ if(t.life>0){ ctx.globalAlpha=t.life*0.4; ctx.fillStyle=['#ff4da6','#ffd700','#00e87a','#9b40d4'][i%4]; ctx.fillRect(t.x-cameraX-3, t.y-3, 6,6); ctx.globalAlpha=1; } });
        ctx.save(); ctx.translate(this.x-cameraX+(this.facing<0?this.w:0), this.y); if(this.facing<0) ctx.scale(-1,1);
        // overalls & shirt
        ctx.fillStyle='#e52525'; ctx.fillRect(4,12,20,20); // red shirt
        ctx.fillStyle='#2350a0'; ctx.fillRect(0,20,28,18); // blue overalls
        ctx.fillStyle='#f7d44a'; ctx.fillRect(10,6,8,8); // gold buttons
        ctx.fillStyle='#ffbc7a'; ctx.fillRect(8,0,12,12); // face
        ctx.fillStyle='#6b3e1a'; ctx.fillRect(5,2,4,4); ctx.fillRect(19,2,4,4); // eyes
        ctx.fillStyle='white'; ctx.fillRect(6,3,2,2); ctx.fillRect(20,3,2,2);
        ctx.fillStyle='#e89e5c'; ctx.fillRect(12,8,4,2); // nose
        ctx.fillStyle='#3a2a1a'; ctx.fillRect(9,12,10,3); // mustache (non-gender specific playful)
        ctx.fillStyle='#d4320f'; ctx.fillRect(0,6,28,6); // red cap
        ctx.fillStyle='#ffb347'; ctx.fillRect(8,0,12,6); // cap brim
        ctx.fillStyle='#ff4da6'; ctx.font='bold 9px monospace'; ctx.fillText('⚧', 12, -2); // pride symbol on cap
        ctx.fillStyle='white'; ctx.font='7px monospace'; ctx.fillText('they/them', 4, 32);
        ctx.restore();
        // floating pronoun badge
        ctx.font='bold 8px "VT323"'; ctx.fillStyle='#ff80c0'; ctx.fillText('🏳️‍⚧️ they/them', this.x-cameraX+4, this.y-6);
      }
    };

    // --- LEVEL DATA (MARIO THEMED + SURVIVANCE CORE) - fixed gem arguments
    function makeLevel1(){
      return { name:'🏰 WHITEWASHED KINGDOM', bg1:'#0a0c2a', bg2:'#18204a', width:2700, startX:80, startY:380,
        intro:{ title:'STRAIGHTWASHING MARIO? NEVER.', text:'Most mainstream platformers erase queer & BIPOC stories. 81% of devs are white. You are a plumber who educates, not conquers. Collect Gems & teach Gatekeepers.' },
        platforms:[new Platform(0,430,2700,24,'#5a3c2a'), new Platform(160,370,100,16,'#6b4c3a'), new Platform(320,330,120,16,'#6b4c3a'), new Platform(520,290,120,16,'#7d5a42'), new Platform(740,340,140,16,'#6b4c3a'), new Platform(960,300,120,16,'#7d5a42'), new Platform(1180,260,140,16,'#6b4c3a'), new Platform(1400,310,120,16,'#7d5a42'), new Platform(1620,280,140,16,'#6b4c3a'), new Platform(1880,330,120,16,'#7d5a42'), new Platform(2120,290,140,16,'#6b4c3a'), new Platform(2380,350,140,16,'#7d5a42') ],
        enemies:[ new Gatekeeper(280,396,'whitewasher','WHITEWASHING & THE DIVERSITY DEFICIT','81% of game devs are white (IGDA). Only 2% Black, 7% Latinx. This lack of diversity creates games that erase marginalized experiences.'),
                  new Gatekeeper(680,306,'eraser','"STRAIGHTWASHING" – QUEER ERASURE','Undertale: nonbinary protagonist, LGBTQ+ romance, consent mechanics. Yet gamers erased queerness, celebrating only "mechanical difficulty". That is straightwashing.'),
                  new Gatekeeper(1050,276,'harasser','RACIST TROPES IN GAMES','Black characters reduced to stereotypes: thugs, sidekicks, or "Black death" spectacles (Battlefield 1). Games reproduce real-world harm.'),
                  new Gatekeeper(1510,326,'troll','RAPE CULTURE IN GAMING','"I raped you" as trash talk, women as objects. Gaming normalizes sexual violence. We must change the culture.'),
                  new Gatekeeper(2030,346,'whitewasher','WOKE-WASHING IS NOT ENOUGH','Adding a queer skin a month before launch is not justice. Diversity must be structural from day one.') ],
        gems:[ new Gem(200,348,'#ffd700','DEMOGRAPHIC REALITY','57% of young gamers are POC, but the industry remains white-dominated.'),
               new Gem(410,268,'#ff4da6','SURVIVANCE','Active resistance, joy, and presence. Not mere survival.'),
               new Gem(650,280,'#00e87a','NEVER ALONE','Indigenous game: relationality vs colonial conquest.'),
               new Gem(870,278,'#00bfff','QUEER MECHANICS','Undertale\'s consent & mercy systems are queer design.'),
               new Gem(1280,238,'#ff8800','EPISTEMIC VIOLENCE','Game mechanics teach worldviews: domination or care?'),
               new Gem(1680,258,'#cc44ff','GAMERGATE 2014','Coordinated harassment of women & queer devs.'),
               new Gem(2230,268,'#ff4da6','DIVERSITY CORE VALUE','Hire marginalized leaders, not just consultants.') ],
        blocks:[ new QuestionBlock(540,260,'📖 INDIGENOUS GAME DESIGN','"Never Alone" embeds Iñupiaq values directly into platforming mechanics — reciprocity over conquest.'), new QuestionBlock(1320,240,'⚡ QUEER CODING','LGBTQ+ characters often coded, but explicit mechanics make erasure harder. Fight straightwashing.') ],
        flagpole: new Flagpole(2600,320,'🌈 STAGE 2')
      };
    }
    function makeLevel2(){
      return { name:'🌊 STRAIGHTWASHING SWAMP', bg1:'#0c2612', bg2:'#1a4022', width:2500, startX:80, startY:390,
        intro:{ title:'STRAIGHTWASHING SWAMP', text:'Undertale’s queerness is being erased. Restore knowledge. Educate erasers. The swamp wants you to forget — but survivance remembers.' },
        platforms:[new Platform(0,430,2500,24,'#3a5a2a'), new Platform(180,370,110,16), new Platform(390,330,130,16), new Platform(620,290,130,16), new Platform(850,340,120,16), new Platform(1080,300,130,16), new Platform(1310,270,140,16), new Platform(1580,320,120,16), new Platform(1820,290,130,16), new Platform(2070,350,120,16), new Platform(2260,310,140,16) ],
        enemies:[ new Gatekeeper(300,396,'eraser','UNDERTALE PARADOX','Nonbinary protagonist, queer romances → gamers ignored all that. Straightwashing is selective consumption.'), new Gatekeeper(700,306,'eraser','REPRESENTATION ≠ LIBERATION','Diverse characters can be ignored. Need systemic change: dev leadership, community co-creation.'), new Gatekeeper(1160,286,'troll','COLONIAL MECHANICS','Most games: nature = enemy, relationships = conquest. Decolonial design teaches reciprocity.'), new Gatekeeper(1680,336,'harasser','INTERSECTIONALITY','Black women face racism AND sexism. Single-axis representation fails them.') ],
        gems:[ new Gem(260,348,'#ff0080','QUEER MECHANICS','Undertale\'s "spare" system = queer resistance.'),
               new Gem(490,268,'#ff69b4','NEVER ALONE','Community-led development.'),
               new Gem(730,278,'#9b59ff','HAIR NAH','Joyful digital clapback.'),
               new Gem(1180,248,'#00ffff','PATH FORWARD','Hire diverse leaders, early consultants.'),
               new Gem(1660,298,'#ffd700','CYBERBULLYING','BIPOC & women targeted. Real moderation needed.') ],
        blocks:[ new QuestionBlock(930,280,'📢 GAMERGATE AFTERMATH','Zoe Quinn, Anita Sarkeesian faced bomb & rape threats for critiquing games. The violence is real.') ],
        flagpole: new Flagpole(2410,320,'🏳️‍🌈 FINAL CLIMB')
      };
    }
    function makeLevel3(){
      return { name:'🏔️ SURVIVANCE PEAK', bg1:'#160825', bg2:'#2e1948', width:2400, startX:80, startY:420,
        intro:{ title:'SURVIVANCE SUMMIT', text:'Despite gatekeeping, marginalized creators build worlds of joy & resistance. This is the final ascent. Touch the Pride Flagpole.' },
        platforms:[new Platform(0,450,2400,20,'#5a3c7a'), new Platform(150,400,140,16), new Platform(380,360,140,16), new Platform(620,320,140,16), new Platform(860,280,140,16), new Platform(1100,240,140,16), new Platform(1340,200,140,16), new Platform(1580,165,140,16), new Platform(1820,135,140,16), new Platform(2050,110,200,16) ],
        enemies:[ new Gatekeeper(280,416,'harasser','TOXIC GATEKEEPING','Female & BIPOC creators face slurs daily. Moderation and zero-tolerance needed.'), new Gatekeeper(700,336,'troll','GAMER IDENTITY','Gamergate showed that "gamer" = white male grievance. Resist that framing.'), new Gatekeeper(1180,256,'whitewasher','DIVERSE LEADERSHIP','Representation in credits = better games. Structural change required.'), new Gatekeeper(1700,180,'eraser','SURVIVANCE AS PRAXIS','Living, joyful assertion of presence. Every queer dev is an act of survivance.') ],
        gems:[ new Gem(200,398,'#ff0018','81%','Change starts with hiring pipelines.'),
               new Gem(460,338,'#ffa52c','QUEER MECHANICS','Consent-based design > aesthetics.'),
               new Gem(730,258,'#ffff41','INDIGENOUS GAME DESIGN','Never Alone as cultural transmission.'),
               new Gem(970,218,'#008018','HAIR NAH','Joyful resistance against microaggressions.'),
               new Gem(1200,178,'#0066ff','HEROES','Zoe Quinn, Brianna Wu, Anita Sarkeesian.'),
               new Gem(1480,143,'#8800ff','COMMUNITY COLLAB','From day one, not last month.'),
               new Gem(1880,90,'#ff4da6','✦ SURVIVANCE ✦','You are the future. Keep building.') ],
        blocks:[ new QuestionBlock(1650,145,'🌈 THE FUTURE IS QUEER','Games can be instruments of justice. You proved it. Share this knowledge.') ],
        flagpole: new Flagpole(2310,40,'🌟 RADICAL FUTURE 🌟')
      };
    }
    let levels = [makeLevel1(), makeLevel2(), makeLevel3()];

    function nextLevel(){
      if(advancing) return; advancing=true;
      let flash=document.createElement('div'); flash.style.position='absolute'; flash.style.inset=0; flash.style.background='#ff4da6'; flash.style.opacity=0.6; flash.style.pointerEvents='none'; flash.style.zIndex=40; document.getElementById('wrap').appendChild(flash);
      setTimeout(()=>{ flash.remove(); if(levelIdx>=levels.length-1){ showEndScreen(); advancing=false; return; } levelIdx++; player.reset(levels[levelIdx].startX, levels[levelIdx].startY); cameraX=0; updateHUD(); showDialog(levels[levelIdx].intro.title, levels[levelIdx].intro.text); advancing=false; }, 280);
    }

    function updateHUD(){ document.getElementById('h-lvl').textContent=levelIdx+1; document.getElementById('h-gems').textContent=gemsTotal; document.getElementById('h-edu').textContent=eduTotal; document.getElementById('h-score').textContent=score; }
    
    function showEndScreen(){
      let ov=document.getElementById('overlay'); let maxGems=levels.reduce((a,l)=>a+l.gems.length+l.blocks.length,0); let maxEdu=levels.reduce((a,l)=>a+l.enemies.length,0);
      ov.innerHTML=`<div class="game-title">🌟 SURVIVANCE VICTORY 🌟</div><div class="stats-grid"><div class="stat-box"><span class="sval">${gemsTotal}/${maxGems}</span><span class="slabel">GEMS</span></div><div class="stat-box"><span class="sval">${eduTotal}/${maxEdu}</span><span class="slabel">EDUCATED</span></div><div class="stat-box"><span class="sval">${score}</span><span class="slabel">SCORE</span></div></div><p class="intro-body">You resisted straightwashing. Every educated Gatekeeper, every gem — you proved that games can teach justice. The industry changes when we demand structural inclusion. Keep building worlds that center queer & BIPOC joy.</p><button class="start-btn" id="restart-btn">▶ PLAY AGAIN</button>`;
      ov.style.display='flex'; gameStarted=false;
      document.getElementById('restart-btn').addEventListener('click', () => { location.reload(); });
    }

    function drawBackground(lv){
      let grad=ctx.createLinearGradient(0,0,0,H); grad.addColorStop(0,lv.bg1); grad.addColorStop(1,lv.bg2); ctx.fillStyle=grad; ctx.fillRect(0,0,W,H);
      ctx.fillStyle='#ffec8033'; for(let i=0;i<40;i++){ let x=((i*173)%(lv.width*0.8)-cameraX*0.4)%W; let y=(i*83)%H; ctx.fillRect(x,y,2,2); }
      ctx.font='bold 12px "VT323"'; ctx.fillStyle='#ffb3b3aa'; ctx.fillText(lv.name, W-150, 30);
    }
    function drawParticles(){ for(let i=particles.length-1;i>=0;i--){ let p=particles[i]; p.x+=p.vx; p.y+=p.vy; p.vy+=0.2; p.life-=0.04; if(p.life<=0){ particles.splice(i,1); continue; } ctx.globalAlpha=p.life; ctx.fillStyle=p.color; ctx.fillRect(p.x-cameraX-p.sz/2,p.y-p.sz/2,p.sz,p.sz); } ctx.globalAlpha=1; }

    function gameLoop(){
      requestAnimationFrame(gameLoop);
      if(!gameStarted) return;
      let lv=levels[levelIdx];
      drawBackground(lv);
      for(let p of lv.platforms) p.draw();
      for(let b of lv.blocks) b.draw();
      for(let g of lv.gems) g.draw();
      for(let e of lv.enemies){ e.update(); e.draw(); }
      if(lv.flagpole) lv.flagpole.draw();
      player.update(); player.draw();
      drawParticles();
      // progress bars
      let gc=lv.gems.filter(g=>g.collected).length+lv.blocks.filter(b=>!b.active).length, gt=lv.gems.length+lv.blocks.length;
      let ec=lv.enemies.filter(e=>e.educated).length, et=lv.enemies.length;
      ctx.fillStyle='#000000aa'; ctx.fillRect(10,H-32,150,12); ctx.fillStyle='#ffd700'; ctx.fillRect(10,H-32,(gc/gt)*150,12); ctx.fillStyle='#ffd700'; ctx.fillText(`GEMS ${gc}/${gt}`,12,H-20);
      ctx.fillStyle='#000000aa'; ctx.fillRect(10,H-16,150,12); ctx.fillStyle='#00e87a'; ctx.fillRect(10,H-16,(ec/et)*150,12); ctx.fillStyle='#00e87a'; ctx.fillText(`EDUCATED ${ec}/${et}`,12,H-4);
    }
    gameLoop();

    // START BUTTON - fixed and robust
    const startBtn = document.getElementById('start-btn');
    startBtn.addEventListener('click', function startGame() {
      document.getElementById('overlay').style.display = 'none';
      gameStarted = true;
      levelIdx = 0;
      gemsTotal = 0;
      eduTotal = 0;
      score = 0;
      updateHUD();
      player.reset(levels[0].startX, levels[0].startY);
      cameraX = 0;
      showDialog(levels[0].intro.title, levels[0].intro.text);
    });
  })();
</script>
</body>
