---
// Original pen-drawn bulb: light → dark → raw (broken) → light.
---

<theme-toggle>
	<button
		class="theme-toggle-btn"
		type="button"
		aria-label="Turn off the light — switch to dark mode"
		aria-pressed="true"
	>
		<svg
			class="lightbulb"
			width="78"
			height="117"
			viewBox="0 0 88 132"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<g class="hang">
				<path d="M44-2C43 9 46 17 43.5 28S43 40 44 45"></path>
				<path d="M38 45Q43 43.5 50 45L50.5 57Q44 59 37.5 57Z"></path>
				<path d="M38 48.5L50 47M38 52L50 50.5M38 55.5L50 54" stroke-width="1.2"></path>
				<path
					class="wash"
					d="M38 59C30 62 24 68 25 79C25 94 35 105 45 104C57 103 64 94 63 79C63 68 57 61 50 59Z"
				></path>
				<g class="whole"
					><path
						class="glass"
						d="M37.5 57.5C36 64 24 63 23.5 78C22 92 32 107 44 107.5C58 108 66 94 65 80C65 66 53 63 50.5 57"
					></path><path class="echo" d="M26 72C20 87 31 109 45 110M64 85C64 97 56 106 50 107"
					></path></g
				>
				<path class="highlight" d="M30 75Q27 83 30 88"></path>
				<path
					class="filament"
					d="M40 59L37 80C36 86 42 87 44 81C46 75 37 75 40 81C43 88 50 84 49 79L47 59"
					stroke-width="1.25"></path>
				<g class="rays"><path d="M16 72L11 69M12 91L6 93M73 72L78 68M75 94L81 97"></path></g>
				<path
					class="broken"
					d="M37.5 57.5C36 64 24 63 23.5 78C23 87 27 97 33 102L38 96L42 106L47 99L53 104C62 98 66 89 65 80C65 66 53 63 50.5 57M57 89L53 84L57 78"
				></path>
				<path class="snapped" d="M40 59L37 80L40 84M47 59L49 78L46 80" stroke-width="1.25"></path>
				<path class="smoke" d="M43 92C35 88 49 85 43 80M52 96Q58 91 53 88"></path>
			</g></svg
		>
	</button>
</theme-toggle>

<style>
	theme-toggle {
		--ink: #39352d;
	}
	:global([data-theme="dark"]) theme-toggle {
		--ink: #d2cdc0;
	}
	:global([data-theme="raw"]) theme-toggle {
		--ink: #343434;
	}
	.theme-toggle-btn {
		position: absolute;
		top: 0;
		right: 1.25rem;
		z-index: 60;
		width: 78px;
		height: 117px;
		display: flex;
		align-items: flex-start;
		padding: 0;
		margin: 0;
		border: 0;
		background: none;
		cursor: pointer;
		touch-action: manipulation;
		color: var(--ink);
	}
	.theme-toggle-btn:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
		border-radius: 8px;
	}
	.lightbulb {
		width: 100%;
		height: auto;
		display: block;
		pointer-events: none;
		overflow: visible;
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.65;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.hang {
		transform-box: view-box;
		transform-origin: 44px 0;
	}
	.wash {
		fill: #edba5a;
		stroke: none;
		opacity: 0.55;
	}
	.echo {
		opacity: 0.22;
		stroke-width: 0.85;
	}
	.highlight {
		stroke: #fffaf0;
		stroke-width: 2.5;
		opacity: 0.8;
	}
	.rays {
		stroke-width: 1.45;
	}
	.whole,
	.wash,
	.rays,
	.filament,
	.broken,
	.snapped,
	.highlight {
		transition: opacity 180ms ease;
	}
	.broken,
	.snapped,
	.smoke {
		opacity: 0;
	}
	.smoke {
		stroke-width: 1.1;
	}
	:global([data-theme="dark"]) .wash,
	:global([data-theme="dark"]) .rays,
	:global([data-theme="raw"]) .wash,
	:global([data-theme="raw"]) .rays,
	:global([data-theme="raw"]) .whole,
	:global([data-theme="raw"]) .filament,
	:global([data-theme="raw"]) .highlight {
		opacity: 0;
	}
	:global([data-theme="dark"]) .filament {
		stroke: #aaa18e;
	}
	:global([data-theme="raw"]) .broken,
	:global([data-theme="raw"]) .snapped {
		opacity: 1;
	}
	@media (hover: hover) {
		.theme-toggle-btn:hover .hang {
			transform: rotate(2deg);
		}
	}
	:global(theme-toggle[data-anim="off"]) .hang,
	:global(theme-toggle[data-anim="reform"]) .hang {
		animation: tt-settle 0.64s ease-out;
	}
	:global(theme-toggle[data-anim="break"]) .hang {
		animation: tt-pop 0.4s ease-out;
	}
	:global(theme-toggle[data-anim="break"]) .smoke {
		animation: tt-wisp 0.7s ease-out;
	}
	:global(theme-toggle[data-anim="reform"]) .rays {
		animation: tt-spark 0.55s ease-out;
	}
	:global(theme-toggle[data-anim="reform"]) .wash {
		animation: tt-warm 0.45s ease-out;
	}
	@keyframes tt-settle {
		0% {
			transform: translateY(0) rotate(0);
		}
		18% {
			transform: translateY(3px) rotate(4deg);
		}
		46% {
			transform: rotate(-3deg);
		}
		72% {
			transform: rotate(1.4deg);
		}
		100% {
			transform: rotate(0);
		}
	}
	@keyframes tt-pop {
		20% {
			transform: rotate(-3deg);
		}
		45% {
			transform: rotate(3deg);
		}
		70% {
			transform: rotate(-1deg);
		}
	}
	@keyframes tt-wisp {
		15% {
			opacity: 0.6;
			transform: translateY(2px);
		}
		100% {
			opacity: 0;
			transform: translateY(-9px);
		}
	}
	@keyframes tt-spark {
		0% {
			opacity: 0;
		}
		45% {
			opacity: 0.2;
		}
		100% {
			opacity: 1;
		}
	}
	@keyframes tt-warm {
		0% {
			opacity: 0;
		}
		45% {
			opacity: 0.2;
		}
		100% {
			opacity: 0.55;
		}
	}
	@media (max-width: 1024px) {
		.theme-toggle-btn {
			right: 0.5rem;
			width: 70px;
			height: 105px;
		}
	}
	@media (max-width: 768px) {
		.theme-toggle-btn {
			right: 0;
			width: 58px;
			height: 87px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hang,
		.wash,
		.rays,
		.smoke {
			animation: none !important;
		}
		.whole,
		.wash,
		.rays,
		.filament,
		.broken,
		.snapped,
		.highlight {
			transition: none !important;
		}
		.theme-toggle-btn:hover .hang {
			transform: none;
		}
	}
</style>

<script>
	import { rootTheme } from "@/utils/domElement";

	let audioCtx = null;

	function ensureAudio() {
		if (typeof window === "undefined") return null;
		const Ctx = window.AudioContext || window.webkitAudioContext;
		if (!Ctx) return null;
		if (!audioCtx) audioCtx = new Ctx();
		if (audioCtx.state === "suspended") audioCtx.resume();
		return audioCtx;
	}

	function playLightswitch() {
		try {
			const ctx = ensureAudio();
			if (!ctx) return;
			const t = ctx.currentTime;

			// sharp "tick" — mechanical snap of the switch contact
			const tick = ctx.createBufferSource();
			const tickBuf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.03), ctx.sampleRate);
			const td = tickBuf.getChannelData(0);
			for (let i = 0; i < td.length; i++) td[i] = Math.random() * 2 - 1;
			tick.buffer = tickBuf;
			const hp = ctx.createBiquadFilter();
			hp.type = "highpass";
			hp.frequency.value = 3000;
			const tickGain = ctx.createGain();
			tickGain.gain.setValueAtTime(0.22, t);
			tickGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.04);
			tick.connect(hp).connect(tickGain).connect(ctx.destination);
			tick.start(t);
			tick.stop(t + 0.05);

			// low "clack" — the mechanism settling into place
			const osc = ctx.createOscillator();
			osc.type = "sine";
			osc.frequency.setValueAtTime(180, t + 0.02);
			osc.frequency.exponentialRampToValueAtTime(70, t + 0.1);
			const clackGain = ctx.createGain();
			clackGain.gain.setValueAtTime(0.0001, t + 0.02);
			clackGain.gain.exponentialRampToValueAtTime(0.16, t + 0.03);
			clackGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.12);
			osc.connect(clackGain).connect(ctx.destination);
			osc.start(t + 0.02);
			osc.stop(t + 0.14);
		} catch {
			/* sound is non-critical */
		}
	}

	function playFizz() {
		try {
			const ctx = ensureAudio();
			if (!ctx) return;
			const t = ctx.currentTime;
			const dur = 0.7;
			const len = Math.floor(ctx.sampleRate * dur);
			const buffer = ctx.createBuffer(1, len, ctx.sampleRate);
			const data = buffer.getChannelData(0);
			for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
			const noise = ctx.createBufferSource();
			noise.buffer = buffer;
			const bp = ctx.createBiquadFilter();
			bp.type = "bandpass";
			bp.Q.value = 0.8;
			bp.frequency.setValueAtTime(2600, t);
			bp.frequency.exponentialRampToValueAtTime(1200, t + dur);
			const gain = ctx.createGain();
			gain.gain.setValueAtTime(0.0001, t);
			gain.gain.exponentialRampToValueAtTime(0.14, t + 0.04);
			// sputter: a few quick dips like a filament crackling out
			gain.gain.setValueAtTime(0.14, t + 0.15);
			gain.gain.linearRampToValueAtTime(0.05, t + 0.18);
			gain.gain.linearRampToValueAtTime(0.13, t + 0.2);
			gain.gain.linearRampToValueAtTime(0.06, t + 0.32);
			gain.gain.linearRampToValueAtTime(0.12, t + 0.35);
			gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
			noise.connect(bp).connect(gain).connect(ctx.destination);
			noise.start(t);
			noise.stop(t + dur + 0.05);
		} catch {
			/* sound is non-critical */
		}
	}

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			this.button = this.querySelector("button");
			if (!this.button) return;
			this._locked = false;
			this._timer = null;

			this.syncState();
			this.button.addEventListener("click", () => this.handleClick());

			this.observer = new MutationObserver(() => this.syncState());
			this.observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			if (this._timer) window.clearTimeout(this._timer);
		}

		get theme() {
			return rootTheme();
		}

		handleClick() {
			if (this._locked) return;

			const from = this.theme;
			const to = from === "light" ? "dark" : from === "dark" ? "raw" : "light";
			const anim = from === "light" ? "off" : from === "dark" ? "break" : "reform";

			this._locked = true;
			this.setAttribute("data-anim", anim);

			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			let soundOn = true;
			try {
				soundOn = localStorage.getItem("theme-sound") !== "off";
			} catch {
				/* storage unavailable */
			}
			if (!reducedMotion && soundOn) {
				if (anim === "break") playFizz();
				else playLightswitch();
			}

			document.dispatchEvent(
				new CustomEvent("theme-change", {
					detail: { theme: to },
				}),
			);

			const duration = reducedMotion ? 0 : 750;
			this._timer = window.setTimeout(() => {
				this.removeAttribute("data-anim");
				this._locked = false;
				this.syncState();
			}, duration);
		}

		syncState() {
			const theme = this.theme;
			const label = this.labelFor(theme);
			this.button.setAttribute("aria-label", label);
			this.button.setAttribute("aria-pressed", String(theme === "light"));
		}

		labelFor(theme) {
			if (theme === "light") return "Turn off the light — switch to dark mode";
			if (theme === "dark") return "Burn out the light — switch to black & white mode";
			return "Switch back to light mode";
		}
	}

	if (!customElements.get("theme-toggle")) {
		customElements.define("theme-toggle", ThemeToggle);
	}
</script>
