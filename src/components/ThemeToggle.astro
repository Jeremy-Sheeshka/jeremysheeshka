---
// ThemeToggle.astro — a hand-drawn line-art incandescent bulb (light_bulb_line_art_v2 style).
// Curved cord, coiled screw base (stacked ellipses), looping filament, sunburst rays,
// and a warm amber interior glow. Three states: light → dark (ember) → raw (broken) → light.
---

<theme-toggle>
	<button
		class="theme-toggle-btn"
		type="button"
		aria-label="Turn off the light — switch to dark mode"
		aria-pressed="true"
	>
		<svg
			width="690"
			height="930"
			viewBox="0 0 690 930"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
			class="lightbulb"
		>
			<defs>
				<radialGradient id="tt-glow" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="#f2a93d" stop-opacity=".9" />
					<stop offset="55%" stop-color="#eea75e" stop-opacity=".5" />
					<stop offset="100%" stop-color="#eea75e" stop-opacity="0" />
				</radialGradient>
				<linearGradient id="tt-broken" x1="20%" y1="10%" x2="80%" y2="95%">
					<stop offset="0%" stop-color="#f8f8f8" stop-opacity=".82" />
					<stop offset="55%" stop-color="#d9dde1" stop-opacity=".72" />
					<stop offset="100%" stop-color="#b9bec4" stop-opacity=".58" />
				</linearGradient>
				<linearGradient id="tt-smoke" x1="0%" y1="0%" x2="100%" y2="100%">
					<stop offset="0%" stop-color="#777d84" stop-opacity=".78" />
					<stop offset="50%" stop-color="#b7bcc2" stop-opacity=".58" />
					<stop offset="100%" stop-color="#e2e4e6" stop-opacity=".18" />
				</linearGradient>
			</defs>

			<g class="bulb-assembly">
				<path class="cord" d="M340,0 C340,120 304,200 318,262 C326,300 340,360 340,428" fill="none" stroke="var(--line)" stroke-width="9" stroke-linecap="round" />

				<g transform="translate(0, 170)">
					<g class="rays" fill="none" stroke="var(--line)" stroke-width="9" stroke-linecap="round">
						<path d="M427.5 368.4L446.5 335.5" />
						<path d="M491.6 432.5L519.3 416.5" />
						<path d="M515 520L563 520" />
						<path d="M491.6 607.5L519.3 623.5" />
						<path d="M427.5 671.6L446.5 704.5" />
						<path d="M340 695L340 727" />
						<path d="M252.5 671.6L233.5 704.5" />
						<path d="M188.4 607.5L160.7 623.5" />
						<path d="M165 520L117 520" />
						<path d="M188.4 432.5L160.7 416.5" />
						<path d="M252.5 368.4L233.5 335.5" />
					</g>

					<circle class="glow" cx="340" cy="520" r="130" fill="url(#tt-glow)" />

					<g class="socket" fill="none" stroke="var(--line)" stroke-width="9" stroke-linecap="round">
						<ellipse cx="340" cy="280" rx="48" ry="22" />
						<ellipse cx="340" cy="310" rx="52" ry="24" />
						<ellipse cx="340" cy="340" rx="55" ry="25" />
					</g>

					<path class="bulb-glass" d="M288,365 C220,377 197,420 197,488 C197,590 260,680 340,680 C420,680 483,590 483,488 C483,420 460,377 392,365" fill="none" stroke="var(--glass-line)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
					<path class="glass-tint" d="M288,365 C220,377 197,420 197,488 C197,590 260,680 340,680 C420,680 483,590 483,488 C483,420 460,377 392,365" fill="#16130f" stroke="var(--glass-line)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />

					<g class="filament-group">
						<path class="filament-halo" d="M320,368 C310,400 285,420 270,460 C332.7,415 254,415 316.7,460 C379.3,415 300.7,415 363.3,460 C426,415 347.3,415 410,460 C395,420 370,400 360,368" fill="none" stroke="#f2a93d" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
						<path class="filament" d="M320,368 C310,400 285,420 270,460 C332.7,415 254,415 316.7,460 C379.3,415 300.7,415 363.3,460 C426,415 347.3,415 410,460 C395,420 370,400 360,368" fill="none" stroke="var(--filament)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<path class="broken-glass" d="M288,365 C220,377 197,420 197,488 C197,560 222,614 256,634 L276,616 L290,642 L308,622 L328,646 L344,622 L362,644 L380,622 L396,640 L414,616 L432,632 C460,604 483,560 483,488 C483,420 460,377 392,365 Z" fill="url(#tt-broken)" stroke="#8c9196" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />

					<g class="cracks" fill="none" stroke="#777d83" stroke-width="6" stroke-linecap="round">
						<path d="M262,596 L280,584 L276,568" />
						<path d="M312,614 L328,600 L324,584" />
						<path d="M368,614 L352,600 L356,584" />
						<path d="M418,596 L400,584 L404,568" />
					</g>

					<g class="smoke">
						<ellipse cx="290" cy="670" rx="20" ry="13" fill="url(#tt-smoke)" />
						<ellipse cx="340" cy="692" rx="24" ry="15" fill="url(#tt-smoke)" />
						<ellipse cx="390" cy="668" rx="19" ry="12" fill="url(#tt-smoke)" />
					</g>
				</g>
			</g>

			<g class="bulb-fx" aria-hidden="true">
				<circle class="fx-flash" cx="340" cy="584" r="42" />
			</g>
		</svg>
	</button>
</theme-toggle>

<style>
	/* --- STATE PALETTE --- */

	theme-toggle {
		--line: #2e2a24;
		--filament: #2e2a24;
		--glass-line: #2e2a24;
	}

	:global([data-theme="dark"]) theme-toggle {
		--line: #c6cbd0;
		--filament: #f2a93d;
		--glass-line: #9a9a9a;
	}

	:global([data-theme="raw"]) theme-toggle {
		--line: #3a3a3a;
		--filament: #f8f9fa;
		--glass-line: #8c9196;
	}

	/* --- BUTTON / HANGING GEOMETRY --- */

	.theme-toggle-btn {
		position: absolute;
		top: 0;
		right: 1.25rem;
		z-index: 60;
		width: 90px;
		height: 122px;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		pointer-events: auto;
	}

	.theme-toggle-btn:focus-visible {
		outline: 2px solid #f2a93d;
		outline-offset: 4px;
		border-radius: 9999px;
	}

	.lightbulb {
		width: 90px;
		height: auto;
		display: block;
		pointer-events: none;
		overflow: visible;
	}

	/* --- STATIC ART --- */

	.cord,
	.socket,
	.rays {
		transition: stroke 0.5s ease;
	}

	.filament {
		transition: stroke 0.5s ease;
	}

	.bulb-glass {
		transition:
			stroke 0.5s ease,
			opacity 0.45s ease;
	}

	.glass-tint {
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.glow {
		opacity: 0.92;
		transition: opacity 0.6s ease;
	}

	.filament-halo {
		opacity: 0.5;
		transition: opacity 0.45s ease;
	}

	.broken-glass {
		opacity: 0;
		transition: opacity 0.45s ease;
	}

	.cracks path {
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.smoke ellipse {
		opacity: 0;
		transform: translateY(18px) scale(0.75);
		transform-box: fill-box;
		transform-origin: 50% 100%;
		transition:
			opacity 0.55s ease,
			transform 0.55s ease;
	}

	/* --- DARK STATE --- */

	:global([data-theme="dark"]) .glass-tint {
		opacity: 1;
	}

	:global([data-theme="dark"]) .glow,
	:global([data-theme="dark"]) .rays,
	:global([data-theme="dark"]) .filament-halo {
		opacity: 0;
	}

	/* --- RAW STATE --- */

	:global([data-theme="raw"]) .glow,
	:global([data-theme="raw"]) .rays,
	:global([data-theme="raw"]) .filament-halo {
		opacity: 0;
	}

	:global([data-theme="raw"]) .glass-tint {
		opacity: 0;
	}

	:global([data-theme="raw"]) .bulb-glass {
		opacity: 0;
	}

	:global([data-theme="raw"]) .broken-glass {
		opacity: 1;
	}

	:global([data-theme="raw"]) .cracks path {
		opacity: 1;
	}

	:global([data-theme="raw"]) .smoke ellipse {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	:global([data-theme="raw"]) .cracks path:nth-child(1) {
		transition-delay: 0.25s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(2) {
		transition-delay: 0.33s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(3) {
		transition-delay: 0.41s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(4) {
		transition-delay: 0.49s;
	}

	:global([data-theme="raw"]) .smoke ellipse:nth-child(1) {
		transition-delay: 0.2s;
	}
	:global([data-theme="raw"]) .smoke ellipse:nth-child(2) {
		transition-delay: 0.36s;
	}
	:global([data-theme="raw"]) .smoke ellipse:nth-child(3) {
		transition-delay: 0.52s;
	}

	/* --- SWING / MOTION --- */

	.bulb-assembly {
		transform-box: view-box;
		transform-origin: 340px 0px;
	}

	:global([data-anim="off"]) .bulb-assembly,
	:global([data-anim="reform"]) .bulb-assembly {
		animation: tt-swing 0.7s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
	}

	:global([data-anim="break"]) .bulb-assembly {
		animation: tt-shake 0.7s ease both;
	}

	:global([data-anim="off"]) .filament-group,
	:global([data-anim="reform"]) .filament-group {
		animation: tt-flicker 0.5s ease both;
	}

	:global([data-anim="break"]) .filament-group {
		animation: tt-flicker-violent 0.9s ease both;
	}

	:global([data-anim="break"]) .fx-flash {
		animation: tt-flash 0.5s ease-out both;
	}

	:global([data-anim="reform"]) .glow {
		animation: tt-glow 0.7s ease-out both;
	}

	/* --- FX --- */

	.fx-flash {
		fill: #fff7d0;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
	}

	/* --- KEYFRAMES --- */

	@keyframes tt-swing {
		0% {
			transform: rotate(0deg);
		}
		18% {
			transform: rotate(5deg);
		}
		40% {
			transform: rotate(-3.8deg);
		}
		60% {
			transform: rotate(2.4deg);
		}
		78% {
			transform: rotate(-1.2deg);
		}
		92% {
			transform: rotate(0.5deg);
		}
		100% {
			transform: rotate(0deg);
		}
	}

	@keyframes tt-shake {
		0%,
		100% {
			transform: rotate(0deg);
		}
		20% {
			transform: rotate(-2.6deg);
		}
		40% {
			transform: rotate(2.3deg);
		}
		60% {
			transform: rotate(-1.9deg);
		}
		80% {
			transform: rotate(1.1deg);
		}
	}

	@keyframes tt-flicker {
		0%,
		100% {
			opacity: 1;
		}
		20% {
			opacity: 0.3;
		}
		40% {
			opacity: 1;
		}
		55% {
			opacity: 0.5;
		}
		70% {
			opacity: 1;
		}
	}

	@keyframes tt-flicker-violent {
		0% {
			opacity: 1;
		}
		8% {
			opacity: 0.1;
		}
		16% {
			opacity: 1;
		}
		24% {
			opacity: 0.2;
		}
		32% {
			opacity: 0.9;
		}
		40% {
			opacity: 0.05;
		}
		50% {
			opacity: 0.8;
		}
		60% {
			opacity: 0.15;
		}
		72% {
			opacity: 0.7;
		}
		85% {
			opacity: 0.4;
		}
		100% {
			opacity: 0.9;
		}
	}

	@keyframes tt-flash {
		0% {
			opacity: 0;
			transform: scale(0.4);
		}
		30% {
			opacity: 1;
			transform: scale(2.2);
		}
		100% {
			opacity: 0;
			transform: scale(2.8);
		}
	}

	@keyframes tt-glow {
		0% {
			opacity: 0;
			transform: scale(0.7);
		}
		60% {
			opacity: 1;
			transform: scale(1.08);
		}
		100% {
			opacity: 0.92;
			transform: scale(1);
		}
	}

	/* --- RESPONSIVE --- */

	@media (max-width: 1024px) {
		.theme-toggle-btn {
			right: 0.5rem;
			width: 74px;
			height: 100px;
		}
		.lightbulb {
			width: 74px;
		}
	}

	@media (max-width: 768px) {
		.theme-toggle-btn {
			right: 0rem;
			width: 58px;
			height: 78px;
		}
		.lightbulb {
			width: 58px;
		}
	}

	/* Respect users who'd rather not see motion */
	@media (prefers-reduced-motion: reduce) {
		.bulb-assembly,
		.filament-group,
		.glow,
		.fx-flash,
		.cord,
		.socket,
		.rays,
		.filament,
		.filament-halo,
		.bulb-glass,
		.glass-tint,
		.broken-glass,
		.cracks path,
		.smoke ellipse {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<script>
	import { rootTheme } from "@/utils/domElement";

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			this.button = this.querySelector("button");
			if (!this.button) return;
			this._locked = false;
			this._timer = null;

			this.syncState();
			this.button.addEventListener("click", () => this.handleClick());

			this.observer = new MutationObserver(() => this.syncState());
			this.observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			if (this._timer) window.clearTimeout(this._timer);
		}

		get theme() {
			return rootTheme();
		}

		handleClick() {
			if (this._locked) return;

			const from = this.theme;
			const to = from === "light" ? "dark" : from === "dark" ? "raw" : "light";
			const anim = from === "light" ? "off" : from === "dark" ? "break" : "reform";

			this._locked = true;
			this.setAttribute("data-anim", anim);

			document.dispatchEvent(
				new CustomEvent("theme-change", {
					detail: { theme: to },
				}),
			);

			const duration = anim === "break" ? 1700 : 900;
			this._timer = window.setTimeout(() => {
				this.removeAttribute("data-anim");
				this._locked = false;
				this.syncState();
			}, duration);
		}

		syncState() {
			const theme = this.theme;
			const label = this.labelFor(theme);
			this.button.setAttribute("aria-label", label);
			this.button.setAttribute("title", label);
			this.button.setAttribute("aria-pressed", String(theme === "light"));
		}

		labelFor(theme) {
			if (theme === "light") return "Turn off the light — switch to dark mode";
			if (theme === "dark") return "Burn out the light — switch to black & white mode";
			return "Switch back to light mode";
		}
	}

	if (!customElements.get("theme-toggle")) {
		customElements.define("theme-toggle", ThemeToggle);
	}
</script>
