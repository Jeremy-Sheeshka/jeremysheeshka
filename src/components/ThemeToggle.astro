---
// ThemeToggle.astro — a smaller hanging Cadenza bulb with a visible string.
// Three smoothly-crossfading states: light (lit) → dark (ember) → raw (broken) → light.
---

<theme-toggle>
	<button
		class="theme-toggle-btn"
		type="button"
		aria-label="Turn off the light — switch to dark mode"
		aria-pressed="true"
	>
		<svg
			width="500"
			height="900"
			viewBox="0 0 500 900"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
			class="lightbulb"
		>
			<defs>
				<radialGradient id="tt-ambient" cx="50%" cy="52%" r="58%">
					<stop offset="0%" stop-color="#fff8d1" stop-opacity=".9" />
					<stop offset="45%" stop-color="#f5cf38" stop-opacity=".42" />
					<stop offset="100%" stop-color="#f5cf38" stop-opacity="0" />
				</radialGradient>
				<linearGradient id="tt-glass" x1="22%" y1="10%" x2="78%" y2="95%">
					<stop offset="0%" stop-color="#fff1b3" />
					<stop offset="48%" stop-color="#f5cf38" />
					<stop offset="100%" stop-color="#e0b023" />
				</linearGradient>
				<linearGradient id="tt-broken" x1="20%" y1="10%" x2="80%" y2="95%">
					<stop offset="0%" stop-color="#f8f8f8" stop-opacity=".82" />
					<stop offset="55%" stop-color="#d9dde1" stop-opacity=".72" />
					<stop offset="100%" stop-color="#b9bec4" stop-opacity=".58" />
				</linearGradient>
				<linearGradient id="tt-smoke" x1="0%" y1="0%" x2="100%" y2="100%">
					<stop offset="0%" stop-color="#777d84" stop-opacity=".78" />
					<stop offset="50%" stop-color="#b7bcc2" stop-opacity=".58" />
					<stop offset="100%" stop-color="#e2e4e6" stop-opacity=".18" />
				</linearGradient>
			</defs>

			{/* Everything swings from the top of the string */}
			<g class="bulb-assembly">
				<path class="cord" d="M250 0V320" fill="none" stroke="var(--line)" stroke-width="11" stroke-linecap="round" />

				<g transform="translate(0, 175)">
					<circle class="glow" cx="250" cy="410" r="190" fill="url(#tt-ambient)" />

					<path class="socket" d="M157 158Q250 128 343 158L337 250Q250 271 163 250Z" fill="var(--socket)" stroke="var(--line)" stroke-width="8" />
					<path class="socket-rim" d="M146 241Q250 216 354 241L365 267Q250 297 135 267Z" fill="var(--socket)" stroke="var(--line)" stroke-width="8" />
					<g class="socket-grooves" fill="none" stroke="var(--line)" stroke-width="9" stroke-linecap="round">
						<path d="M185 183Q250 164 315 183" />
						<path d="M183 206Q250 187 317 206" />
						<path d="M181 229Q250 210 319 229" />
					</g>

					<g class="rays" fill="none" stroke="#f5cf38" stroke-width="8" stroke-linecap="round">
						<path d="M60 320L118 342" />
						<path d="M40 410L104 410" />
						<path d="M60 500L118 478" />
						<path d="M440 320L382 342" />
						<path d="M460 410L396 410" />
						<path d="M440 500L382 478" />
					</g>

					<path class="bulb-glass" d="M170 267C167 317 130 348 107 402C73 484 108 582 185 622C225 643 275 643 315 622C392 582 427 484 393 402C370 348 333 317 330 267Z" fill="url(#tt-glass)" stroke="var(--glass-line)" stroke-width="9" stroke-linejoin="round" />
					<path class="glass-tint" d="M170 267C167 317 130 348 107 402C73 484 108 582 185 622C225 643 275 643 315 622C392 582 427 484 393 402C370 348 333 317 330 267Z" fill="#16130f" stroke="var(--glass-line)" stroke-width="9" stroke-linejoin="round" />
					<path class="highlight" d="M143 397C116 473 139 535 188 569C208 583 229 592 252 597C212 563 181 520 166 469C157 438 155 414 165 385Z" fill="#fff3ad" />

					<g class="filament-group">
						<g class="filament-supports" fill="none" stroke="var(--filament)" stroke-width="8" stroke-linecap="round">
							<path d="M190 269V366" />
							<path d="M310 269V366" />
						</g>
						<path class="filament" d="M190 366C180 345 158 348 157 379C156 410 177 425 194 403C207 386 207 359 224 354C239 350 239 375 250 375C261 375 261 350 276 354C293 359 293 386 306 403C323 425 344 410 343 379C342 348 320 345 310 366" fill="none" stroke="var(--filament)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<path class="broken-glass" d="M170 267C167 317 130 348 107 402C82 463 94 529 137 576L178 548L201 574L225 548L250 577L275 548L299 574L323 547C371 509 407 456 393 402C370 348 333 317 330 267Z" fill="url(#tt-broken)" stroke="#8c9196" stroke-width="8" stroke-linejoin="round" />

					<g class="cracks" fill="none" stroke="#777d83" stroke-width="6" stroke-linecap="round">
						<path d="M178 548L198 521L192 496" />
						<path d="M225 548L243 522L237 497" />
						<path d="M275 548L258 522L264 497" />
						<path d="M323 547L302 521L308 496" />
					</g>

					<g class="smoke">
						<path d="M177 570C143 591 143 625 171 644C200 663 228 647 223 622C219 601 193 601 204 583C212 570 197 565 177 570Z" fill="url(#tt-smoke)" />
						<path d="M250 606C224 627 231 658 257 668C286 679 304 655 291 635C280 618 263 625 271 606C276 594 263 598 250 606Z" fill="url(#tt-smoke)" />
						<path d="M316 570C291 589 300 616 325 623C351 630 368 607 354 589C342 574 329 584 337 567C343 554 328 558 316 570Z" fill="url(#tt-smoke)" />
					</g>
				</g>
			</g>

			{/* one-shot burnout flash */}
			<g class="bulb-fx" aria-hidden="true">
				<circle class="fx-flash" cx="250" cy="560" r="42" />
			</g>
		</svg>
	</button>
</theme-toggle>

<style>
	/* --- STATE PALETTE (per page theme) --- */

	theme-toggle {
		--socket: #9aa2a8;
		--line: #111111;
		--filament: #111111;
		--glass-line: #111111;
	}

	:global([data-theme="dark"]) theme-toggle {
		--socket: #3f444b;
		--line: #c6cbd0;
		--filament: #f5cf38;
		--glass-line: #9a9a9a;
	}

	:global([data-theme="raw"]) theme-toggle {
		--socket: #8a8f95;
		--line: #3a3a3a;
		--filament: #f8f9fa;
		--glass-line: #8c9196;
	}

	/* --- BUTTON / HANGING GEOMETRY --- */

	.theme-toggle-btn {
		position: absolute;
		top: 0;
		right: 1.25rem;
		z-index: 60;
		width: 80px;
		height: 144px;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		pointer-events: auto;
	}

	.theme-toggle-btn:focus-visible {
		outline: 2px solid #f5cf38;
		outline-offset: 4px;
		border-radius: 9999px;
	}

	.lightbulb {
		width: 80px;
		height: auto;
		display: block;
		pointer-events: none;
		overflow: visible;
	}

	/* --- STATIC ART (colors driven by state vars) --- */

	.cord,
	.socket,
	.socket-rim,
	.socket-grooves {
		transition:
			stroke 0.5s ease,
			fill 0.5s ease;
	}

	.filament,
	.filament-supports {
		transition: stroke 0.5s ease;
	}

	.bulb-glass {
		transition:
			stroke 0.5s ease,
			opacity 0.45s ease;
	}

	.glass-tint {
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.glow {
		opacity: 0.9;
		transition: opacity 0.6s ease;
	}

	.rays {
		opacity: 0.55;
		transition: opacity 0.45s ease;
	}

	.highlight {
		opacity: 0.58;
		transition: opacity 0.45s ease;
	}

	.broken-glass {
		opacity: 0;
		transition: opacity 0.45s ease;
	}

	.cracks path {
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.smoke path {
		opacity: 0;
		transform: translateY(24px) scale(0.8);
		transform-box: fill-box;
		transform-origin: 50% 100%;
		transition:
			opacity 0.55s ease,
			transform 0.55s ease;
	}

	/* --- DARK STATE: near-black glass + warm ember filament + visible outline --- */

	:global([data-theme="dark"]) .glass-tint {
		opacity: 1;
	}

	:global([data-theme="dark"]) .glow,
	:global([data-theme="dark"]) .rays,
	:global([data-theme="dark"]) .highlight {
		opacity: 0;
	}

	/* --- RAW STATE: broken bulb + smoke --- */

	:global([data-theme="raw"]) .glow,
	:global([data-theme="raw"]) .rays,
	:global([data-theme="raw"]) .highlight {
		opacity: 0;
	}

	:global([data-theme="raw"]) .glass-tint {
		opacity: 0;
	}

	:global([data-theme="raw"]) .bulb-glass {
		opacity: 0;
	}

	:global([data-theme="raw"]) .broken-glass {
		opacity: 1;
	}

	:global([data-theme="raw"]) .cracks path {
		opacity: 1;
	}

	:global([data-theme="raw"]) .smoke path {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	:global([data-theme="raw"]) .cracks path:nth-child(1) {
		transition-delay: 0.25s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(2) {
		transition-delay: 0.33s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(3) {
		transition-delay: 0.41s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(4) {
		transition-delay: 0.49s;
	}

	:global([data-theme="raw"]) .smoke path:nth-child(1) {
		transition-delay: 0.2s;
	}
	:global([data-theme="raw"]) .smoke path:nth-child(2) {
		transition-delay: 0.36s;
	}
	:global([data-theme="raw"]) .smoke path:nth-child(3) {
		transition-delay: 0.52s;
	}

	/* --- SWING / MOTION --- */

	.bulb-assembly {
		transform-box: view-box;
		transform-origin: 250px 0px;
	}

	:global([data-anim="off"]) .bulb-assembly,
	:global([data-anim="reform"]) .bulb-assembly {
		animation: tt-swing 0.7s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
	}

	:global([data-anim="break"]) .bulb-assembly {
		animation: tt-shake 0.7s ease both;
	}

	/* filament flickers (light ↔ dark) */
	:global([data-anim="off"]) .filament-group,
	:global([data-anim="reform"]) .filament-group {
		animation: tt-flicker 0.5s ease both;
	}

	/* filament flickers violently as the bulb dies */
	:global([data-anim="break"]) .filament-group {
		animation: tt-flicker-violent 0.9s ease both;
	}

	:global([data-anim="break"]) .fx-flash {
		animation: tt-flash 0.5s ease-out both;
	}

	:global([data-anim="reform"]) .glow {
		animation: tt-glow 0.7s ease-out both;
	}

	/* --- FX (hidden until the burnout) --- */

	.fx-flash {
		fill: #fff7d0;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
	}

	/* --- KEYFRAMES --- */

	@keyframes tt-swing {
		0% {
			transform: rotate(0deg);
		}
		18% {
			transform: rotate(5deg);
		}
		40% {
			transform: rotate(-3.8deg);
		}
		60% {
			transform: rotate(2.4deg);
		}
		78% {
			transform: rotate(-1.2deg);
		}
		92% {
			transform: rotate(0.5deg);
		}
		100% {
			transform: rotate(0deg);
		}
	}

	@keyframes tt-shake {
		0%,
		100% {
			transform: rotate(0deg);
		}
		20% {
			transform: rotate(-2.6deg);
		}
		40% {
			transform: rotate(2.3deg);
		}
		60% {
			transform: rotate(-1.9deg);
		}
		80% {
			transform: rotate(1.1deg);
		}
	}

	@keyframes tt-flicker {
		0%,
		100% {
			opacity: 1;
		}
		20% {
			opacity: 0.3;
		}
		40% {
			opacity: 1;
		}
		55% {
			opacity: 0.5;
		}
		70% {
			opacity: 1;
		}
	}

	@keyframes tt-flicker-violent {
		0% {
			opacity: 1;
		}
		8% {
			opacity: 0.1;
		}
		16% {
			opacity: 1;
		}
		24% {
			opacity: 0.2;
		}
		32% {
			opacity: 0.9;
		}
		40% {
			opacity: 0.05;
		}
		50% {
			opacity: 0.8;
		}
		60% {
			opacity: 0.15;
		}
		72% {
			opacity: 0.7;
		}
		85% {
			opacity: 0.4;
		}
		100% {
			opacity: 0.9;
		}
	}

	@keyframes tt-flash {
		0% {
			opacity: 0;
			transform: scale(0.4);
		}
		30% {
			opacity: 1;
			transform: scale(2.4);
		}
		100% {
			opacity: 0;
			transform: scale(3);
		}
	}

	@keyframes tt-glow {
		0% {
			opacity: 0;
			transform: scale(0.7);
		}
		60% {
			opacity: 1;
			transform: scale(1.08);
		}
		100% {
			opacity: 0.9;
			transform: scale(1);
		}
	}

	/* --- RESPONSIVE --- */

	@media (max-width: 1024px) {
		.theme-toggle-btn {
			right: 0.5rem;
			width: 66px;
			height: 119px;
		}
		.lightbulb {
			width: 66px;
		}
	}

	@media (max-width: 768px) {
		.theme-toggle-btn {
			right: 0rem;
			width: 52px;
			height: 94px;
		}
		.lightbulb {
			width: 52px;
		}
	}

	/* Respect users who'd rather not see motion */
	@media (prefers-reduced-motion: reduce) {
		.bulb-assembly,
		.filament-group,
		.glow,
		.fx-flash,
		.cord,
		.socket,
		.socket-rim,
		.socket-grooves,
		.filament,
		.filament-supports,
		.bulb-glass,
		.glass-tint,
		.rays,
		.highlight,
		.broken-glass,
		.cracks path,
		.smoke path {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<script>
	import { rootTheme } from "@/utils/domElement";

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			this.button = this.querySelector("button");
			if (!this.button) return;
			this._locked = false;
			this._timer = null;

			this.syncState();
			this.button.addEventListener("click", () => this.handleClick());

			// Keep aria state correct even if the theme changes elsewhere.
			this.observer = new MutationObserver(() => this.syncState());
			this.observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			if (this._timer) window.clearTimeout(this._timer);
		}

		get theme() {
			return rootTheme();
		}

		handleClick() {
			if (this._locked) return;

			const from = this.theme;
			const to = from === "light" ? "dark" : from === "dark" ? "raw" : "light";
			const anim = from === "light" ? "off" : from === "dark" ? "break" : "reform";

			this._locked = true;
			this.setAttribute("data-anim", anim);

			document.dispatchEvent(
				new CustomEvent("theme-change", {
					detail: { theme: to },
				}),
			);

			const duration = anim === "break" ? 1700 : 900;
			this._timer = window.setTimeout(() => {
				this.removeAttribute("data-anim");
				this._locked = false;
				this.syncState();
			}, duration);
		}

		syncState() {
			const theme = this.theme;
			const label = this.labelFor(theme);
			this.button.setAttribute("aria-label", label);
			this.button.setAttribute("title", label);
			this.button.setAttribute("aria-pressed", String(theme === "light"));
		}

		labelFor(theme) {
			if (theme === "light") return "Turn off the light — switch to dark mode";
			if (theme === "dark") return "Burn out the light — switch to black & white mode";
			return "Switch back to light mode";
		}
	}

	if (!customElements.get("theme-toggle")) {
		customElements.define("theme-toggle", ThemeToggle);
	}
</script>
