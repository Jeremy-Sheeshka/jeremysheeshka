---
// ThemeToggle.astro — a premium, hand-drawn incandescent globe bulb.
// Round glass, brass screw base, a centered coiled filament, soft glow (no rays).
// Three states: light (lit) → dark (ember) → raw (broken) → light.
---

<theme-toggle>
	<button
		class="theme-toggle-btn"
		type="button"
		aria-label="Turn off the light — switch to dark mode"
		aria-pressed="true"
	>
		<svg
			width="140"
			height="300"
			viewBox="0 0 140 300"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
			class="lightbulb"
		>
			<defs>
				<radialGradient id="tt-ambient" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="#fff8d1" stop-opacity=".9" />
					<stop offset="45%" stop-color="#f5cf38" stop-opacity=".42" />
					<stop offset="100%" stop-color="#f5cf38" stop-opacity="0" />
				</radialGradient>
				<linearGradient id="tt-glass" x1="24%" y1="12%" x2="76%" y2="92%">
					<stop offset="0%" stop-color="#fff1b3" />
					<stop offset="48%" stop-color="#f5cf38" />
					<stop offset="100%" stop-color="#e0b023" />
				</linearGradient>
				<linearGradient id="tt-broken" x1="20%" y1="10%" x2="80%" y2="95%">
					<stop offset="0%" stop-color="#f8f8f8" stop-opacity=".82" />
					<stop offset="55%" stop-color="#d9dde1" stop-opacity=".72" />
					<stop offset="100%" stop-color="#b9bec4" stop-opacity=".58" />
				</linearGradient>
				<linearGradient id="tt-smoke" x1="0%" y1="0%" x2="100%" y2="100%">
					<stop offset="0%" stop-color="#777d84" stop-opacity=".78" />
					<stop offset="50%" stop-color="#b7bcc2" stop-opacity=".58" />
					<stop offset="100%" stop-color="#e2e4e6" stop-opacity=".18" />
				</linearGradient>
			</defs>

			<g class="bulb-assembly">
				<path class="cord" d="M70 0V75" fill="none" stroke="var(--line)" stroke-width="4" stroke-linecap="round" />

				<circle class="glow" cx="70" cy="185" r="60" fill="url(#tt-ambient)" />

				<path class="socket" d="M58 75H82L80 114H60Z" fill="var(--socket)" stroke="var(--line)" stroke-width="3.5" stroke-linejoin="round" />
				<g class="socket-grooves" fill="none" stroke="var(--line)" stroke-width="2.6" stroke-linecap="round" opacity="0.55">
					<path d="M60.5 88H79.5" />
					<path d="M60.2 97H79.8" />
					<path d="M60 106H80" />
				</g>

				<path class="bulb-glass" d="M60 114C60 122 58 130 56 137A50 50 0 1 0 84 137C82 130 80 122 80 114Z" fill="url(#tt-glass)" stroke="var(--glass-line)" stroke-width="3.5" stroke-linejoin="round" />
				<path class="glass-tint" d="M60 114C60 122 58 130 56 137A50 50 0 1 0 84 137C82 130 80 122 80 114Z" fill="#16130f" stroke="var(--glass-line)" stroke-width="3.5" stroke-linejoin="round" />
				<path class="highlight" d="M44 178C40 194 40 210 44 226C46 210 48 194 52 180Z" fill="#fff6d6" />

				<g class="filament-group">
					<path class="filament-stem" d="M68 130V165M72 130V165" fill="none" stroke="var(--filament)" stroke-width="2.6" stroke-linecap="round" />
					<path class="filament-supports" d="M68 165L58 180M72 165L82 180" fill="none" stroke="var(--filament)" stroke-width="2.6" stroke-linecap="round" />
					<path class="filament-halo" d="M58 180L82 183L58 186L82 189L58 192L82 195L58 198L82 201L58 204" fill="none" stroke="#fff3bf" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
					<path class="filament" d="M58 180L82 183L58 186L82 189L58 192L82 195L58 198L82 201L58 204" fill="none" stroke="var(--filament)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
				</g>

				<path class="broken-glass" d="M60 114C60 122 58 130 56 137C48 150 44 168 44 185C44 202 50 216 60 225L68 218L74 227L82 217L90 225C100 216 104 202 102 185C100 168 94 150 84 137C82 130 80 122 80 114Z" fill="url(#tt-broken)" stroke="#8c9196" stroke-width="3.5" stroke-linejoin="round" />

				<g class="cracks" fill="none" stroke="#777d83" stroke-width="2.4" stroke-linecap="round">
					<path d="M56 196L63 191L61 182" />
					<path d="M70 201L76 195L74 186" />
					<path d="M84 196L78 191L80 182" />
					<path d="M96 192L90 187L92 178" />
				</g>

				<g class="smoke">
					<ellipse class="smoke-puff" cx="54" cy="246" rx="14" ry="10" fill="url(#tt-smoke)" />
					<ellipse class="smoke-puff" cx="70" cy="258" rx="16" ry="11" fill="url(#tt-smoke)" />
					<ellipse class="smoke-puff" cx="88" cy="244" rx="13" ry="9" fill="url(#tt-smoke)" />
				</g>
			</g>

			<g class="bulb-fx" aria-hidden="true">
				<circle class="fx-flash" cx="70" cy="192" r="30" />
			</g>
		</svg>
	</button>
</theme-toggle>

<style>
	/* --- STATE PALETTE --- */

	theme-toggle {
		--socket: #b9802f;
		--line: #2e2a24;
		--filament: #2e2a24;
		--glass-line: #2e2a24;
	}

	:global([data-theme="dark"]) theme-toggle {
		--socket: #3a3a3a;
		--line: #c6cbd0;
		--filament: #f5cf38;
		--glass-line: #9a9a9a;
	}

	:global([data-theme="raw"]) theme-toggle {
		--socket: #8a8f95;
		--line: #3a3a3a;
		--filament: #f8f9fa;
		--glass-line: #8c9196;
	}

	/* --- BUTTON / HANGING GEOMETRY --- */

	.theme-toggle-btn {
		position: absolute;
		top: 0;
		right: 1.25rem;
		z-index: 60;
		width: 80px;
		height: 172px;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		pointer-events: auto;
	}

	.theme-toggle-btn:focus-visible {
		outline: 2px solid #f5cf38;
		outline-offset: 4px;
		border-radius: 9999px;
	}

	.lightbulb {
		width: 80px;
		height: auto;
		display: block;
		pointer-events: none;
		overflow: visible;
	}

	/* --- STATIC ART --- */

	.cord,
	.socket,
	.socket-grooves {
		transition:
			stroke 0.5s ease,
			fill 0.5s ease;
	}

	.filament,
	.filament-stem,
	.filament-supports {
		transition: stroke 0.5s ease;
	}

	.bulb-glass {
		transition:
			stroke 0.5s ease,
			opacity 0.45s ease;
	}

	.glass-tint {
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.glow {
		opacity: 0.9;
		transition: opacity 0.6s ease;
	}

	.highlight {
		opacity: 0.8;
		transition: opacity 0.45s ease;
	}

	.filament-halo {
		opacity: 0.65;
		transition: opacity 0.45s ease;
	}

	.broken-glass {
		opacity: 0;
		transition: opacity 0.45s ease;
	}

	.cracks path {
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.smoke-puff {
		opacity: 0;
		transform: translateY(16px) scale(0.75);
		transform-box: fill-box;
		transform-origin: 50% 100%;
		transition:
			opacity 0.55s ease,
			transform 0.55s ease;
	}

	/* --- DARK STATE --- */

	:global([data-theme="dark"]) .glass-tint {
		opacity: 1;
	}

	:global([data-theme="dark"]) .glow,
	:global([data-theme="dark"]) .highlight,
	:global([data-theme="dark"]) .filament-halo {
		opacity: 0;
	}

	/* --- RAW STATE --- */

	:global([data-theme="raw"]) .glow,
	:global([data-theme="raw"]) .highlight,
	:global([data-theme="raw"]) .filament-halo {
		opacity: 0;
	}

	:global([data-theme="raw"]) .glass-tint {
		opacity: 0;
	}

	:global([data-theme="raw"]) .bulb-glass {
		opacity: 0;
	}

	:global([data-theme="raw"]) .broken-glass {
		opacity: 1;
	}

	:global([data-theme="raw"]) .cracks path {
		opacity: 1;
	}

	:global([data-theme="raw"]) .smoke-puff {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	:global([data-theme="raw"]) .cracks path:nth-child(1) {
		transition-delay: 0.25s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(2) {
		transition-delay: 0.33s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(3) {
		transition-delay: 0.41s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(4) {
		transition-delay: 0.49s;
	}

	:global([data-theme="raw"]) .smoke-puff:nth-child(1) {
		transition-delay: 0.2s;
	}
	:global([data-theme="raw"]) .smoke-puff:nth-child(2) {
		transition-delay: 0.36s;
	}
	:global([data-theme="raw"]) .smoke-puff:nth-child(3) {
		transition-delay: 0.52s;
	}

	/* --- SWING / MOTION --- */

	.bulb-assembly {
		transform-box: view-box;
		transform-origin: 70px 0px;
	}

	:global([data-anim="off"]) .bulb-assembly,
	:global([data-anim="reform"]) .bulb-assembly {
		animation: tt-swing 0.7s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
	}

	:global([data-anim="break"]) .bulb-assembly {
		animation: tt-shake 0.7s ease both;
	}

	:global([data-anim="off"]) .filament-group,
	:global([data-anim="reform"]) .filament-group {
		animation: tt-flicker 0.5s ease both;
	}

	:global([data-anim="break"]) .filament-group {
		animation: tt-flicker-violent 0.9s ease both;
	}

	:global([data-anim="break"]) .fx-flash {
		animation: tt-flash 0.5s ease-out both;
	}

	:global([data-anim="reform"]) .glow {
		animation: tt-glow 0.7s ease-out both;
	}

	/* --- FX --- */

	.fx-flash {
		fill: #fff7d0;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
	}

	/* --- KEYFRAMES --- */

	@keyframes tt-swing {
		0% {
			transform: rotate(0deg);
		}
		18% {
			transform: rotate(5deg);
		}
		40% {
			transform: rotate(-3.8deg);
		}
		60% {
			transform: rotate(2.4deg);
		}
		78% {
			transform: rotate(-1.2deg);
		}
		92% {
			transform: rotate(0.5deg);
		}
		100% {
			transform: rotate(0deg);
		}
	}

	@keyframes tt-shake {
		0%,
		100% {
			transform: rotate(0deg);
		}
		20% {
			transform: rotate(-2.6deg);
		}
		40% {
			transform: rotate(2.3deg);
		}
		60% {
			transform: rotate(-1.9deg);
		}
		80% {
			transform: rotate(1.1deg);
		}
	}

	@keyframes tt-flicker {
		0%,
		100% {
			opacity: 1;
		}
		20% {
			opacity: 0.3;
		}
		40% {
			opacity: 1;
		}
		55% {
			opacity: 0.5;
		}
		70% {
			opacity: 1;
		}
	}

	@keyframes tt-flicker-violent {
		0% {
			opacity: 1;
		}
		8% {
			opacity: 0.1;
		}
		16% {
			opacity: 1;
		}
		24% {
			opacity: 0.2;
		}
		32% {
			opacity: 0.9;
		}
		40% {
			opacity: 0.05;
		}
		50% {
			opacity: 0.8;
		}
		60% {
			opacity: 0.15;
		}
		72% {
			opacity: 0.7;
		}
		85% {
			opacity: 0.4;
		}
		100% {
			opacity: 0.9;
		}
	}

	@keyframes tt-flash {
		0% {
			opacity: 0;
			transform: scale(0.4);
		}
		30% {
			opacity: 1;
			transform: scale(2.2);
		}
		100% {
			opacity: 0;
			transform: scale(2.8);
		}
	}

	@keyframes tt-glow {
		0% {
			opacity: 0;
			transform: scale(0.7);
		}
		60% {
			opacity: 1;
			transform: scale(1.08);
		}
		100% {
			opacity: 0.9;
			transform: scale(1);
		}
	}

	/* --- RESPONSIVE --- */

	@media (max-width: 1024px) {
		.theme-toggle-btn {
			right: 0.5rem;
			width: 66px;
			height: 142px;
		}
		.lightbulb {
			width: 66px;
		}
	}

	@media (max-width: 768px) {
		.theme-toggle-btn {
			right: 0rem;
			width: 52px;
			height: 112px;
		}
		.lightbulb {
			width: 52px;
		}
	}

	/* Respect users who'd rather not see motion */
	@media (prefers-reduced-motion: reduce) {
		.bulb-assembly,
		.filament-group,
		.glow,
		.fx-flash,
		.cord,
		.socket,
		.socket-grooves,
		.filament,
		.filament-stem,
		.filament-supports,
		.filament-halo,
		.bulb-glass,
		.glass-tint,
		.highlight,
		.broken-glass,
		.cracks path,
		.smoke-puff {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<script>
	import { rootTheme } from "@/utils/domElement";

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			this.button = this.querySelector("button");
			if (!this.button) return;
			this._locked = false;
			this._timer = null;

			this.syncState();
			this.button.addEventListener("click", () => this.handleClick());

			this.observer = new MutationObserver(() => this.syncState());
			this.observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			if (this._timer) window.clearTimeout(this._timer);
		}

		get theme() {
			return rootTheme();
		}

		handleClick() {
			if (this._locked) return;

			const from = this.theme;
			const to = from === "light" ? "dark" : from === "dark" ? "raw" : "light";
			const anim = from === "light" ? "off" : from === "dark" ? "break" : "reform";

			this._locked = true;
			this.setAttribute("data-anim", anim);

			document.dispatchEvent(
				new CustomEvent("theme-change", {
					detail: { theme: to },
				}),
			);

			const duration = anim === "break" ? 1700 : 900;
			this._timer = window.setTimeout(() => {
				this.removeAttribute("data-anim");
				this._locked = false;
				this.syncState();
			}, duration);
		}

		syncState() {
			const theme = this.theme;
			const label = this.labelFor(theme);
			this.button.setAttribute("aria-label", label);
			this.button.setAttribute("title", label);
			this.button.setAttribute("aria-pressed", String(theme === "light"));
		}

		labelFor(theme) {
			if (theme === "light") return "Turn off the light — switch to dark mode";
			if (theme === "dark") return "Burn out the light — switch to black & white mode";
			return "Switch back to light mode";
		}
	}

	if (!customElements.get("theme-toggle")) {
		customElements.define("theme-toggle", ThemeToggle);
	}
</script>
