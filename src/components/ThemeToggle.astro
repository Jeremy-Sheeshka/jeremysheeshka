---
// ThemeToggle.astro — hand-drawn line-art incandescent bulb.
// Organic screw base, looping filament, two-tone amber interior, sunburst rays.
// Broken state: jagged V-chip bottom, branching crack, snapped filament, smoke.
// Three states: light (lit) → dark (ember) → raw (broken) → light.
---

<theme-toggle>
	<button
		class="theme-toggle-btn"
		type="button"
		aria-label="Turn off the light — switch to dark mode"
		aria-pressed="true"
	>
		<svg
			width="690"
			height="930"
			viewBox="0 0 690 930"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
			class="lightbulb"
		>
			<defs>
				<linearGradient id="tt-smoke" x1="0%" y1="0%" x2="100%" y2="100%">
					<stop offset="0%" stop-color="#777d84" stop-opacity=".78" />
					<stop offset="50%" stop-color="#b7bcc2" stop-opacity=".58" />
					<stop offset="100%" stop-color="#e2e4e6" stop-opacity=".18" />
				</linearGradient>
			</defs>

			<g class="bulb-hang">
			<g class="bulb-assembly">
				<circle class="cord-ring" cx="340" cy="13" r="7.5" fill="none" stroke="var(--line)" stroke-width="9" />
				<path class="cord" d="M340,0 C340,110 304,200 318,262 C326,300 340,360 340,428" fill="none" stroke="var(--line)" stroke-width="9" stroke-linecap="round" />

				<g transform="translate(0, 170)">
					<g class="rays" fill="none" stroke="var(--line)" stroke-width="9" stroke-linecap="round">
						<path d="M427.5 368.4L446.5 335.5" />
						<path d="M491.6 432.5L519.3 416.5" />
						<path d="M515 520L563 520" />
						<path d="M491.6 607.5L519.3 623.5" />
						<path d="M427.5 671.6L446.5 704.5" />
						<path d="M340 695L340 727" />
						<path d="M252.5 671.6L233.5 704.5" />
						<path d="M188.4 607.5L160.7 623.5" />
						<path d="M165 520L117 520" />
						<path d="M188.4 432.5L160.7 416.5" />
						<path d="M252.5 368.4L233.5 335.5" />
					</g>

					<g class="glow">
						<circle cx="340" cy="520" r="130" fill="#eea75e" />
						<circle cx="340" cy="525" r="100" fill="#f2a93d" />
					</g>

					<g class="socket" fill="none" stroke="var(--line)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
						<path d="M292 280 C295 272 315 268 340 269 C365 270 385 274 388 282 C390 290 380 294 365 294 C340 295 315 293 292 288 C288 285 289 282 292 280 Z" />
						<path d="M288 310 C290 303 312 299 340 300 C368 301 390 305 392 312 C394 320 382 324 365 324 C340 325 312 322 288 317 C284 314 285 312 288 310 Z" />
						<path d="M285 340 C287 333 310 329 340 330 C370 331 393 335 395 342 C397 350 385 354 365 354 C340 355 310 352 285 347 C281 344 282 342 285 340 Z" />
					</g>

					<path class="bulb-glass" d="M288,365 C220,377 197,420 197,488 C197,590 260,680 340,680 C420,680 483,590 483,488 C483,420 460,377 392,365" fill="none" stroke="var(--glass-line)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
					<path class="glass-tint" d="M288,365 C220,377 197,420 197,488 C197,590 260,680 340,680 C420,680 483,590 483,488 C483,420 460,377 392,365" fill="#16130f" stroke="var(--glass-line)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />

					<path class="filament" d="M320,368 C310,400 285,420 270,460 C332.7,415 254,415 316.7,460 C379.3,415 300.7,415 363.3,460 C426,415 347.3,415 410,460 C395,420 370,400 360,368" fill="none" stroke="var(--filament)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />

					<path class="broken-glass" d="M288 365 C220 377 197 420 197 488 C197 560 220 620 260 660 L280 630 L300 670 L320 620 L340 660 L360 610 L380 650 L400 600 C430 580 460 540 460 488 C460 420 440 377 392 365" fill="none" stroke="var(--glass-line)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />

					<g class="cracks" fill="none" stroke="#777d83" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
						<path d="M340 660L332 615L348 585L328 545L342 505" />
						<path d="M332 615L308 595L318 565" />
						<path d="M348 585L372 565L362 535" />
					</g>

					<g class="filament-broken" fill="none" stroke="var(--filament)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M320 368C310 400 285 420 270 460L275 475L265 485L285 495" />
						<path d="M360 368C370 400 390 420 400 450L390 470L400 480L380 490" />
					</g>

					<g class="smoke">
						<ellipse cx="290" cy="690" rx="20" ry="13" fill="url(#tt-smoke)" />
						<ellipse cx="340" cy="710" rx="24" ry="15" fill="url(#tt-smoke)" />
						<ellipse cx="390" cy="688" rx="19" ry="12" fill="url(#tt-smoke)" />
					</g>
				</g>
			</g>
			</g>

			<g class="bulb-fx" aria-hidden="true">
				<circle class="fx-flash" cx="340" cy="584" r="42" />
			</g>
		</svg>
	</button>
</theme-toggle>

<style>
	/* --- STATE PALETTE --- */

	theme-toggle {
		--line: #2e2a24;
		--filament: #2e2a24;
		--glass-line: #2e2a24;
	}

	:global([data-theme="dark"]) theme-toggle {
		--line: #c6cbd0;
		--filament: #f2a93d;
		--glass-line: #9a9a9a;
	}

	:global([data-theme="raw"]) theme-toggle {
		--line: #3a3a3a;
		--filament: #3a3a3a;
		--glass-line: #3a3a3a;
	}

	/* --- BUTTON / HANGING GEOMETRY --- */

	.theme-toggle-btn {
		position: absolute;
		top: 0;
		right: 1.25rem;
		z-index: 60;
		width: 90px;
		height: 122px;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: grab;
		pointer-events: auto;
	}

	.theme-toggle-btn:active {
		cursor: grabbing;
	}

	.theme-toggle-btn:focus-visible {
		outline: 2px solid #f2a93d;
		outline-offset: 4px;
		border-radius: 9999px;
	}

	.lightbulb {
		width: 90px;
		height: auto;
		display: block;
		pointer-events: none;
		overflow: visible;
	}

	/* --- STATIC ART --- */

	.cord,
	.cord-ring,
	.socket,
	.rays {
		transition: stroke 0.5s ease;
	}

	.filament {
		transition: stroke 0.5s ease;
	}

	.bulb-glass {
		transition:
			stroke 0.5s ease,
			opacity 0.45s ease;
	}

	.glass-tint {
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.glow {
		opacity: 0.95;
		transition: opacity 0.6s ease;
	}

	.broken-glass {
		opacity: 0;
		transition: opacity 0.45s ease;
	}

	.cracks path {
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.filament-broken {
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.smoke ellipse {
		opacity: 0;
		transform: translateY(18px) scale(0.75);
		transform-box: fill-box;
		transform-origin: 50% 100%;
		transition:
			opacity 0.55s ease,
			transform 0.55s ease;
	}

	/* --- DARK STATE --- */

	:global([data-theme="dark"]) .glass-tint {
		opacity: 1;
	}

	:global([data-theme="dark"]) .glow,
	:global([data-theme="dark"]) .rays {
		opacity: 0;
	}

	/* --- RAW STATE --- */

	:global([data-theme="raw"]) .glow,
	:global([data-theme="raw"]) .rays {
		opacity: 0;
	}

	:global([data-theme="raw"]) .glass-tint {
		opacity: 0;
	}

	:global([data-theme="raw"]) .bulb-glass {
		opacity: 0;
	}

	:global([data-theme="raw"]) .filament {
		opacity: 0;
	}

	:global([data-theme="raw"]) .broken-glass {
		opacity: 1;
	}

	:global([data-theme="raw"]) .cracks path {
		opacity: 1;
	}

	:global([data-theme="raw"]) .filament-broken {
		opacity: 1;
	}

	:global([data-theme="raw"]) .smoke ellipse {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	:global([data-theme="raw"]) .cracks path:nth-child(1) {
		transition-delay: 0.25s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(2) {
		transition-delay: 0.33s;
	}
	:global([data-theme="raw"]) .cracks path:nth-child(3) {
		transition-delay: 0.41s;
	}

	:global([data-theme="raw"]) .smoke ellipse:nth-child(1) {
		transition-delay: 0.2s;
	}
	:global([data-theme="raw"]) .smoke ellipse:nth-child(2) {
		transition-delay: 0.36s;
	}
	:global([data-theme="raw"]) .smoke ellipse:nth-child(3) {
		transition-delay: 0.52s;
	}

	/* --- SWING / MOTION --- */

	.bulb-hang {
		transform-box: view-box;
		transform-origin: 340px 0px;
	}

	.bulb-assembly {
		transform-box: view-box;
		transform-origin: 340px 0px;
	}

	.theme-toggle-btn:hover .bulb-hang {
		animation: tt-nudge 0.5s ease both;
	}

	.theme-toggle-btn:hover .glow {
		opacity: 1;
	}

	@keyframes tt-nudge {
		0% {
			transform: rotate(0deg);
		}
		50% {
			transform: rotate(5deg);
		}
		100% {
			transform: rotate(3deg);
		}
	}

	:global([data-anim="off"]) .bulb-assembly,
	:global([data-anim="reform"]) .bulb-assembly {
		animation: tt-swing 0.7s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
	}

	:global([data-anim="break"]) .bulb-assembly {
		animation: tt-shake 0.7s ease both;
	}

	:global([data-anim="off"]) .filament,
	:global([data-anim="reform"]) .filament {
		animation: tt-flicker 0.5s ease both;
	}

	:global([data-anim="break"]) .filament-broken {
		animation: tt-flicker-violent 0.9s ease both;
	}

	:global([data-anim="break"]) .fx-flash {
		animation: tt-flash 0.5s ease-out both;
	}

	:global([data-anim="reform"]) .glow {
		animation: tt-glow 0.7s ease-out both;
	}

	/* --- FX --- */

	.fx-flash {
		fill: #fff7d0;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
	}

	/* --- KEYFRAMES --- */

	@keyframes tt-swing {
		0% {
			transform: rotate(0deg);
		}
		18% {
			transform: rotate(5deg);
		}
		40% {
			transform: rotate(-3.8deg);
		}
		60% {
			transform: rotate(2.4deg);
		}
		78% {
			transform: rotate(-1.2deg);
		}
		92% {
			transform: rotate(0.5deg);
		}
		100% {
			transform: rotate(0deg);
		}
	}

	@keyframes tt-shake {
		0%,
		100% {
			transform: rotate(0deg);
		}
		20% {
			transform: rotate(-2.6deg);
		}
		40% {
			transform: rotate(2.3deg);
		}
		60% {
			transform: rotate(-1.9deg);
		}
		80% {
			transform: rotate(1.1deg);
		}
	}

	@keyframes tt-flicker {
		0%,
		100% {
			opacity: 1;
		}
		20% {
			opacity: 0.3;
		}
		40% {
			opacity: 1;
		}
		55% {
			opacity: 0.5;
		}
		70% {
			opacity: 1;
		}
	}

	@keyframes tt-flicker-violent {
		0% {
			opacity: 1;
		}
		8% {
			opacity: 0.1;
		}
		16% {
			opacity: 1;
		}
		24% {
			opacity: 0.2;
		}
		32% {
			opacity: 0.9;
		}
		40% {
			opacity: 0.05;
		}
		50% {
			opacity: 0.8;
		}
		60% {
			opacity: 0.15;
		}
		72% {
			opacity: 0.7;
		}
		85% {
			opacity: 0.4;
		}
		100% {
			opacity: 0.9;
		}
	}

	@keyframes tt-flash {
		0% {
			opacity: 0;
			transform: scale(0.4);
		}
		30% {
			opacity: 1;
			transform: scale(2.2);
		}
		100% {
			opacity: 0;
			transform: scale(2.8);
		}
	}

	@keyframes tt-glow {
		0% {
			opacity: 0;
			transform: scale(0.7);
		}
		60% {
			opacity: 1;
			transform: scale(1.08);
		}
		100% {
			opacity: 0.95;
			transform: scale(1);
		}
	}

	/* --- RESPONSIVE --- */

	@media (max-width: 1024px) {
		.theme-toggle-btn {
			right: 0.5rem;
			width: 74px;
			height: 100px;
		}
		.lightbulb {
			width: 74px;
		}
	}

	@media (max-width: 768px) {
		.theme-toggle-btn {
			right: 0rem;
			width: 58px;
			height: 78px;
		}
		.lightbulb {
			width: 58px;
		}
	}

	/* Respect users who'd rather not see motion */
	@media (prefers-reduced-motion: reduce) {
		.bulb-hang,
		.bulb-assembly,
		.filament,
		.filament-broken,
		.glow,
		.fx-flash,
		.cord,
		.cord-ring,
		.socket,
		.rays,
		.bulb-glass,
		.glass-tint,
		.broken-glass,
		.cracks path,
		.smoke ellipse {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<script>
	import { rootTheme } from "@/utils/domElement";

	let audioCtx = null;

	function ensureAudio() {
		if (typeof window === "undefined") return null;
		const Ctx = window.AudioContext || window.webkitAudioContext;
		if (!Ctx) return null;
		if (!audioCtx) audioCtx = new Ctx();
		if (audioCtx.state === "suspended") audioCtx.resume();
		return audioCtx;
	}

	function playLightswitch() {
		try {
			const ctx = ensureAudio();
			if (!ctx) return;
			const t = ctx.currentTime;

			// sharp "tick" — mechanical snap of the switch contact
			const tick = ctx.createBufferSource();
			const tickBuf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.03), ctx.sampleRate);
			const td = tickBuf.getChannelData(0);
			for (let i = 0; i < td.length; i++) td[i] = Math.random() * 2 - 1;
			tick.buffer = tickBuf;
			const hp = ctx.createBiquadFilter();
			hp.type = "highpass";
			hp.frequency.value = 3000;
			const tickGain = ctx.createGain();
			tickGain.gain.setValueAtTime(0.22, t);
			tickGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.04);
			tick.connect(hp).connect(tickGain).connect(ctx.destination);
			tick.start(t);
			tick.stop(t + 0.05);

			// low "clack" — the mechanism settling into place
			const osc = ctx.createOscillator();
			osc.type = "sine";
			osc.frequency.setValueAtTime(180, t + 0.02);
			osc.frequency.exponentialRampToValueAtTime(70, t + 0.1);
			const clackGain = ctx.createGain();
			clackGain.gain.setValueAtTime(0.0001, t + 0.02);
			clackGain.gain.exponentialRampToValueAtTime(0.16, t + 0.03);
			clackGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.12);
			osc.connect(clackGain).connect(ctx.destination);
			osc.start(t + 0.02);
			osc.stop(t + 0.14);
		} catch {
			/* sound is non-critical */
		}
	}

	function playFizz() {
		try {
			const ctx = ensureAudio();
			if (!ctx) return;
			const t = ctx.currentTime;
			const dur = 0.7;
			const len = Math.floor(ctx.sampleRate * dur);
			const buffer = ctx.createBuffer(1, len, ctx.sampleRate);
			const data = buffer.getChannelData(0);
			for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
			const noise = ctx.createBufferSource();
			noise.buffer = buffer;
			const bp = ctx.createBiquadFilter();
			bp.type = "bandpass";
			bp.Q.value = 0.8;
			bp.frequency.setValueAtTime(2600, t);
			bp.frequency.exponentialRampToValueAtTime(1200, t + dur);
			const gain = ctx.createGain();
			gain.gain.setValueAtTime(0.0001, t);
			gain.gain.exponentialRampToValueAtTime(0.14, t + 0.04);
			// sputter: a few quick dips like a filament crackling out
			gain.gain.setValueAtTime(0.14, t + 0.15);
			gain.gain.linearRampToValueAtTime(0.05, t + 0.18);
			gain.gain.linearRampToValueAtTime(0.13, t + 0.2);
			gain.gain.linearRampToValueAtTime(0.06, t + 0.32);
			gain.gain.linearRampToValueAtTime(0.12, t + 0.35);
			gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
			noise.connect(bp).connect(gain).connect(ctx.destination);
			noise.start(t);
			noise.stop(t + dur + 0.05);
		} catch {
			/* sound is non-critical */
		}
	}

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			this.button = this.querySelector("button");
			if (!this.button) return;
			this._locked = false;
			this._timer = null;

			this.syncState();
			this.button.addEventListener("click", () => this.handleClick());

			this.observer = new MutationObserver(() => this.syncState());
			this.observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			if (this._timer) window.clearTimeout(this._timer);
		}

		get theme() {
			return rootTheme();
		}

		handleClick() {
			if (this._locked) return;

			const from = this.theme;
			const to = from === "light" ? "dark" : from === "dark" ? "raw" : "light";
			const anim = from === "light" ? "off" : from === "dark" ? "break" : "reform";

			this._locked = true;
			this.setAttribute("data-anim", anim);

			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			let soundOn = true;
			try {
				soundOn = localStorage.getItem("theme-sound") !== "off";
			} catch {
				/* storage unavailable */
			}
			if (!reducedMotion && soundOn) {
				if (anim === "break") playFizz();
				else playLightswitch();
			}

			document.dispatchEvent(
				new CustomEvent("theme-change", {
					detail: { theme: to },
				}),
			);

			const duration = reducedMotion ? 0 : anim === "break" ? 1700 : 900;
			this._timer = window.setTimeout(() => {
				this.removeAttribute("data-anim");
				this._locked = false;
				this.syncState();
			}, duration);
		}

		syncState() {
			const theme = this.theme;
			const label = this.labelFor(theme);
			this.button.setAttribute("aria-label", label);
			this.button.setAttribute("aria-pressed", String(theme === "light"));
		}

		labelFor(theme) {
			if (theme === "light") return "Turn off the light — switch to dark mode";
			if (theme === "dark") return "Burn out the light — switch to black & white mode";
			return "Switch back to light mode";
		}
	}

	if (!customElements.get("theme-toggle")) {
		customElements.define("theme-toggle", ThemeToggle);
	}
</script>
