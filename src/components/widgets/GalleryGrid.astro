---
interface Props {
  cols?: number;
  images: { src: string; alt: string; caption?: string }[];
}
const { cols = 2, images } = Astro.props;
---
<div class={`my-8 grid gap-4 grid-cols-1 sm:grid-cols-${cols}`}>
  {images.map(img => (
    <figure class="m-0">
      <img 
        src={img.src} 
        alt={img.alt} 
        class="w-full h-auto rounded-lg border shadow-sm"
        loading="lazy"
      />
      {img.caption && <figcaption class="text-center text-xs mt-2 opacity-70">{img.caption}</figcaption>}
    </figure>
  ))}
</div>
