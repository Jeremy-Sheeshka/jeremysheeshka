---
const { label = "Reveal" } = Astro.props;
---
<details class="my-6 rounded-lg border-l-4 border-l-purple-500 bg-gray-50 dark:bg-gray-800 p-4">
  <summary class="cursor-pointer font-bold text-purple-700 dark:text-purple-300 select-none">
    {label}
  </summary>
  <div class="mt-3 prose dark:prose-invert max-w-none">
    <slot />
  </div>
</details>
