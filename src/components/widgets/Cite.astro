---
const { n, title } = Astro.props;
const citeId = `cite-${n}`;
const refId = `ref-${n}`;
---

<span id={citeId} class="inline-flex align-super scroll-mt-24">
  <a
    href={`#${refId}`}
    class="text-xs font-mono text-blue-600 hover:underline ml-1"
    title={title}
    aria-label={title ? `Jump to reference ${n}: ${title}` : `Jump to reference ${n}`}
  >
    [{n}]
  </a>
</span>
