---
interface Item {
  date: string;
  title: string;
  body: string;
}
interface Props {
  title?: string;
  items: Item[];
}
const { title, items = [] } = Astro.props;
---
<div class="my-8">
  {title && <h3 class="mb-6 font-bold text-lg">{title}</h3>}
  <div class="border-l-2 border-gray-200 dark:border-gray-700 ml-3 space-y-8 pl-6 relative">
    {items.map((item) => (
      <div class="relative">
        <span class="absolute -left-[31px] top-1 h-4 w-4 rounded-full border-2 border-white bg-blue-600 dark:border-gray-900"></span>
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 mb-1">
          <span class="font-mono text-sm font-bold text-blue-600 dark:text-blue-400">{item.date}</span>
          <h4 class="font-bold text-md m-0">{item.title}</h4>
        </div>
        <p class="text-gray-600 dark:text-gray-400 m-0 leading-relaxed">{item.body}</p>
      </div>
    ))}
  </div>
</div>