---
import { Icon } from 'astro-icon/components';

const { title, description, icon, class: className = '' } = Astro.props;
---

<div class={className}>
  <div class="flex flex-row">
    <div class="flex flex-col items-center mr-4 rtl:mr-0 rtl:ml-4">
      <div class="flex items-center justify-center w-10 h-10 rounded-full border-2 border-primary-500 bg-primary-500 dark:bg-primary-700 text-gray-50 dark:text-gray-100 font-bold">
        <slot name="icon">
           {/* COMMENTED OUT DEFAULT ICON
             Uncomment the block below if you want the checkmark back later.
           */}
           
           {/* <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
             <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
             <path d="M5 12l5 5l10 -10"></path>
           </svg> 
           */}
        </slot>
      </div>
      <div class="w-px h-full bg-gray-300 dark:bg-gray-500 my-2"></div>
    </div>
    
    <div class="pt-1 pb-8">
      {title && (
        <h3 class="text-xl font-bold text-gray-900 dark:text-slate-300 mb-2">
          {title}
        </h3>
      )}
      
      <div class="text-gray-600 dark:text-slate-400">
        <slot />
      </div>
    </div>
  </div>
</div>