---
import ArchitectureDiagram from './ArchitectureDiagram.astro';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Curator · Local-first AI infrastructure for education</p>
      <h1>Knowledge, engineered for the people who own it.</h1>
      <p class="lede">
        Curator builds open, local-first AI infrastructure that lets schools and studios run
        intelligent workflows on their own knowledge — designed so institutional data can
        remain inside the organization. We're proving it first in music education.
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="/cadenza">See Cadenza</a>
        <a class="btn btn--ghost" href="#platform">Explore the platform</a>
      </div>
      <div class="hero-links">
        <a class="link-arrow" href="/cadenza">For educators — Cadenza <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link-arrow" href="#platform">For institutions &amp; investors — The platform <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="hero-media">
      <ArchitectureDiagram />
    </div>
  </div>
</section>
