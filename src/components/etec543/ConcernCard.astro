---
/** A concern I would expect from staff (the prop) and my answer to it (the slot). */
interface Props {
	concern: string;
}

const { concern } = Astro.props;
---

<div
	class="flex flex-col rounded-2xl border border-t-4 border-stone-200 border-t-[var(--theme-green)] bg-white/85 p-5 shadow-sm dark:border-zinc-800 dark:border-t-[var(--theme-green)] dark:bg-zinc-900/70"
>
	<span class="text-[0.7rem] font-bold uppercase tracking-wider text-stone-500 dark:text-zinc-400">
		Staff concern
	</span>
	<p class="mt-1.5 font-serif text-xl italic leading-snug text-stone-900 dark:text-zinc-50">{concern}</p>
	<div class="mt-3 font-serif text-[1rem] leading-[1.8] text-stone-800 dark:text-zinc-200">
		<slot />
	</div>
</div>
