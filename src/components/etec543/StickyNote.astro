---
/**
 * A sticky note stuck to the top of the first sheet, in the same blue pen as
 * the margin notes. It hangs over the right margin on a wide screen and sits
 * at the top of the page on a narrow one.
 */
---

<div class="sticky-note">
	<slot />
</div>

<style is:global>
	.report-sheet .sticky-note {
		position: relative;
		max-width: 17rem;
		margin: 0 0 2rem auto;
		padding: 1rem 1.1rem 1.2rem;
		background: #fbef7a;
		color: var(--pen);
		font-family: "Caveat", "Segoe Print", "Bradley Hand", cursive;
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.15;
		box-shadow:
			0 1px 1px rgb(0 0 0 / 0.12),
			2px 8px 10px -8px rgb(0 0 0 / 0.5);
		transform: rotate(1.8deg);
	}

	.dark .report-sheet .sticky-note {
		background: #e3d86c;
	}

	.report-sheet .sticky-note a {
		color: inherit;
	}

	@media (min-width: 1024px) {
		.report-sheet--stapled .sticky-note {
			position: absolute;
			top: -1.1rem;
			right: 2.5rem;
			width: 17rem;
			margin: 0;
		}
	}
</style>
