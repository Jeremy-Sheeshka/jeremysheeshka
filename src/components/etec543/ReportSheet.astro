---
/**
 * The report as a printed page: plain white paper, the serif it was printed
 * in (Liberation Serif), a staple on the first sheet, and wide margins for the
 * pen notes (PenNote) that sit beside the lines they are about.
 *
 * Astro does not stamp its scope attribute onto slotted MDX, so every rule
 * that reaches the report's own text is global and anchored on .report-sheet.
 */
interface Props {
	/** The first sheet has the staple and keeps a right margin for notes. */
	stapled?: boolean;
}

const { stapled = false } = Astro.props;
---

<div class:list={["report-sheet not-prose", { "report-sheet--stapled": stapled }]}>
	<div class="report-sheet__body">
		<slot />
	</div>
</div>

<style is:global>
	@font-face {
		font-family: "Caveat";
		src: url("/fonts/caveat.woff2") format("woff2");
		font-weight: 400 700;
		font-display: swap;
	}

	.report-sheet {
		--ink: #1c1c1c;
		--pen: #2446b0;
		position: relative;
		margin: 2.5rem 0;
		padding: 2.75rem 1.4rem 3rem;
		background: #fdfdfc;
		color: var(--ink);
		border: 1px solid rgb(0 0 0 / 0.07);
		box-shadow:
			0 1px 1px rgb(0 0 0 / 0.1),
			0 10px 18px -14px rgb(0 0 0 / 0.45);
		font-family: "Liberation Serif", "Times New Roman", Times, serif;
		font-size: 1.0625rem;
		line-height: 1.65;
	}

	.dark .report-sheet {
		/* Paper under a desk lamp rather than a white rectangle in the dark. */
		background: #e4e3df;
		border-color: rgb(0 0 0 / 0.4);
		box-shadow: 0 12px 22px -14px rgb(0 0 0 / 0.9);
	}

	@media (min-width: 640px) {
		.report-sheet {
			padding: 3.5rem 3.5rem 4rem;
		}
	}

	/* A staple through the top-left corner. */
	.report-sheet--stapled::before {
		content: "";
		position: absolute;
		top: 1.15rem;
		left: 0.9rem;
		width: 2.1rem;
		height: 0.3rem;
		border-radius: 2px;
		background: linear-gradient(#d9dce0, #8e939a);
		box-shadow: 0 1px 0 rgb(0 0 0 / 0.25);
		transform: rotate(-36deg);
	}

	@media (min-width: 1024px) {
		.report-sheet--stapled .report-sheet__body {
			width: 63%;
		}
	}

	.report-sheet .sheet-title {
		font-size: 1.7rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.report-sheet .sheet-subtitle {
		margin-top: 0.3rem;
		color: #555;
	}

	.report-sheet h2,
	.report-sheet h3 {
		font-weight: 700;
		line-height: 1.3;
	}

	.dark .prose .report-sheet h2,
	.dark .prose .report-sheet h3 {
		color: var(--ink) !important;
	}

	.report-sheet h2 {
		margin: 2.2rem 0 0.6rem;
		font-size: 1.3rem;
	}

	.report-sheet__body > h2:first-child {
		margin-top: 0;
	}

	.report-sheet h3 {
		margin: 1.6rem 0 0.5rem;
		font-size: 1.08rem;
		font-style: italic;
	}

	.report-sheet h2 a,
	.report-sheet h3 a {
		color: inherit;
		text-decoration: none;
	}

	.report-sheet p,
	.report-sheet li {
		position: relative;
	}

	.report-sheet p + p,
	.report-sheet ul + p {
		margin-top: 0.9rem;
	}

	.report-sheet ul {
		margin: 0.6rem 0 0.9rem;
		padding-left: 1.5em;
		list-style: disc;
	}

	.report-sheet li + li {
		margin-top: 0.45rem;
	}

	.report-sheet a {
		color: inherit;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}

	/* A real highlighter pass: uneven ends, ink showing through. */
	.report-sheet mark {
		color: inherit;
		background:
			linear-gradient(
				100deg,
				rgb(255 236 64 / 0) 0.8%,
				rgb(255 236 64 / 0.85) 2.5%,
				rgb(255 236 64 / 0.6) 6%,
				rgb(255 236 64 / 0.45) 92%,
				rgb(255 236 64 / 0.8) 96%,
				rgb(255 236 64 / 0) 98.5%
			),
			linear-gradient(182deg, rgb(255 236 64 / 0) 0%, rgb(255 236 64 / 0.35) 8%, rgb(255 236 64 / 0) 16%);
		padding: 0.05em 0.3em;
		margin: 0 -0.15em;
		border-radius: 0.4em 0.2em 0.5em 0.25em;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
		mix-blend-mode: multiply;
	}

	/* The references sheet: hanging indents, as on the printed copy. */
	.report-sheet .refs {
		list-style: none;
		padding-left: 0;
	}

	.report-sheet .refs li {
		padding-left: 2rem;
		text-indent: -2rem;
		overflow-wrap: anywhere;
	}
</style>
