---
/**
 * One area of the Jisc code: its name, the plain question it answers, and my
 * summary of what a district would need to do (the slot).
 */
interface Props {
	n: number;
	name: string;
	question: string;
}

const { n, name, question } = Astro.props;
---

<li class="relative pl-8 sm:pl-10">
	<span
		class="absolute left-0 top-6 flex h-4 w-4 items-center justify-center rounded-full border-2 border-[var(--theme-royal-blue)] bg-white dark:bg-zinc-900"
		aria-hidden="true"
	>
		<span class="h-1.5 w-1.5 rounded-full bg-[var(--theme-royal-blue)]"></span>
	</span>

	<div class="rounded-xl border border-stone-200 bg-white/85 p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/70">
		<span class="text-[0.7rem] font-bold uppercase tracking-wider text-stone-500 dark:text-zinc-400">
			Area {n} of 7
		</span>
		<h3 class="mt-1.5 text-base font-bold leading-snug text-stone-900 dark:text-zinc-50">{name}</h3>
		<p
			class="mt-2.5 border-l-2 border-[var(--theme-royal-blue)] pl-3 text-sm italic leading-relaxed text-stone-600 dark:text-zinc-300"
		>
			{question}
		</p>
		<div class="mt-3 font-serif text-[1rem] leading-[1.8] text-stone-800 dark:text-zinc-200">
			<slot />
		</div>
	</div>
</li>
