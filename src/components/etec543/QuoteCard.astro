---
/**
 * A paragraph built around a line quoted from the code. Wrap the quoted words
 * in <mark> and they are picked out like a highlighter on a printed copy.
 */
interface Props {
	cite: string;
}

const { cite } = Astro.props;
---

<figure
	class="quote-card flex flex-col rounded-2xl border border-stone-200 bg-white/85 p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/70"
>
	<figcaption class="text-[0.7rem] font-bold uppercase tracking-wider text-stone-500 dark:text-zinc-400">
		Quoted from {cite}
	</figcaption>
	<div class="mt-2 font-serif text-[1.0625rem] leading-[1.85] text-stone-800 dark:text-zinc-200">
		<slot />
	</div>
</figure>

<style>
	.quote-card :global(mark) {
		background: linear-gradient(
			transparent 45%,
			color-mix(in srgb, var(--theme-bright-sun) 70%, transparent) 45%
		);
		color: inherit;
		padding: 0 0.1em;
	}

	:global(.dark) .quote-card :global(mark) {
		background: linear-gradient(
			transparent 55%,
			color-mix(in srgb, var(--theme-bright-sun) 40%, transparent) 55%
		);
	}

	/* The raw theme turns every accent black, which would bury the words. */
	:global([data-theme="raw"]) .quote-card :global(mark) {
		background: none;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
</style>
