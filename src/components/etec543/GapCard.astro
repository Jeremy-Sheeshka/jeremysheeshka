---
/** Something the code leaves out, and what I would add for SD52 (the slot). */
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div
	class="flex flex-col rounded-2xl border border-l-[6px] border-stone-200 border-l-[var(--theme-cinnabar)] bg-white/85 p-5 shadow-sm dark:border-zinc-800 dark:border-l-[var(--theme-cinnabar)] dark:bg-zinc-900/70"
>
	<span class="text-[0.7rem] font-bold uppercase tracking-wider text-stone-500 dark:text-zinc-400">Gap</span>
	<h4 class="mt-1 text-base font-bold leading-snug text-stone-900 dark:text-zinc-50">{title}</h4>
	<div class="mt-2 font-serif text-[1rem] leading-[1.8] text-stone-800 dark:text-zinc-200">
		<slot />
	</div>
</div>
