---
import type { PortfolioEntry } from "@/data/portfolioData";
import { getPhaseMeta } from "@/data/portfolioData";
import RubricBadge from "./RubricBadge.astro";

interface Props {
  entry: PortfolioEntry;
}

const { entry } = Astro.props;
const phaseMeta = getPhaseMeta(entry.phase);

const features = [
  "Scheduling & invoicing",
  "Family messaging",
  "Practice tracking",
  "Student records",
  "Local lesson transcription",
  "RAG resource library",
  "On-demand transposition",
  "Self-hosted · open source",
];
---

<article
  class="builder-showcase relative overflow-hidden rounded-3xl border-2 bg-white/95 shadow-xl dark:bg-zinc-900/90"
  style={`border-color: ${phaseMeta?.color ?? "#e54848"};`}
  aria-labelledby="builder-showcase-title"
>
  {/* Soft tinted glow behind the card */}
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style={`background: radial-gradient(circle at 100% 0%, ${phaseMeta?.tint ?? "#fdeeee"} 0%, transparent 55%);`}
    aria-hidden="true"
  ></div>

  <div class="relative grid gap-8 p-8 md:grid-cols-[1.15fr_1fr] md:p-10">
    <div>
      <p
        class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-white"
        style={`background-color: ${phaseMeta?.color ?? "#e54848"};`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
        </svg>
        Builder's Showcase
      </p>

      <h3 id="builder-showcase-title" class="mt-4 text-2xl font-black leading-tight text-stone-900 dark:text-zinc-50 md:text-3xl">
        {entry.title}
      </h3>

      <blockquote
        class="mt-5 border-l-4 pl-4 text-lg italic leading-relaxed text-stone-700 dark:text-zinc-300"
        style={`border-color: ${phaseMeta?.color ?? "#e54848"};`}
      >
        <p>“{entry.quote}”</p>
      </blockquote>

      <div class="mt-5 space-y-3 text-sm leading-relaxed text-stone-700 dark:text-zinc-300">
        <p>
          <span class="font-semibold text-stone-900 dark:text-zinc-100">My role:</span>{" "}
          {entry.role}
        </p>
        <p>
          <span class="font-semibold text-stone-900 dark:text-zinc-100">The “So What?”:</span>{" "}
          {entry.summary}
        </p>
      </div>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Cadenza Studio capabilities">
        {features.map((feature) => (
          <li class="rounded-full border border-stone-300 bg-stone-50 px-3 py-1 text-xs font-medium text-stone-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200">
            {feature}
          </li>
        ))}
      </ul>

      <div class="mt-6 flex flex-wrap gap-2" aria-label="Rubric criteria evidenced">
        {entry.rubricTags.map((tag) => <RubricBadge tag={tag} />)}
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/cadenza-app"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-bold text-white shadow-md transition-transform hover:-translate-y-0.5"
          style={`background-color: ${phaseMeta?.color ?? "#e54848"};`}
        >
          Try the live MVP
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a
          href="/cadenza"
          class="inline-flex items-center gap-2 rounded-full border-2 border-stone-400 px-5 py-2.5 text-sm font-bold text-stone-800 transition-colors hover:border-stone-600 dark:border-zinc-600 dark:text-zinc-100 dark:hover:border-zinc-400"
        >
          Explore Cadenza
        </a>
        <a
          href={entry.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-stone-700 underline decoration-stone-400 underline-offset-4 hover:decoration-[var(--color-link)] dark:text-zinc-300"
        >
          Read the pitch
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-center gap-4">
      <img
        src="/images/cadenza/cadenzatablet.png"
        alt="Cadenza Studio dashboard preview showing the weekly schedule, student list, and attendance tracking"
        loading="lazy"
        width="640"
        height="480"
        class="w-full max-w-md rounded-2xl border border-stone-200 shadow-md dark:border-zinc-800"
      />
      <p class="text-center text-xs italic text-stone-500 dark:text-zinc-400">
        The Cadenza Studio MVP — a working local-first app, not a slide deck.
      </p>
    </div>
  </div>
</article>
