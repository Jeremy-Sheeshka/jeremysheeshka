---
import PrinceRupertBaseHead from "@/components/PrinceRupertBaseHead.astro";

interface Props {
  title: string;
  description?: string;
  mobileCta?: boolean;
}

const { title, description = "", mobileCta = false } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <PrinceRupertBaseHead title={title} description={description} />
  </head>
  <body>
    <nav class="navbar">
      <div class="container">
        <a href="/prweb" class="nav-logo">
          <img src="/images/prweb/logo.svg" alt="Prince Rupert Web Design logo">
          <span>Prince Rupert Web Design</span>
        </a>
        <div class="nav-links">
          <a href="/prweb#welcome" class="nav-link">Welcome</a>
          <a href="/prweb#services" class="nav-link">Services</a>
          <a href="/prweb#pricing" class="nav-link">Subscriptions</a>
          <a href="/prweb#stories" class="nav-link">Client Stories</a>
          <a href="/prweb#quote" class="nav-link">Contact</a>
        </div>
        <div class="nav-cta">
          <a href="/prweb#quote" class="btn btn-salmon">Get a Quote</a>
        </div>
        <button class="mobile-menu-btn" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>

    <div class="mobile-menu">
      <a href="/prweb#welcome" class="nav-link">Welcome</a>
      <a href="/prweb#services" class="nav-link">Services</a>
      <a href="/prweb#pricing" class="nav-link">Subscriptions</a>
      <a href="/prweb#stories" class="nav-link">Client Stories</a>
      <a href="/prweb#quote" class="nav-link">Contact</a>
      {mobileCta && (
        <a href="/prweb#quote" class="btn btn-salmon btn-lg">Get a Quote</a>
      )}
    </div>

    <slot />

    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/prweb" class="nav-logo">
              <img src="/images/prweb/logo.svg" alt="Prince Rupert Web Design logo">
              <span>Prince Rupert Web Design</span>
            </a>
            <p>Web design for small businesses with big ideas on British Columbia's North Coast.</p>
          </div>
          <div class="footer-column">
            <h4>Explore</h4>
            <a href="/prweb#welcome">Welcome</a>
            <a href="/prweb#services">Services</a>
            <a href="/prweb#pricing">Subscriptions</a>
            <a href="/prweb#stories">Client Stories</a>
          </div>
          <div class="footer-column">
            <h4>Get in Touch</h4>
            <a href="/prweb#quote">Request a Quote</a>
            <a href="mailto:hello@princerupertwebdesign.ca">hello@princerupertwebdesign.ca</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Prince Rupert Web Design. All rights reserved.</p>
          <p>Proudly serving Prince Rupert &amp; the North Coast.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
