---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { siteConfig } from "@/site.config";
// 1. Import the new Hanging Lightbulb Component
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
	meta: SiteMeta;
	themeColor?: "cinnabar" | "royal-blue" | "bright-sun" | "green" | "cream";
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	themeColor = "cream",
} = Astro.props;

const themeClass = `bg-theme-${themeColor}`;
---

<html lang={siteConfig.lang} class="scroll-smooth">
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />

		<!-- Embed mode: hide site chrome when ?embed=1 is in the URL.
		     The dashboard iframes blog posts chrome-less. -->
		<script is:inline>
			if (new URLSearchParams(window.location.search).has('embed')) {
				document.documentElement.classList.add('embedded');
			}
		</script>
		<style is:inline>
			.embedded header#main-header,
			.embedded footer,
			.embedded #blog-hero,
			.embedded #post-nav,
			.embedded #to-top-btn,
			.embedded body > theme-toggle,
			.embedded .prose + .mt-16 {
				display: none !important;
			}
			.embedded {
				padding-top: 0 !important;
			}
		</style>
	</head>
	<body class={`flex min-h-screen flex-col ${themeClass} bg-texture`}>
		<ThemeProvider />
		{/* 2. Add the Toggle here so it hangs from the top of the page */}
		<ThemeToggle />
		<Header themeColor={themeColor} />
		<main class="flex-grow w-full" id="main">
			<slot />
		</main>
		<Footer themeColor={themeColor} />
	</body>
</html>