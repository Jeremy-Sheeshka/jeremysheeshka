---
import { type CollectionEntry, render, getCollection } from "astro:content";
import Masthead from "@/components/blog/Masthead.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import BaseLayout from "./Base.astro";
import { collectionDateSort } from "@/utils/date";
// 1. ADD THIS IMPORT
import { getAllPosts } from "@/data/post"; 

interface Props {
    post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();

const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;

// --- NEXT / PREV NAVIGATION LOGIC ---
// 2. USE THE HELPER INSTEAD OF MANUAL FILTERING
const allPosts = await getAllPosts();
const sortedPosts = allPosts.sort(collectionDateSort); 
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);

const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
---

<BaseLayout
    meta={{
        articleDate,
        description,
        ogImage: socialImage,
        title,
    }}
>
    <article class="grow break-words overflow-hidden" data-pagefind-body>
        <div id="blog-hero" class="mb-12 px-6 sm:px-8 lg:px-12">
            <Masthead content={post} readingTime={readingTime} />
        </div>

        <div class="w-full overflow-hidden">
            <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
                <div class="flex flex-col lg:flex-row lg:gap-8">
                    <div class="flex-1 min-w-0">
                        
                        {/* CONTENT SECTION */}
                        <div class="prose dark:prose-invert prose-sm prose-headings:font-semibold max-w-none">
                            <slot />
                        </div>

                        {/* WEBMENTIONS */}
                        <div class="mt-16">
                            <WebMentions />
                        </div>

                        {/* --- NAVIGATION BUTTONS --- */}
                        <div
                            id="post-nav"
                            class="mt-12 pt-12 border-t border-dashed border-stone-200 dark:border-zinc-800 flex flex-col sm:flex-row justify-between gap-6"
                        >
                            
                            {/* Previous Post (Older) */}
                            {prevPost ? (
                                <a
                                    href={`/posts/${prevPost.id}/`}
                                    class="flex flex-col gap-1 text-left flex-1 min-w-0 hover:opacity-75 transition-opacity group"
                                >
                                    <span class="nav-label text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m15 18-6-6 6-6"/>
                                        </svg>
                                        Previous
                                    </span>
                                    <span class="nav-title text-lg font-bold truncate group-hover:underline underline-offset-2 decoration-2">
                                        {prevPost.data.title}
                                    </span>
                                </a>
                            ) : (
                                <div class="flex-1"></div>
                            )}

                            {/* Next Post (Newer) */}
                            {nextPost ? (
                                <a
                                    href={`/posts/${nextPost.id}/`}
                                    class="flex flex-col gap-1 text-right items-end flex-1 min-w-0 hover:opacity-75 transition-opacity group"
                                >
                                    <span class="nav-label text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                                        Next
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m9 18 6-6-6-6"/>
                                        </svg>
                                    </span>
                                    <span class="nav-title text-lg font-bold truncate w-full group-hover:underline underline-offset-2 decoration-2">
                                        {nextPost.data.title}
                                    </span>
                                </a>
                            ) : (
                                <div class="flex-1"></div>
                            )}

                        </div>
                        {/* --- END NAVIGATION --- */}

                    </div>
                </div>
            </div>
        </div>
    </article>

    {/* Back to Top Button */}
    <button
        class="hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
        data-show="false"
        id="to-top-btn"
    >
        <span class="sr-only">Back to top</span>
        <svg aria-hidden="true" class="h-6 w-6" fill="none" focusable="false" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
    </button>
</BaseLayout>

<style is:global>
    #blog-hero h1, 
    #blog-hero .title,
    .fake-h1,
    .fake-h2 {
        color: var(--theme-text) !important;
        transition: color 0.3s ease;
    }

    .dark .prose h1, 
    .dark .prose h2, 
    .dark .prose h3 {
        color: #ffffff !important;
    }

    .dropdown-answer,
    .reflection-body {
        color: var(--theme-text);
    }
</style>

<style>
    /* Post Navigation Styling */

    #post-nav .nav-title {
        color: #000000 !important;
    }
    #post-nav .nav-label {
        color: #555555 !important;
    }

    :global(.dark) #post-nav .nav-title {
        color: #ffffff !important;
    }
    :global(.dark) #post-nav .nav-label {
        color: #a1a1aa !important;
    }

    #post-nav a:hover .nav-label {
        color: var(--theme-text) !important;
    }
    #post-nav a:hover .nav-title {
        text-decoration-color: var(--theme-text) !important;
    }
</style>

<script>
    const scrollBtn = document.getElementById("to-top-btn");
    const targetHeader = document.getElementById("blog-hero");

    function callback(entries) {
        entries.forEach((entry) => {
            scrollBtn.dataset.show = (!entry.isIntersecting).toString();
        });
    }

    if (scrollBtn && targetHeader) {
        scrollBtn.addEventListener("click", () => {
            document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
        });

        const observer = new IntersectionObserver(callback);
        observer.observe(targetHeader);
    }
</script>
